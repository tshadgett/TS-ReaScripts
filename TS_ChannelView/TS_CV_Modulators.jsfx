mx_restore();             // the knobs' own values back

@serialize
// the Steps' and MSEGs' patterns (STEPS AND MSEG)
file_mem(0, PAT, 256);
file_mem(0, JN, 256);
file_mem(0, MS, 400);

@sample
nf > 0 ? (
  pk = max(abs(spl0), abs(spl1));
  ps = max(abs(spl2), abs(spl3));
  j = 0;
  loop(8,
    isf[j] ? (
      x = fsrc[j] ? ps : pk;
      e = env[j];
      env[j] = e + (x > e ? ga[j] : gr[j]) * (x - e);
    );
    j += 1;
  );
);

@gfx 360 48
gfx_clear = 0x1b1d21;
gfx_set(0.85, 0.87, 0.9);
gfx_x = 10; gfx_y = 10;
gfx_drawstr("ChannelView Modulators");
gfx_set(0.55, 0.58, 0.62);
gfx_x = 10; gfx_y = 26;
gfx_drawstr("Set up from ChannelView's Macros and Modulators panels.");
