// THE MATRIX: what moves each modulator's settings
slider193:mx1a_src=0<0,24,1>-Mod 1 moved by 1: source
slider194:mx1a_tgt=0<0,1515,1>-Mod 1 moved by 1: target
slider195:mx1a_amt=0<-1,1000000,0.0001>-Mod 1 moved by 1: amount
slider196:mx1b_src=0<0,24,1>-Mod 1 moved by 2: source
slider197:mx1b_tgt=0<0,1515,1>-Mod 1 moved by 2: target
slider198:mx1b_amt=0<-1,1000000,0.0001>-Mod 1 moved by 2: amount
slider199:mx2a_src=0<0,24,1>-Mod 2 moved by 1: source
slider200:mx2a_tgt=0<0,1515,1>-Mod 2 moved by 1: target
slider201:mx2a_amt=0<-1,1000000,0.0001>-Mod 2 moved by 1: amount
slider202:mx2b_src=0<0,24,1>-Mod 2 moved by 2: source
slider203:mx2b_tgt=0<0,1515,1>-Mod 2 moved by 2: target
slider204:mx2b_amt=0<-1,1000000,0.0001>-Mod 2 moved by 2: amount
slider205:mx3a_src=0<0,24,1>-Mod 3 moved by 1: source
slider206:mx3a_tgt=0<0,1515,1>-Mod 3 moved by 1: target
slider207:mx3a_amt=0<-1,1000000,0.0001>-Mod 3 moved by 1: amount
slider208:mx3b_src=0<0,24,1>-Mod 3 moved by 2: source
slider209:mx3b_tgt=0<0,1515,1>-Mod 3 moved by 2: target
slider210:mx3b_amt=0<-1,1000000,0.0001>-Mod 3 moved by 2: amount
slider211:mx4a_src=0<0,24,1>-Mod 4 moved by 1: source
slider212:mx4a_tgt=0<0,1515,1>-Mod 4 moved by 1: target
slider213:mx4a_amt=0<-1,1000000,0.0001>-Mod 4 moved by 1: amount
slider214:mx4b_src=0<0,24,1>-Mod 4 moved by 2: source
slider215:mx4b_tgt=0<0,1515,1>-Mod 4 moved by 2: target
slider216:mx4b_amt=0<-1,1000000,0.0001>-Mod 4 moved by 2: amount
slider217:mx5a_src=0<0,24,1>-Mod 5 moved by 1: source
slider218:mx5a_tgt=0<0,1515,1>-Mod 5 moved by 1: target
slider219:mx5a_amt=0<-1,1000000,0.0001>-Mod 5 moved by 1: amount
slider220:mx5b_src=0<0,24,1>-Mod 5 moved by 2: source
slider221:mx5b_tgt=0<0,1515,1>-Mod 5 moved by 2: target
slider222:mx5b_amt=0<-1,1000000,0.0001>-Mod 5 moved by 2: amount
slider223:mx6a_src=0<0,24,1>-Mod 6 moved by 1: source
slider224:mx6a_tgt=0<0,1515,1>-Mod 6 moved by 1: target
slider225:mx6a_amt=0<-1,1000000,0.0001>-Mod 6 moved by 1: amount
slider226:mx6b_src=0<0,24,1>-Mod 6 moved by 2: source
slider227:mx6b_tgt=0<0,1515,1>-Mod 6 moved by 2: target
slider228:mx6b_amt=0<-1,1000000,0.0001>-Mod 6 moved by 2: amount
slider229:mx7a_src=0<0,24,1>-Mod 7 moved by 1: source
slider230:mx7a_tgt=0<0,1515,1>-Mod 7 moved by 1: target
slider231:mx7a_amt=0<-1,1000000,0.0001>-Mod 7 moved by 1: amount
slider232:mx7b_src=0<0,24,1>-Mod 7 moved by 2: source
slider233:mx7b_tgt=0<0,1515,1>-Mod 7 moved by 2: target
slider234:mx7b_amt=0<-1,1000000,0.0001>-Mod 7 moved by 2: amount
slider235:mx8a_src=0<0,24,1>-Mod 8 moved by 1: source
slider236:mx8a_tgt=0<0,1515,1>-Mod 8 moved by 1: target
slider237:mx8a_amt=0<-1,1000000,0.0001>-Mod 8 moved by 1: amount
slider238:mx8b_src=0<0,24,1>-Mod 8 moved by 2: source
slider239:mx8b_tgt=0<0,1515,1>-Mod 8 moved by 2: target
slider240:mx8b_amt=0<-1,1000000,0.0001>-Mod 8 moved by 2: amount
slider241:byp_all=0<0,1,1{Off,On}>-Bypass all modulators
slider242:m1_byp=0<0,1,1{Off,On}>-Mod 1 Bypass
slider243:m2_byp=0<0,1,1{Off,On}>-Mod 2 Bypass
slider244:m3_byp=0<0,1,1{Off,On}>-Mod 3 Bypass
slider245:m4_byp=0<0,1,1{Off,On}>-Mod 4 Bypass
slider246:m5_byp=0<0,1,1{Off,On}>-Mod 5 Bypass
slider247:m6_byp=0<0,1,1{Off,On}>-Mod 6 Bypass
slider248:m7_byp=0<0,1,1{Off,On}>-Mod 7 Bypass
slider249:m8_byp=0<0,1,1{Off,On}>-Mod 8 Bypass
slider250:trig=0<0,255,1>-Trigger tracks
slider251:inst=0<0,1048576,1>-Instance

in_pin:Input L
in_pin:Input R
in_pin:Sidechain L
in_pin:Sidechain R
out_pin:Output L
out_pin:Output R
out_pin:Output 3
out_pin:Output 4
options:no_meter gmem=TS_CV_Mod

@init
ext_noinit = 1;
// per modulator state, 8 of each (index = modulator - 1)
acc = 1000;     // LFO phase accumulator (cycles)
lastc = 1100;   // LFO cycle last block (for Random)
rnd = 1200;     // Random's held value
sm = 1300;      // smoothed value
env = 1400;     // follower's envelope (linear)
ga = 1500; gr = 1600;   // follower's attack/release coefficients
mu = 1700;      // MIDI value, 0..1
held = 1800;    // MIDI notes held
isf = 1900;     // 1 when a follower (for @sample)
fsrc = 2000;    // follower source: 0 track, 1 sidechain
beats = 2100;   // quarter notes per cycle for the synced rates
beats[0]=0.25; beats[1]=1/3; beats[2]=0.5; beats[3]=0.75; beats[4]=2/3; beats[5]=1;
beats[6]=1.5; beats[7]=4/3; beats[8]=2; beats[9]=3; beats[10]=8/3; beats[11]=4;
beats[12]=6; beats[13]=8; beats[14]=16; beats[15]=32;
mbuf = 4000;    // MIDI message buffer
// a MIDI envelope's: stage (0 rest, 1 attack, 2 decay, 3 sustain, 4
// release), level, peak, notes held, level its release began at
estg = 3000; elev = 3100; epk = 3200; eheld = 3300; erl = 3400;
ext_midi_bus = 1;   // a trigger track's notes come on a bus of their own
nf = 0;

// THE MATRIX: the moved settings, saved to put back (slider, value pairs)
mxs = 2200; mxn = 0;

// a target's field in its modulator (-1: Rate, which depends on Sync)
function mx_field(tg) (
  tg == 1 ? 3 : tg == 2 ? -1 : tg == 3 ? 9 : tg == 4 ? 4 : tg == 5 ? 11 :
  tg == 6 ? 12 : tg == 7 ? 13 : tg == 8 ? 14 : tg == 9 ? 19 : tg == 10 ? 20 :
  tg == 11 ? 5 : tg == 12 ? 6 : tg == 13 ? 10 : tg == 14 ? 15 : tg == 15 ? 21 : -2;
);

function mx_save(idx) local(i, found) (
  found = 0; i = 0;
  loop(mxn, mxs[i * 2] == idx ? found = 1; i += 1; );
  !found ? ( mxs[mxn * 2] = idx; mxs[mxn * 2 + 1] = slider(idx); mxn += 1; );
);

// a setting moved by `d` (amount x source) within its knob's own scale
function mx_move(fi, v, d) local(t) (
  fi == 8 ? (           // Rate (Hz): a log scale, 0.01..20
    t = log(max(0.01, v) / 0.01) / log(2000);
    t = max(0, min(1, t + d)); 0.01 * 2000 ^ t;
  ) : fi == 7 ? (       // Rate (synced): whole steps
    t = max(0, min(1, v / 15 + d)); floor(t * 15 + 0.5);
  ) : fi == 11 ? (      // Attack, a square scale to 500 ms
    t = max(0, min(1, sqrt(max(0, v) / 500) + d)); 500 * t * t;
  ) : fi == 12 ? (      // Release, to 2000 ms
    t = max(0, min(1, sqrt(max(0, v) / 2000) + d)); 2000 * t * t;
  ) : fi == 13 ? (      // Floor, -80..0 dB
    t = max(0, min(1, (v + 80) / 80 + d)); t * 80 - 80;
  ) : fi == 14 ? (      // Ceiling, -60..12 dB
    t = max(0, min(1, (v + 60) / 72 + d)); t * 72 - 60;
  ) : (fi == 19 || fi == 20) ? (   // a note
    t = max(0, min(1, v / 127 + d)); floor(t * 127 + 0.5);
  ) : (                 // Depth, Phase, Smooth: 0..1
    max(0, min(1, v + d));
  );
);

function mx_apply_all() local(n, s, b, base, src, tgr, tg, nch, amt, sv, fi, idx, v, i, code) (
  mxn = 0;
  n = 0;
  loop(8,
    base = 17 + 22 * n;                          // this modulator's Type
    slider(base) >= 0.5 ? (
      s = 0;
      loop(2,
        b = 193 + (n * 2 + s) * 3;
        src = floor(slider(b) + 0.5);
        tgr = floor(slider(b + 1) + 0.5); tg = tgr % 100; nch = floor(tgr / 100);
        amt = slider(b + 2);
        (src >= 1 && src <= 24 && src != 17 + n && tg >= 1) ? (
          sv = src <= 16 ? slider(src) : slider(18 + 22 * (src - 17));
          sv = max(0, min(1, sv));
          fi = mx_field(tg);
          fi == -1 ? fi = (slider(base + 6) >= 0.5 ? 7 : 8);
          fi >= 0 ? (
            idx = base + fi;
            mx_save(idx);
            v = slider(idx);
            tg >= 11 ? (
              nch = max(2, nch);
              i = min(5, floor(sv * (nch - 1) + 0.5));
              code = floor(max(0, amt) / 10 ^ i) % 10;
              code > 0 ? v = code - 1;
            ) : (
              v = mx_move(fi, v, amt * sv);
            );
            slider(idx) = v;
          );
        );
        s += 1;
      );
    );
    n += 1;
  );
);

function mx_restore() local(i) (
  i = 0;
  loop(mxn, slider(mxs[i * 2]) = mxs[i * 2 + 1]; i += 1; );
  mxn = 0;
);

// A MIDI envelope's message: a note in lo..hi starts it (legato: only
// from no notes held) and lets it go when the last is let go; all notes
// off lets it go.
function env_midi(j, on, off, st, d1, d2, lo, hi, legato, byvel) (
  st == 0xB0 && (d1 == 120 || d1 == 123) ? (
    eheld[j] = 0;
    estg[j] > 0 && estg[j] < 4 ? ( estg[j] = 4; erl[j] = elev[j]; );
  ) : (d1 >= min(lo, hi) && d1 <= max(lo, hi)) ? (
    on ? (
      eheld[j] += 1;
      (eheld[j] == 1 || !legato) ? ( epk[j] = byvel ? d2 / 127 : 1; estg[j] = 1; );
    );
    off ? (
      eheld[j] = max(0, eheld[j] - 1);
      eheld[j] == 0 && estg[j] > 0 && estg[j] < 4 ? ( estg[j] = 4; erl[j] = elev[j]; );
    );
  );
);

// An envelope's level after this block: attack and release in ms, decay
// in ms, sustain 0..1, `ex` exponential.
function env_run(j, att, dec, sus, rel, ex) local(lv, pk, s, t) (
  lv = elev[j]; pk = epk[j]; s = estg[j];
  s == 1 ? (
    att > 0 ? ( lv += pk * dt / (att * 0.001); ) : ( lv = pk; );
    lv >= pk ? ( lv = pk; s = 2; );
  );
  s == 2 ? (
    t = sus * pk;
    dec > 0 && lv > t ? (
      ex ? ( lv = t + (lv - t) * exp(-dt * 6.9 / (dec * 0.001)); )
         : ( lv = max(t, lv - pk * (1 - sus) * dt / (dec * 0.001)); );
      lv - t < 0.001 * pk + 0.0000001 ? ( lv = t; s = 3; );
    ) : ( lv = t; s = 3; );
  );
  s == 4 ? (
    rel > 0 ? (
      ex ? ( lv *= exp(-dt * 6.9 / (rel * 0.001)); )
         : ( lv = max(0, lv - max(erl[j], 0.000001) * dt / (rel * 0.001)); );
      lv < 0.001 ? ( lv = 0; s = 0; );
    ) : ( lv = 0; s = 0; );
  );
  elev[j] = lv; estg[j] = s;
  lv;
);

// A MIDI envelope's level after this block. `dc` and `fl` are the
// Ceiling and Floor it keeps its Decay and Sustain in; `ex` exponential.
function env_step(j, att, dc, fl, rel, ex) local(t) (
  t = max(0, min(1, (dc + 60) / 72));
  env_run(j, att, 2000 * t * t, max(0, min(1, (fl + 80) / 80)), rel, ex);
);

// A Follower's envelope (THE FOLLOWER'S ENVELOPES), set off by its level
// `db`: above `thr` starts it, 3 dB under lets it go. `legato`: a rise
// while letting go carries on from where it is. `bylev`: its peak how
// far the loudest of the hit went past `thr`, full at `ceil`.
function env_audio(j, db, thr, ceil, legato, bylev) local(l) (
  l = bylev ? (ceil > thr ? max(0.02, min(1, (db - thr) / (ceil - thr))) : 1) : 1;
  eheld[j] < 0.5 ? (
    db > thr ? (
      eheld[j] = 1;
      !legato ? elev[j] = 0;
      epk[j] = l; estg[j] = 1;
    );
  ) : (
    // the loudest of it, while it rises
    bylev && estg[j] == 1 && l > epk[j] ? epk[j] = l;
    db < thr - 3 ? (
      eheld[j] = 0;
      estg[j] > 0 && estg[j] < 4 ? ( estg[j] = 4; erl[j] = elev[j]; );
    );
  );
);

// STEPS AND MSEG: their patterns (kept with the project) and state.
// (above mbuf's 65536)
PAT = 80000;    // 8 x 32 step values
JN = 80300;     // 8 x 32: joined to the step before
MS = 80600;     // 8 x 50: point count, then x, y, bend for up to 16
spos = 81000; lastk = 81010; curi = 81020; crun = 81030; non = 81040;
noff = 81050; lastcc = 81060; rndi = 81070; mpos = 81080; mtr = 81090;
mph = 81100; scmask = 81110;
// the scales, as which of the 12 notes above the key they take
scmask[0] = 4095; scmask[1] = 2741; scmask[2] = 1453; scmask[3] = 1709;
scmask[4] = 661; scmask[5] = 1193; scmask[6] = 2477; scmask[7] = 1257;
memset(non, -1, 8); memset(lastcc, -1, 8); memset(lastk, -1, 8); memset(crun, -1, 8);
g_seq = gmem[0];

// a step's value: its run's first step's
function st_first(j, i) local(b) (
  b = j * 32;
  while (i > 0 && JN[b + i] >= 0.5) ( i -= 1; );
  i;
);
// how many steps the run from i takes
function st_runlen(j, i, cnt) local(b, k, n) (
  b = j * 32; k = i + 1; n = 1;
  while (k < cnt && JN[b + k] >= 0.5) ( n += 1; k += 1; );
  n;
);
// the note a value plays across lo..hi, on the scale and key in `sk`
// (scale x 12 + key); -1 when the range has none of the scale's
function st_note(v, lo, hi, sk) local(key, mask, n, cn, idx, t) (
  key = floor(sk + 0.5) % 12; mask = scmask[max(0, min(7, floor(floor(sk + 0.5) / 12)))];
  lo = floor(lo + 0.5); hi = floor(hi + 0.5);
  lo > hi ? ( t = lo; lo = hi; hi = t; );
  cn = 0; n = lo;
  loop(hi - lo + 1, (mask & (2 ^ ((n - key + 120) % 12))) ? cn += 1; n += 1; );
  cn < 1 ? -1 : (
    idx = floor(v * (cn - 1) + 0.5); n = lo; t = -1;
    loop(hi - lo + 1,
      (mask & (2 ^ ((n - key + 120) % 12))) ? ( idx == 0 ? t = n; idx -= 1; );
      n += 1;
    );
    t;
  );
);
// A Steps modulator's value this block, its MIDI sent
// (its fields read straight from its sliders: fld(j, k) is field k)
function fld(j, k) ( slider(17 + 22 * j + k); );
function st_run(j) local(cnt, sync, ri, rhz, ph, dir, swing, mode, ch, ccn, lo, hi, sk, gate, p, pr, r, sw, k, i, m, v, rs, rl, note, chn) (
  cnt = max(2, min(32, floor(fld(j, 11) + 0.5)));
  sync = fld(j, 6); ri = max(0, min(15, floor(fld(j, 7) + 0.5))); rhz = fld(j, 8); ph = fld(j, 9);
  dir = fld(j, 5); swing = -fld(j, 13); mode = fld(j, 16); ch = fld(j, 17); ccn = fld(j, 18);
  lo = fld(j, 19); hi = fld(j, 20); sk = fld(j, 12); gate = (fld(j, 14) + 60) / 72;
  sync >= 0.5 && playing ? ( spos[j] = beat_position / beats[ri]; ) : (
    spos[j] += (sync >= 0.5 ? (tempo / 60) / beats[ri] : max(0.01, rhz)) * dt;
    spos[j] > 1000000 ? spos[j] -= 1000000;
  );
  p = max(0, spos[j] + ph * cnt);
  // swing: the first of each pair longer, the second shorter
  sw = max(0, min(0.8, swing / 100)) * 0.5;
  pr = floor(p / 2); r = p - 2 * pr;
  k = 2 * pr + (r < 1 + sw ? 0 : 1);
  dir = floor(dir + 0.5);
  dir == 1 ? ( i = cnt - 1 - (k % cnt); )
  : dir == 2 ? ( m = k % (2 * cnt - 2); i = m < cnt ? m : 2 * cnt - 2 - m; )
  : dir == 3 ? ( k != lastk[j] ? rndi[j] = min(cnt - 1, floor(rand(cnt))); i = rndi[j]; )
  : ( i = k % cnt; );
  rs = st_first(j, i);
  v = PAT[j * 32 + rs];
  mode = floor(mode + 0.5);
  chn = max(1, min(16, floor(ch + 0.5))) - 1;
  // a note held on when it's no longer sending notes, or stopped
  non[j] >= 0 && (mode != 2 || !playing) ? ( midisend(0, 0x80 + chn, non[j], 0); non[j] = -1; );
  k != lastk[j] ? (
    // a new run (the same step again, from Random, starts again too)
    (rs != crun[j] || i == curi[j]) ? (
      crun[j] = rs;
      mode == 2 && playing ? (
        non[j] >= 0 ? ( midisend(0, 0x80 + chn, non[j], 0); non[j] = -1; );
        v >= 0.005 ? (
          note = st_note(v, lo, hi, sk);
          note >= 0 ? (
            midisend(0, 0x90 + chn, note, max(1, min(127, floor(ccn + 0.5))));
            non[j] = note;
            rl = st_runlen(j, rs, cnt);
            noff[j] = p + max(0.05, rl * max(0.01, min(1, gate)));
          );
        );
      );
    );
    lastk[j] = k; curi[j] = i;
  );
  non[j] >= 0 && p >= noff[j] ? ( midisend(0, 0x80 + chn, non[j], 0); non[j] = -1; );
  mode == 1 ? (
    m = floor(v * 127 + 0.5);
    m != lastcc[j] ? ( midisend(0, 0xB0 + chn, max(0, min(127, floor(ccn + 0.5))), m); lastcc[j] = m; );
  ) : lastcc[j] = -1;
  v;
);
// An MSEG's level at f (0..1) along its points: each segment bent by its
// first point's bend (-1..1)
function ms_eval(j, f) local(b, n, k, x0, x1, y0, y1, c, t) (
  b = j * 50; n = max(2, min(16, floor(MS[b] + 0.5)));
  MS[b] < 2 ? f : f <= MS[b + 1] ? MS[b + 2] : f >= MS[b + 1 + (n - 1) * 3] ? MS[b + 2 + (n - 1) * 3] : (
    k = 0;
    while (k < n - 2 && f >= MS[b + 1 + (k + 1) * 3]) ( k += 1; );
    x0 = MS[b + 1 + k * 3]; y0 = MS[b + 2 + k * 3]; c = MS[b + 3 + k * 3];
    x1 = MS[b + 1 + (k + 1) * 3]; y1 = MS[b + 2 + (k + 1) * 3];
    t = x1 > x0 ? (f - x0) / (x1 - x0) : 1;
    abs(c) > 0.001 ? t = (exp(c * 6 * t) - 1) / (exp(c * 6) - 1);
    y0 + (y1 - y0) * t;
  );
);
// An MSEG modulator's value this block
function ms_run(j) local(sync, ri, rhz, ph, trg, lp, thr, f, db, once) (
  sync = fld(j, 6); ri = max(0, min(15, floor(fld(j, 7) + 0.5))); rhz = fld(j, 8); ph = fld(j, 9);
  trg = floor(fld(j, 16) + 0.5); lp = fld(j, 21); thr = fld(j, 13);
  once = trg >= 2 && lp < 0.5;
  trg == 0 && sync >= 0.5 && playing ? ( mpos[j] = beat_position / beats[ri]; ) : (
    trg == 2 && mtr[j] ? ( mpos[j] = 0; mtr[j] = 0; );
    trg == 3 ? (
      db = env[j] > 0.0000001 ? 20 * log10(env[j]) : -140;
      eheld[j] < 0.5 ? ( db > thr ? ( eheld[j] = 1; mpos[j] = 0; ); ) : ( db < thr - 3 ? eheld[j] = 0; );
    );
    mpos[j] += (sync >= 0.5 ? (tempo / 60) / beats[ri] : max(0.01, rhz)) * dt;
    once ? ( mpos[j] = min(mpos[j], 1); ) : ( mpos[j] > 1000000 ? mpos[j] -= 1000000; );
  );
  f = once ? min(1, mpos[j] + ph) : (mpos[j] + ph) - floor(mpos[j] + ph);
  mph[j] = f;
  ms_eval(j, f);
);

@block
dt = samplesblock / srate;
// a message from ChannelView (STEPS AND MSEG)
gmem[0] != g_seq ? (
  g_seq = gmem[0];
  inst > 0 && gmem[1] == inst ? (
    gj = max(1, min(8, floor(gmem[2] + 0.5))) - 1; gc = floor(gmem[3] + 0.5);
    gc == 1 ? ( gi = 0; loop(32, gmem[10 + gi] = PAT[gj * 32 + gi]; gmem[42 + gi] = JN[gj * 32 + gi]; gi += 1; ); )
    : gc == 2 ? ( gi = 0; loop(32, PAT[gj * 32 + gi] = gmem[10 + gi]; JN[gj * 32 + gi] = gmem[42 + gi]; gi += 1; ); )
    : gc == 3 ? ( gi = 0; loop(49, gmem[10 + gi] = MS[gj * 50 + gi]; gi += 1; ); )
    : gc == 4 ? ( gi = 0; loop(49, MS[gj * 50 + gi] = gmem[10 + gi]; gi += 1; ); );
    gmem[4] = g_seq;
  );
);
// a Follower envelope's level detector: 1 ms up, 30 ms down
ga_fast = 1 - exp(-1 / (0.001 * srate)); gr_fast = 1 - exp(-1 / (0.03 * srate));
playing = (play_state & 1) == 1;
nf = 0;
mx_apply_all();           // THE MATRIX: moved settings, for this block
nm = (m1_type == 3) + (m2_type == 3) + (m3_type == 3) + (m4_type == 3)
   + (m5_type == 3) + (m6_type == 3) + (m7_type == 3) + (m8_type == 3)
   + (m1_type == 5 && floor(m1_msrc + 0.5) == 2) + (m2_type == 5 && floor(m2_msrc + 0.5) == 2) + (m3_type == 5 && floor(m3_msrc + 0.5) == 2) + (m4_type == 5 && floor(m4_msrc + 0.5) == 2)
