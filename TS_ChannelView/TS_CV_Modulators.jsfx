  ) : sh == 3 ? (
    u = f;
  ) : sh == 4 ? (
    u = 1 - f;
  ) : (
    c = floor(ph);
    c != lastc[1] ? ( rnd[1] = rand(1); lastc[1] = c; );
    u = rnd[1];
  );
  isf[1] = 0;
) : m2_type == 2 ? (
  isf[1] = 1; nf += 1;
  fsrc[1] = m2_fsrc >= 0.5;
  ga[1] = m2_att > 0 ? 1 - exp(-1 / (m2_att * 0.001 * srate)) : 1;
  gr[1] = m2_rel > 0 ? 1 - exp(-1 / (m2_rel * 0.001 * srate)) : 1;
  db = env[1] > 0.0000001 ? 20 * log10(env[1]) : -140;
  m2_gate >= 0.5 ? (
    u = db > m2_floor ? 1 : 0;
  ) : (
    u = m2_ceil > m2_floor ? (db - m2_floor) / (m2_ceil - m2_floor) : (db > m2_floor ? 1 : 0);
    u = max(0, min(1, u));
  );
) : m2_type == 3 ? (
