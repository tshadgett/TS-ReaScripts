    u = m3_ceil > m3_floor ? (db - m3_floor) / (m3_ceil - m3_floor) : (db > m3_floor ? 1 : 0);
    u = max(0, min(1, u));
  );
) : m3_type == 3 ? (
  isf[2] = 0;
  ms = floor(m3_msrc + 0.5);
  ms >= 5 ? (
    u = env_step(2, m3_att, m3_ceil, m3_floor, m3_rel, m3_gate >= 0.5);
    ms == 7 ? u = 1 - u;
  ) : u = mu[2];
) : m3_type == 4 ? (
  isf[2] = 0;
  u = st_run(2);
  gmem[1000 + 8 * (inst % 8192) + 2] = curi[2];
) : m3_type == 5 ? (
  isf[2] = floor(m3_msrc + 0.5) == 3;
  isf[2] ? ( nf += 1; fsrc[2] = m3_fsrc >= 0.5; ga[2] = ga_fast; gr[2] = gr_fast; );
  u = ms_run(2);
  gmem[1000 + 8 * (inst % 8192) + 2] = mph[2];
) : (
  isf[2] = 0;
  u = 0;
);
m3_smooth > 0 ? (
  sm[2] += (u - sm[2]) * (1 - exp(-dt / (m3_smooth * m3_smooth * 0.5)));
) : sm[2] = u;
m3_type >= 1 && byp_all < 0.5 && m3_byp < 0.5 ? (
  m3_out = max(0, min(1, m3_depth * sm[2]));
  m3_outb = max(0, min(1, 0.5 + m3_depth * (sm[2] - 0.5)));
) : (
  m3_out = 0;
  m3_outb = 0.5;
);


// ---- modulator 4
m4_type == 1 ? (
  ri = max(0, min(15, floor(m4_rsync + 0.5)));
  hz = m4_sync >= 0.5 ? (tempo / 60) / beats[ri] : max(0.01, m4_rhz);
  m4_sync >= 0.5 && playing ? (
    acc[3] = beat_position / beats[ri];
  ) : (
    acc[3] += hz * dt;
    acc[3] > 1000000 ? acc[3] -= 1000000;
  );
  ph = acc[3] + m4_phase;
  f = ph - floor(ph);
  sh = floor(m4_shape + 0.5);
  sh == 0 ? (
    u = 0.5 + 0.5 * sin(2 * $pi * f);
  ) : sh == 1 ? (
    u = 1 - abs(2 * f - 1);
  ) : sh == 2 ? (
    u = (f < 0.5) ? 1 : 0;
  ) : sh == 3 ? (
    u = f;
  ) : sh == 4 ? (
    u = 1 - f;
  ) : (
    c = floor(ph);
