    u = 1 - f;
  ) : (
    c = floor(ph);
    c != lastc[7] ? ( rnd[7] = rand(1); lastc[7] = c; );
    u = rnd[7];
  );
  isf[7] = 0;
) : m8_type == 2 ? (
  isf[7] = 1; nf += 1;
  fsrc[7] = m8_fsrc >= 0.5;
  ga[7] = m8_att > 0 ? 1 - exp(-1 / (m8_att * 0.001 * srate)) : 1;
  gr[7] = m8_rel > 0 ? 1 - exp(-1 / (m8_rel * 0.001 * srate)) : 1;
  db = env[7] > 0.0000001 ? 20 * log10(env[7]) : -140;
  m8_gate >= 0.5 ? (
    u = db > m8_floor ? 1 : 0;
  ) : (
    u = m8_ceil > m8_floor ? (db - m8_floor) / (m8_ceil - m8_floor) : (db > m8_floor ? 1 : 0);
    u = max(0, min(1, u));
  );
) : m8_type == 3 ? (
  isf[7] = 0; nm += 1;
  u = mu[7];
) : (
  isf[7] = 0;
  u = 0;
);
m8_smooth > 0 ? (
  sm[7] += (u - sm[7]) * (1 - exp(-dt / (m8_smooth * m8_smooth * 0.5)));
) : sm[7] = u;
m8_type >= 1 ? (
  m8_out = max(0, min(1, m8_depth * sm[7]));
  m8_outb = max(0, min(1, 0.5 + m8_depth * (sm[7] - 0.5)));
) : (
  m8_out = 0;
  m8_outb = 0.5;
);


// MIDI: everything passes through; the MIDI modulators read it
nm > 0 ? (
  while ((len = midirecv_buf(ofs, mbuf, 65536)) > 0) (
    midisend_buf(ofs, mbuf, len);
    len <= 3 ? (
      st = mbuf[0] & 0xF0; ch = (mbuf[0] & 0x0F) + 1;
      d1 = mbuf[1]; d2 = mbuf[2];
      on = st == 0x90 && d2 > 0;
      off = st == 0x80 || (st == 0x90 && d2 == 0);

      m1_type == 3 && (m1_mch < 0.5 || floor(m1_mch + 0.5) == ch) ? (
        ms = floor(m1_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[0] = d2 / 127; held[0] += 1; );
          off ? (
            held[0] = max(0, held[0] - 1);
            held[0] == 0 && m1_mhold < 0.5 ? mu[0] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[0] = m1_mhi > m1_mlo ? max(0, min(1, (d1 - m1_mlo) / (m1_mhi - m1_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m1_mcc + 0.5) ? mu[0] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[0] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[0] = d1 / 127;
          st == 0xA0 ? mu[0] = d2 / 127;
        );
      );


      m2_type == 3 && (m2_mch < 0.5 || floor(m2_mch + 0.5) == ch) ? (
        ms = floor(m2_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[1] = d2 / 127; held[1] += 1; );
          off ? (
            held[1] = max(0, held[1] - 1);
            held[1] == 0 && m2_mhold < 0.5 ? mu[1] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[1] = m2_mhi > m2_mlo ? max(0, min(1, (d1 - m2_mlo) / (m2_mhi - m2_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m2_mcc + 0.5) ? mu[1] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[1] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[1] = d1 / 127;
          st == 0xA0 ? mu[1] = d2 / 127;
        );
      );


      m3_type == 3 && (m3_mch < 0.5 || floor(m3_mch + 0.5) == ch) ? (
        ms = floor(m3_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[2] = d2 / 127; held[2] += 1; );
          off ? (
            held[2] = max(0, held[2] - 1);
            held[2] == 0 && m3_mhold < 0.5 ? mu[2] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[2] = m3_mhi > m3_mlo ? max(0, min(1, (d1 - m3_mlo) / (m3_mhi - m3_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m3_mcc + 0.5) ? mu[2] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[2] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[2] = d1 / 127;
          st == 0xA0 ? mu[2] = d2 / 127;
        );
      );


      m4_type == 3 && (m4_mch < 0.5 || floor(m4_mch + 0.5) == ch) ? (
        ms = floor(m4_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[3] = d2 / 127; held[3] += 1; );
          off ? (
            held[3] = max(0, held[3] - 1);
            held[3] == 0 && m4_mhold < 0.5 ? mu[3] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[3] = m4_mhi > m4_mlo ? max(0, min(1, (d1 - m4_mlo) / (m4_mhi - m4_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m4_mcc + 0.5) ? mu[3] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[3] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[3] = d1 / 127;
          st == 0xA0 ? mu[3] = d2 / 127;
        );
      );


      m5_type == 3 && (m5_mch < 0.5 || floor(m5_mch + 0.5) == ch) ? (
        ms = floor(m5_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[4] = d2 / 127; held[4] += 1; );
          off ? (
            held[4] = max(0, held[4] - 1);
            held[4] == 0 && m5_mhold < 0.5 ? mu[4] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[4] = m5_mhi > m5_mlo ? max(0, min(1, (d1 - m5_mlo) / (m5_mhi - m5_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m5_mcc + 0.5) ? mu[4] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[4] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[4] = d1 / 127;
          st == 0xA0 ? mu[4] = d2 / 127;
        );
      );


      m6_type == 3 && (m6_mch < 0.5 || floor(m6_mch + 0.5) == ch) ? (
        ms = floor(m6_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[5] = d2 / 127; held[5] += 1; );
          off ? (
            held[5] = max(0, held[5] - 1);
            held[5] == 0 && m6_mhold < 0.5 ? mu[5] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[5] = m6_mhi > m6_mlo ? max(0, min(1, (d1 - m6_mlo) / (m6_mhi - m6_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m6_mcc + 0.5) ? mu[5] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[5] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[5] = d1 / 127;
          st == 0xA0 ? mu[5] = d2 / 127;
        );
      );


      m7_type == 3 && (m7_mch < 0.5 || floor(m7_mch + 0.5) == ch) ? (
        ms = floor(m7_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[6] = d2 / 127; held[6] += 1; );
          off ? (
            held[6] = max(0, held[6] - 1);
            held[6] == 0 && m7_mhold < 0.5 ? mu[6] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[6] = m7_mhi > m7_mlo ? max(0, min(1, (d1 - m7_mlo) / (m7_mhi - m7_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m7_mcc + 0.5) ? mu[6] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[6] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[6] = d1 / 127;
          st == 0xA0 ? mu[6] = d2 / 127;
        );
      );


      m8_type == 3 && (m8_mch < 0.5 || floor(m8_mch + 0.5) == ch) ? (
        ms = floor(m8_msrc + 0.5);
        ms == 0 ? (
          on ? ( mu[7] = d2 / 127; held[7] += 1; );
          off ? (
            held[7] = max(0, held[7] - 1);
            held[7] == 0 && m8_mhold < 0.5 ? mu[7] = 0;
          );
        ) : ms == 1 ? (
          on ? mu[7] = m8_mhi > m8_mlo ? max(0, min(1, (d1 - m8_mlo) / (m8_mhi - m8_mlo))) : 0;
        ) : ms == 2 ? (
          st == 0xB0 && d1 == floor(m8_mcc + 0.5) ? mu[7] = d2 / 127;
        ) : ms == 3 ? (
          st == 0xE0 ? mu[7] = (d2 * 128 + d1) / 16383;
        ) : (
          st == 0xD0 ? mu[7] = d1 / 127;
          st == 0xA0 ? mu[7] = d2 / 127;
        );
      );

    );
  );
);

mx_restore();             // the knobs' own values back

@sample
nf > 0 ? (
  pk = max(abs(spl0), abs(spl1));
  ps = max(abs(spl2), abs(spl3));
  j = 0;
  loop(8,
    isf[j] ? (
      x = fsrc[j] ? ps : pk;
      e = env[j];
      env[j] = e + (x > e ? ga[j] : gr[j]) * (x - e);
    );
    j += 1;
  );
);

@gfx 360 48
gfx_clear = 0x1b1d21;
gfx_set(0.85, 0.87, 0.9);
gfx_x = 10; gfx_y = 10;
gfx_drawstr("ChannelView Modulators");
gfx_set(0.55, 0.58, 0.62);
gfx_x = 10; gfx_y = 26;
gfx_drawstr("Set up from ChannelView's Macros and Modulators panels.");
