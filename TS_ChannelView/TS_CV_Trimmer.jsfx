desc:TS_CV Trimmer
author: Tim Shadgett
noindex: true

/*
  TS_CV_Trimmer.jsfx -- the first plugin in a channel: trim, low cut, high
  cut and VU meters. ChannelView draws it as its own panel (meters, trims,
  the filters over a spectrum) and can set the trim for you (Auto trim from
  the track's items, or Listen to what's playing).

  Order: trim, then low cut, then high cut. Zero latency.

  Parameters (0-based, as REAPER numbers them):
    0  Trim L, dB            1  Trim R, dB
    2  Link: moving one trim moves the other by the same amount
    3  Low cut, Hz: off at its lowest (20 Hz)
    4  Low cut slope, 6..48 dB/oct
    5  High cut, Hz: off at its highest (20 kHz)
    6  High cut slope
    7  0 VU reference, dBFS (a sine at this level reads 0 VU)
    8  Peak ceiling, dBFS (the peak lights above it; Auto trim keeps
       peaks under it)
  The two filters are Butterworth: 6 dB/oct is one first-order section,
  the rest cascades of second-order sections (plus a first-order one for
  18 dB/oct).

  Meters and spectrum go out through gmem (namespace TS_TA_Mem, shared
  with ChannelView's other plugins), in a block per track at
  0x200000 + (track index + 1) * 256, the master at index 0:
    0  VU L, dB on the meter's own scale (sine-calibrated: a sine whose
       peak is at X dBFS reads X)       1  VU R
    2  peak L, dBFS, falling 20 dB/s    3  peak R
    4  block count (alive)              5  channels metered (1 or 2)
    8  spectrum heartbeat: ChannelView keeps changing it while a panel
       shows the spectrum; with it still for half a second the FFT stops
    9  spectrum count (a new frame)    10  bands   11  lowest band, Hz
   12  highest band, Hz
   16  Listen: ChannelView writes a new number to start, 0 to stop
   17  the Listen number being measured
   18  Listen: mean square of the input, L    19  R
   20  Listen: input peak, L                  21  R
   22  Listen: samples measured
   64.. 64 + BANDS - 1   the spectrum before the filters, dB per band
  Nothing here is a hidden slider: a hidden slider is still a parameter,
  and each write would make it REAPER's last-touched one.

  MIT licence -- see LICENSE in the TS-ReaScripts repository.
*/

slider1:trim_l=0<-24,24,0.1>Trim L (dB)
slider2:trim_r=0<-24,24,0.1>Trim R (dB)
slider3:link=1<0,1,1{Off,On}>Link trims
slider4:lc_f=20<20,1000,1>Low cut (Hz, 20 = off)
slider5:lc_s=1<0,5,1{6 dB/oct,12 dB/oct,18 dB/oct,24 dB/oct,36 dB/oct,48 dB/oct}>Low cut slope
slider6:hc_f=20000<1000,20000,1>High cut (Hz, 20000 = off)
slider7:hc_s=1<0,5,1{6 dB/oct,12 dB/oct,18 dB/oct,24 dB/oct,36 dB/oct,48 dB/oct}>High cut slope
slider8:ref=-18<-30,-6,0.5>0 VU reference (dBFS)
slider9:ceil=-6<-24,0,0.5>Peak ceiling (dBFS)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

options:gmem=TS_TA_Mem

@init
ext_nodenorm = 1;
E15 = 10 ^ -15; E10 = 10 ^ -10; E20 = 10 ^ -20;   // floors for the logs

TB_BASE = 0x200000; TB_STRIDE = 256; TB_TRACKS = 4096;
G_VUL = 0; G_VUR = 1; G_PKL = 2; G_PKR = 3; G_SEQ = 4; G_NCH = 5;
G_SHB = 8; G_SSEQ = 9; G_SBN = 10; G_SBLO = 11; G_SBHI = 12;
G_LCMD = 16; G_LACK = 17; G_LMSL = 18; G_LMSR = 19; G_LPKL = 20; G_LPKR = 21; G_LN = 22;
G_BAND = 64;

BANDS = 128; BAND_LO = 20; BAND_HI = 20000;
FFT_N = 2048; HOP = 1024;

// local memory
BUF_RING = 0;          // FFT_N, the signal before the filters
BUF_FFT  = 4096;       // FFT_N * 2, interleaved re/im
BUF_WIN  = 8192;       // FFT_N, Hann window
BUF_BDB  = 12288;      // BANDS, each band's level as shown
BUF_BED  = 12544;      // BANDS + 1, band edges in bins
BUF_LC   = 13000;      // low cut: coefficients and state, see below
BUF_HC   = 13200;      // high cut

// THE FILTERS. A filter is up to four biquads and one first-order
// section, per channel. At f: [0] biquads in use, [1] first-order in use,
// [2..21] biquad coefficients b0 b1 b2 a1 a2 x4, [22..24] first-order
// b0 b1 a1, [32..] state: per channel (stride 16) biquads z1 z2 x4 and
// the first-order's z.
F_NB = 0; F_FO = 1; F_BQ = 2; F_FC = 22; F_ST = 32; F_CH = 16;

function orderOf(s) ( s <= 0 ? 1 : s == 1 ? 2 : s == 2 ? 3 : s == 3 ? 4 : s == 4 ? 6 : 8 );

// Each filter is off at the end of its range.
LC_OFF = 20.5; HC_OFF = 19900;

function clearState(f) local(i) ( i = 0; loop(2 * F_CH, f[F_ST + i] = 0; i += 1); );

// Butterworth, order n, corner fc, high pass when hp. Section k's Q is
// 1 / (2 cos((2k - 1) pi / (2n))) for an even order, 1 / (2 cos(k pi / n))
// for an odd one, which adds a first-order section. Bilinear transform,
// the corner prewarped (RBJ's forms).
function design(f, n, fc, hp) local(k, nb, w0, cw, sw, q, al, a0, K, c) (
  fc = max(10, min(fc, srate * 0.45));
  nb = floor(n / 2);
  f[F_NB] = nb; f[F_FO] = n - 2 * nb;
  w0 = 2 * $pi * fc / srate; cw = cos(w0); sw = sin(w0);
  k = 0;
  loop(nb,
    q = f[F_FO] ? 1 / (2 * cos((k + 1) * $pi / n)) : 1 / (2 * cos((2 * (k + 1) - 1) * $pi / (2 * n)));
    al = sw / (2 * q); a0 = 1 + al;
    c = f + F_BQ + k * 5;
    hp ? (
      c[0] = (1 + cw) / 2 / a0; c[1] = -(1 + cw) / a0; c[2] = (1 + cw) / 2 / a0;
    ) : (
      c[0] = (1 - cw) / 2 / a0; c[1] = (1 - cw) / a0; c[2] = (1 - cw) / 2 / a0;
    );
    c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
    k += 1;
  );
  f[F_FO] ? (
    K = tan(w0 / 2);
    c = f + F_FC;
    hp ? ( c[0] = 1 / (1 + K); c[1] = -1 / (1 + K); ) : ( c[0] = K / (1 + K); c[1] = K / (1 + K); );
    c[2] = (K - 1) / (K + 1);
  );
);

// One sample through filter f on channel ch (transposed direct form II).
function run(f, ch, x) local(k, c, z, y) (
  k = 0;
  loop(f[F_NB],
    c = f + F_BQ + k * 5; z = f + F_ST + ch * F_CH + k * 2;
    y = c[0] * x + z[0];
    z[0] = c[1] * x - c[3] * y + z[1];
    z[1] = c[2] * x - c[4] * y;
    x = y;
    k += 1;
  );
  f[F_FO] ? (
    c = f + F_FC; z = f + F_ST + ch * F_CH + 8;
    y = c[0] * x + z[0];
    z[0] = c[1] * x - c[2] * y;
    x = y;
  );
  x;
);

// The window and the band edges, once.
i = 0;
loop(FFT_N, BUF_WIN[i] = 0.5 - 0.5 * cos(2 * $pi * i / (FFT_N - 1)); i += 1);
i = 0;
loop(BANDS + 1,
  BUF_BED[i] = BAND_LO * (BAND_HI / BAND_LO) ^ (i / BANDS) * FFT_N / srate;
  i += 1;
);
i = 0; loop(BANDS, BUF_BDB[i] = -150; i += 1);

lc_n = -1; hc_n = -1;           // forces a design on the first block
lc_cur = lc_f; hc_cur = hc_f;
gl = 10 ^ (trim_l / 20); gr = 10 ^ (trim_r / 20);
prev_l = trim_l; prev_r = trim_r;
msl = msr = 0; pkl = pkr = 0;
ring_pos = 0; hop_n = 0;
spec_hb = 0; spec_idle = 1000000; spec_on = 0; sseq = 0;
lis_cmd = 0; lis_n = 0; lis_sl = lis_sr = 0; lis_pl = lis_pr = 0;
blocks = 0;

@slider
// Link: whichever trim moved takes the other with it by the same amount.
link ? (
  dl = trim_l - prev_l; dr = trim_r - prev_r;
  dl != 0 && dr == 0 ? (
    trim_r = max(-24, min(24, trim_r + dl)); sliderchange(2);
  ) : dr != 0 && dl == 0 ? (
    trim_l = max(-24, min(24, trim_l + dr)); sliderchange(1);
  );
);
prev_l = trim_l; prev_r = trim_r;

@block
blocks += 1;
nch = num_ch >= 2 ? 2 : 1;

// trims: one-pole towards the target, about 20 ms
gl_t = 10 ^ (trim_l / 20); gr_t = 10 ^ (trim_r / 20);
kg = 1 - exp(-1 / (0.02 * srate));
kv = 1 - exp(-1 / (0.065 * srate));       // VU: 99% in 300 ms
pkdec = 10 ^ (-20 / 20 / srate);          // peak falls 20 dB a second

// filters: a slope change designs at once and clears the state; the
// frequency glides (about 30 ms, in octaves) and redesigns as it goes
kf = 1 - exp(-samplesblock / (0.03 * srate));
n = lc_f <= LC_OFF ? 0 : orderOf(lc_s);
n != lc_n ? ( lc_n = n; lc_cur = lc_f; clearState(BUF_LC); n > 0 ? design(BUF_LC, n, lc_cur, 1); );
lc_n > 0 && abs(log(lc_f / lc_cur)) > 0.0005 ? (
  lc_cur *= exp(log(lc_f / lc_cur) * kf); design(BUF_LC, lc_n, lc_cur, 1);
);
n = hc_f >= HC_OFF ? 0 : orderOf(hc_s);
n != hc_n ? ( hc_n = n; hc_cur = hc_f; clearState(BUF_HC); n > 0 ? design(BUF_HC, n, hc_cur, 0); );
hc_n > 0 && abs(log(hc_f / hc_cur)) > 0.0005 ? (
  hc_cur *= exp(log(hc_f / hc_cur) * kf); design(BUF_HC, hc_n, hc_cur, 0);
);

// this track's block
pl_tr = get_host_placement();
tb = (pl_tr >= -1 && pl_tr < TB_TRACKS - 1) ? TB_BASE + (pl_tr + 1) * TB_STRIDE : -1;

tb >= 0 ? (
  // the spectrum runs only while a panel keeps the heartbeat moving
  hb = gmem[tb + G_SHB];
  hb != spec_hb ? ( spec_hb = hb; spec_idle = 0; ) : spec_idle += samplesblock;
  spec_on = spec_idle < srate * 0.5;

  // Listen: a new number starts a measurement, 0 stops it (the result
  // stays published)
  c = gmem[tb + G_LCMD];
  c != lis_cmd ? (
    lis_cmd = c;
    c > 0 ? ( lis_n = 0; lis_sl = lis_sr = 0; lis_pl = lis_pr = 0; );
    gmem[tb + G_LACK] = c;
  );
  lis_n > 0 ? (
    gmem[tb + G_LMSL] = lis_sl / lis_n; gmem[tb + G_LMSR] = lis_sr / lis_n;
    gmem[tb + G_LPKL] = lis_pl; gmem[tb + G_LPKR] = lis_pr;
  );
  gmem[tb + G_LN] = lis_n;

  // meters: sine-calibrated (a sine's mean square is half its peak squared)
  gmem[tb + G_VUL] = 10 * log10(max(msl, E15)) + 3.0103;
  gmem[tb + G_VUR] = 10 * log10(max(nch > 1 ? msr : msl, E15)) + 3.0103;
  gmem[tb + G_PKL] = 20 * log10(max(pkl, E10));
  gmem[tb + G_PKR] = 20 * log10(max(nch > 1 ? pkr : pkl, E10));
  gmem[tb + G_NCH] = nch;
  gmem[tb + G_SEQ] = blocks;

  // a spectrum frame for every HOP samples gathered
  spec_on && hop_n >= HOP ? (
    hop_n = 0;
    i = 0; j = ring_pos;
    loop(FFT_N,
      BUF_FFT[i * 2] = BUF_RING[j] * BUF_WIN[i]; BUF_FFT[i * 2 + 1] = 0;
      i += 1; j += 1; j >= FFT_N ? j = 0;
    );
    fft(BUF_FFT, FFT_N);
    fft_permute(BUF_FFT, FFT_N);
    // each band: its loudest bin, rising at once and falling 30 dB/s
    fall = 30 * HOP / srate;
    b = 0;
    loop(BANDS,
      lo = ceil(BUF_BED[b]); hi = ceil(BUF_BED[b + 1]);
      hi < lo + 1 ? hi = lo + 1;
      lo < 1 ? lo = 1; hi > FFT_N / 2 ? hi = FFT_N / 2;
      m = 0; k = lo;
      while (k < hi) (
        re = BUF_FFT[k * 2]; im = BUF_FFT[k * 2 + 1];
        p = re * re + im * im; p > m ? m = p;
        k += 1;
      );
      // 4 / N: a full-scale sine reads 0 dB under the Hann window
      d = 10 * log10(max(m, E20)) + 20 * log10(4 / FFT_N);
      BUF_BDB[b] = d > BUF_BDB[b] - fall ? d : BUF_BDB[b] - fall;
      gmem[tb + G_BAND + b] = BUF_BDB[b];
      b += 1;
    );
    gmem[tb + G_SBN] = BANDS; gmem[tb + G_SBLO] = BAND_LO; gmem[tb + G_SBHI] = BAND_HI;
    sseq += 1; gmem[tb + G_SSEQ] = sseq;
  );
);

@sample
x0 = spl0; x1 = nch > 1 ? spl1 : spl0;

// Listen measures the input, before the trim: the trim it sets doesn't
// change what it measures
lis_cmd > 0 ? (
  lis_sl += x0 * x0; lis_sr += x1 * x1;
  ax = abs(x0); ax > lis_pl ? lis_pl = ax;
  ax = abs(x1); ax > lis_pr ? lis_pr = ax;
  lis_n += 1;
);

gl += (gl_t - gl) * kg; gr += (gr_t - gr) * kg;
y0 = x0 * gl; y1 = x1 * gr;

spec_on ? (
  BUF_RING[ring_pos] = (y0 + y1) * 0.5;
  ring_pos += 1; ring_pos >= FFT_N ? ring_pos = 0;
  hop_n += 1;
);

lc_n > 0 ? ( y0 = run(BUF_LC, 0, y0); y1 = run(BUF_LC, 1, y1); );
hc_n > 0 ? ( y0 = run(BUF_HC, 0, y0); y1 = run(BUF_HC, 1, y1); );

msl += (y0 * y0 - msl) * kv; msr += (y1 * y1 - msr) * kv;
ay = abs(y0); pkl = ay > pkl * pkdec ? ay : pkl * pkdec;
ay = abs(y1); pkr = ay > pkr * pkdec ? ay : pkr * pkdec;

spl0 = y0;
nch > 1 ? spl1 = y1;
