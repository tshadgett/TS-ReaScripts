desc:- TS_TrackProbe -
version: 1.5.0
author: Tim Shadgett
// @noindex
// Ships as part of the Track Analyser package (its @provides lists this
// file as [effect]); it is not a package to install on its own.
// MIT licence -- see LICENSE in the TS-ReaScripts repository.
//========================================================================
// One JSFX, two jobs. Put a copy either side of InfiniStrip inside an FX
// container and the panel gets both the untouched signal and the processed
// one, from the same audio thread, on the same block boundaries.
//
// It does not alter the audio. It reads it.
//
// WHY IT HAS A "Publish" SWITCH
//   The panel never inserts or removes anything. You bake the container into
//   your track templates and every track carries a pair of these, idle. The
//   panel arms the pair on the selected track by writing one parameter, and
//   disarms the previous pair the same way. An idle probe does no FFT, no
//   windowing, no gmem writes -- it costs a branch per sample. Fifty armed
//   templates cost nothing.
//
// WHY IT HAS A "Position" SWITCH
//   Pre and post write to different regions of gmem. You do not have to set
//   this: the panel works out which probe comes first in the chain and sets
//   it for you. It is a slider only so you can see what the panel decided,
//   and so the thing still works if you drive it by hand.
//
// gmem namespace TS_TA_Mem, shared with the measurement tools.
//   0  - 19    TS_TA_Cal        (calibration rig -- do not reuse)
//   20 - 23    TS_TA_WaveProbe  (superseded, left alone)
//   64 - 95    control, panel -> probes
//   0x10000    PRE  block
//   0x20000    POST block
//   0x30000    COMPARISON block -- the post probe of the track the panel
//              is comparing against, for the masking overlay
//   0x40000    Visualizer slots, + slot*2048
//   0x4F000    tap header, 0x50000 tap traces (PER-PLUGIN GAIN REDUCTION)
//   0x54000    per-tap waveforms, 0x5C000 their header (PER-PLUGIN WAVEFORMS)
//   0x60000    measuring the taps' zero, + track index * 8 (THE ZERO POINT)
//   73         tap heartbeat, bumped by any reader
//   74         which track's post probe writes the per-tap waveforms
//
// INPUT AND OUTPUT LEVELS, PER TAP
//   The same two copies a tap measures gain reduction from are also the
//   plugin's input and output, so their levels are kept too: peak (falling
//   20 dB/s, so a reader polling at frame rate still catches a transient)
//   and true RMS (300 ms), both channels, published in dBFS about thirty
//   times a second on tap_inpkN / tap_outpkN / tap_inrmsN / tap_outrmsN.
//   ChannelView draws them as a plugin's input and output meters.
//
//   A tap can be laid for levels alone (tap_nogr, a bit per tap, set by
//   ChannelView): a plugin that reports its own gain reduction but whose
//   levels you want. Such a tap skips the filterbank entirely -- levels
//   cost a few operations a sample -- and takes no part in the zero
//   measurement. While the zero is being measured the levels fall away
//   rather than show the test noise.
//
// PER-PLUGIN WAVEFORMS
//   For ChannelView's expanded gain-reduction panel: each tapped plugin's
//   output waveform (min and max), its input peak, and -- for a tap that
//   measures it -- its gain reduction, one column every 4 ms, 2048 columns
//   (8.2 s) per tap, advancing only while the transport runs. On a clock of their own, not the scope's: the scope
//   only runs while Track Analyser publishes this track, and the panel
//   must work without it.
//   The region is shared by every probe in the project, so ONE track
//   writes it: the one whose index + 1 ChannelView puts in gmem[74], and
//   only while the tap heartbeat (73) is alive. 0 there and nobody writes.
//     0x5C000  [0] newest column  [1] columns  [2] samples per column
//              [3] sample rate    [4] writer (track index + 1)
//              [5] columns written, ever (a reader spots a stalled writer)
//     0x54000 + (tap * 2048 + column) * 4:
//              [0] output min  [1] output max  [2] input peak  [3] GR dB

// Control block (the panel writes these; 0 means "use my default"):
//   64  epoch      bump to make both probes restart in step
//   65  fft size   power of two, 256 .. 4096
//   66  slice      samples per scope column
//   67  heartbeat  panel is alive
//   68  measure    1 = accumulate a linear power average for measurement
//
// MEASURING A PLUGIN WITH TWO PROBES
//   Both probes live in the same audio thread, take the same FFT size, and
//   restart together on the epoch, so their frames are sample-aligned. The
//   difference between their averaged spectra is therefore the magnitude
//   response of whatever sits between them -- the whole curve at 1024
//   points, from one capture, instead of a stepped tone sweep.
//
//   That matters for narrow features. A Q 20 bell at 632 Hz is about
//   0.036 octaves wide; the tone sweep that measured the filters stepped
//   0.23 octaves and never landed on the peak. Bin spacing here is about
//   0.001 octaves there.
//
//   The source never has to be spectrally flat: any colour in it cancels in
//   the ratio between the two probes. What does NOT cancel is
//   non-linearity, so a reading taken through heavy saturation describes
//   the saturation as much as the filter.
//
//   The probe used to be able to generate its own excitation for the
//   stepped-measurement rig. Those scripts are archived and the generator
//   went with them: it replaced the incoming audio when armed, which is a
//   sharp edge to leave on a plugin that lives in every track template.
//
// Probe block, relative to its base:
//    0  seq            increments on every publication -- the panel waits
//                      for this to advance rather than sampling on a clock,
//                      which is what fixed the measurement rig
//    3  srate
//    4  nbins
//    5  fft size
//    6  slice
//    7  epoch ack
//    8  scope cursor   next column to be written
//    9  scope columns
//   10  block counter  heartbeat, panel uses it to spot a dead probe
//   11  role           0 pre, 1 post, 2 comparison
//   12  channels
//   15  average count  frames in the measurement average, 0 when not measuring
// 4096  + col*3 + 0            scope minimum
// 4096  + col*3 + 1            scope maximum
// 4096  + col*3 + 2            scope RMS
// 16384 + band*4 + 0           display level, dB, ballistic
// 16384 + band*4 + 1           band average, dB, mean power
// 16384 + band*4 + 2           response, dB          (post probe only)
// 16384 + band*4 + 3           excitation, dB <= 0   (post probe only)
//
// SLOTS 1, 2, 13 AND 14 ARE RESERVED, NOT PUBLISHED. They carried RMS and
// peak meters that nothing ever read; the per-sample work behind them is
// gone. Named here so nothing else claims them.
//
// "INCLUDE IN VISUALIZER SPECTRUM" (vis_include / vis_slot)
//   TS_Visualizer's Spectrum panel can colour its peaks by whichever
//   watched track is loudest at that frequency. That started folder-only,
//   fed by a dedicated companion probe (TS_SpectrumProbe.jsfx, since
//   retired), because this plugin's Pre/Post/Comparison addressing has
//   room for at most two tracks project-wide -- fine for Track Analyser's
//   own panel, not for several tracks watched at once. This checkbox pair
//   is what replaced that companion: a second, independent publishing
//   path out of the SAME probe, so nothing extra needs inserting.
//
//   vis_include is a plain opt-in checkbox: since a TS_TrackProbe pair
//   ships baked into every track template, EVERY track has one of these,
//   almost always idle, and "has the plugin" can't be what makes a track
//   selectable in the Visualizer's picker or the list would be the whole
//   project. Ticking it just means "this instance is a candidate"; it is
//   its own on/off, independent of Position and of this track's own
//   Publish switch below, so leaving Track Analyser's panel pointed
//   elsewhere doesn't drop a track out of the Visualizer.
//
//   vis_slot is NOT a user control -- TS_Visualizer assigns it (0..15, or
//   -1 for "not currently watching this one"): a claim on
//   0x40000 + slot*2048, the same slot space the retired companion probe
//   used, so the Visualizer's reading side didn't need to change when
//   this replaced it. Ticking vis_include only makes a track a CANDIDATE;
//   nothing is published under this track's identity until the
//   Visualizer's own picker actually selects it and hands back a slot.
//
//   Whichever band data this probe already has -- this instance's own
//   role, Pre or Post or Comparison, whatever track it is physically on --
//   is what gets copied out. There's no re-analysis: the FFT and the
//   per-band ballistic level (field 0 of the block below) already exist
//   for Track Analyser's own use; this just mirrors that same number into
//   a simpler one-field-per-band layout at the claimed slot, once
//   vis_include and a claimed slot both hold.
//
// PER-PLUGIN GAIN REDUCTION: THE TAPS
//   Everything above measures the span between the two probes as one
//   thing. That cannot tell two compressors apart, and it cannot give a
//   compressor that doesn't report its gain reduction a meter of its own.
//   The taps can. For each plugin being measured (up to four), ChannelView
//   routes two extra stereo pairs to the POST probe: a copy of the signal
//   going into that plugin (written by whatever plugin sits in front of
//   it) and a copy of what comes out. Those arrive here on pins 3..18.
//   Nothing is inserted next to the plugin; the pairs just ride along on
//   spare track channels.
//
//   Each tap runs the same idea as the span's measured trace, but on its
//   own plugin only:
//     * the "before" signal is delayed by that plugin's reported latency
//       (tap_lagN, written by ChannelView), so both sides line up
//     * both go through the ten-band filterbank, a column every 2 ms
//     * per band, the ratio after/before, smoothed. A static EQ inside the
//       plugin is a constant per band; make-up gain is a constant in every
//       band; compression moves every band together
//     * each band keeps a BASELINE: the highest ratio it has seen, sinking
//       at 0.1 dB/s. Reduction is how far below its baseline a band sits,
//       and the tap's reading is the MEDIAN across bands, so one band
//       doing something odd cannot drag the number.
//
//   The baseline is the zero point, and it is the part that can be wrong:
//   learnt from the music, it is the least-compressed moment the plugin
//   has shown, and a compressor that never lets go reads low -- by how
//   much it never releases (3.4 dB low on synthetic material; a steady
//   test tone held at -5 dB read 0). So the baseline is only the
//   fallback. The real zero is MEASURED, while playback is stopped:
//
// THE ZERO POINT: MEASURED WHILE STOPPED
//   Every time playback stops, the pre probe feeds a quiet test signal
//   into the chain -- pink noise, one second at -60 dBFS and one at -50 --
//   and the post probe silences its own output while it does, so nothing
//   is heard and Track Analyser sees nothing. Quiet enough that no
//   compressor set for music is working on it, so what each tap sees then
//   -- every band's after/before ratio -- is the plugin with NO reduction:
//   its make-up, its static EQ, its saturation's small-signal gain. That
//   is the zero. While playing, reduction is how far each band sits below
//   it, median across bands as before.
//
//   Each band keeps the higher of the two levels' ratios, so a compressor
//   still recovering from the music, or a gate shut on the quieter level,
//   doesn't drag the zero down. When the two disagree by more than 1 dB
//   the plugin was level-dependent even down there, and tap_calN says so.
//
//   It waits for a second of silence at both probes first (the music's
//   end, and the compressor's release, have to clear), stops the moment
//   playback starts or anything arrives at either probe, and is only done
//   for a pre probe ChannelView has armed (cal_arm). A run interrupted
//   keeps the zero there was. The zero survives play and stop: ext_noinit
//   is set, so REAPER doesn't re-zero this plugin's memory on every
//   transport change, which it otherwise does.
//
//   tap_calN, read-only: 0 never measured (the music baseline is in use),
//   1 measured, 2 measured but the plugin was level-dependent at the test
//   level, 3 measured but the plugin has been touched since -- a make-up
//   change moves the zero, and the next stop measures it again. A touch
//   (tap_rstN) also resets the music baseline, as before. A new routing
//   (tap_gen bumped by ChannelView) forgets every zero: tap 1 may be a
//   different plugin now.
//
//   The two probes talk through gmem at CAL_BASE + track index * 8, the
//   track index from get_host_placement(). Needs REAPER's "Run FX when
//   stopped" (on by default). Measured on synthetic material: a
//   compressor that never lets go reads its true average to within
//   0.1 dB once calibrated.
//
//   The reading comes out on tap_grN, a read-only slider, so any script
//   can read it from any track with TrackFX_GetParam -- no arming, no
//   gmem addressing, every track at once. While Track Analyser has this
//   track armed, each tap's per-column reduction also goes to gmem at
//   TAPTR_BASE on the panel's own column clock, for its traces.
//
//   The taps only run while a reader is alive: something must keep
//   changing gmem[73] (ChannelView and Track Analyser both do). With
//   neither open they cost nothing.
//
//   The tap pins are INPUTS ONLY. The copies carry on along their spare
//   channels after this probe; ChannelView picks channels that nothing
//   after the probe uses and that a parent track has too few channels to
//   receive. Declaring outputs to silence them would have been tidier,
//   but a probe already saved in a project could come back with those
//   output pins mapped and their inputs not -- and then it would write
//   silence over channels 3/4 on every track, sidechains included.
//========================================================================

options:gmem=TS_TA_Mem

slider1:role=0<0,2,1{Pre -- before the strip,Post -- after the strip,Comparison track}>Position
slider2:publish=0<0,1,1{Idle,Publishing}>Publish
slider3:rel_ms=400<50,2000,10>Spectrum release (ms)
slider4:vis_include=0<0,1,1{No,Yes}>Include in Visualizer Spectrum
slider5:vis_slot=-1<-1,15,1>Visualizer Slot (set automatically)
// Taps (see PER-PLUGIN GAIN REDUCTION above). Hidden: ChannelView sets
// the first eleven and reads the last four.
slider6:tap_n=0<0,4,1>-Measured plugins
slider7:tap_lag1=0<0,65536,1>-Tap 1 latency (samples)
slider8:tap_lag2=0<0,65536,1>-Tap 2 latency (samples)
slider9:tap_lag3=0<0,65536,1>-Tap 3 latency (samples)
slider10:tap_lag4=0<0,65536,1>-Tap 4 latency (samples)
slider11:tap_rst1=0<0,1000000,1>-Tap 1 relearn
slider12:tap_rst2=0<0,1000000,1>-Tap 2 relearn
slider13:tap_rst3=0<0,1000000,1>-Tap 3 relearn
slider14:tap_rst4=0<0,1000000,1>-Tap 4 relearn
slider15:tap_gr1=0<0,60,0.01>-Tap 1 gain reduction (dB)
slider16:tap_gr2=0<0,60,0.01>-Tap 2 gain reduction (dB)
slider17:tap_gr3=0<0,60,0.01>-Tap 3 gain reduction (dB)
slider18:tap_gr4=0<0,60,0.01>-Tap 4 gain reduction (dB)
// The zero (see THE ZERO POINT). tap_calN are read; tap_gen and cal_arm
// are set by ChannelView.
slider19:tap_cal1=0<0,3,1>-Tap 1 zero (0 none 1 ok 2 level-dependent 3 touched since)
slider20:tap_cal2=0<0,3,1>-Tap 2 zero
slider21:tap_cal3=0<0,3,1>-Tap 3 zero
slider22:tap_cal4=0<0,3,1>-Tap 4 zero
slider23:tap_gen=0<0,1000000,1>-Tap routing generation
slider24:cal_arm=0<0,1,1>-Measure the zero while stopped (pre probe)
// Levels (INPUT AND OUTPUT LEVELS, PER TAP). tap_nogr is set by
// ChannelView; the rest are read.
slider25:tap_nogr=0<0,15,1>-Taps measuring levels only (a bit per tap)
slider26:tap_inpk1=-150<-150,24,0.1>-Tap 1 input peak (dBFS)
slider27:tap_inpk2=-150<-150,24,0.1>-Tap 2 input peak (dBFS)
slider28:tap_inpk3=-150<-150,24,0.1>-Tap 3 input peak (dBFS)
slider29:tap_inpk4=-150<-150,24,0.1>-Tap 4 input peak (dBFS)
slider30:tap_outpk1=-150<-150,24,0.1>-Tap 1 output peak (dBFS)
slider31:tap_outpk2=-150<-150,24,0.1>-Tap 2 output peak (dBFS)
slider32:tap_outpk3=-150<-150,24,0.1>-Tap 3 output peak (dBFS)
slider33:tap_outpk4=-150<-150,24,0.1>-Tap 4 output peak (dBFS)
slider34:tap_inrms1=-150<-150,24,0.1>-Tap 1 input RMS (dBFS)
slider35:tap_inrms2=-150<-150,24,0.1>-Tap 2 input RMS (dBFS)
slider36:tap_inrms3=-150<-150,24,0.1>-Tap 3 input RMS (dBFS)
slider37:tap_inrms4=-150<-150,24,0.1>-Tap 4 input RMS (dBFS)
slider38:tap_outrms1=-150<-150,24,0.1>-Tap 1 output RMS (dBFS)
slider39:tap_outrms2=-150<-150,24,0.1>-Tap 2 output RMS (dBFS)
slider40:tap_outrms3=-150<-150,24,0.1>-Tap 3 output RMS (dBFS)
slider41:tap_outrms4=-150<-150,24,0.1>-Tap 4 output RMS (dBFS)

in_pin:left
in_pin:right
in_pin:tap 1 before L
in_pin:tap 1 before R
in_pin:tap 1 after L
in_pin:tap 1 after R
in_pin:tap 2 before L
in_pin:tap 2 before R
in_pin:tap 2 after L
in_pin:tap 2 after R
in_pin:tap 3 before L
in_pin:tap 3 before R
in_pin:tap 3 after L
in_pin:tap 3 after R
in_pin:tap 4 before L
in_pin:tap 4 before R
in_pin:tap 4 after L
in_pin:tap 4 after R
out_pin:left
out_pin:right

@init

  // REAPER re-zeroes a JSFX's memory and re-runs @init on every play and
  // stop unless told not to. The taps' zero is measured WHILE stopped and
  // used while playing, so it has to survive the transport.
  ext_noinit = 1;

  CTRL_EPOCH = 64;
  CTRL_FFT   = 65;
  CTRL_SLICE = 66;
  CTRL_BEAT  = 67;
  CTRL_MEAS  = 68;   // 0 = off, 1 = accumulate (one capture), 2 = running
  CTRL_TAU   = 69;   // running-average time constant in ms, mode 2 only
  CTRL_SMOO  = 70;   // response smoothing width in OCTAVES, 0 = none
  CTRL_LAG   = 71;   // samples of latency reported by the FX BETWEEN the
                     // probes. The pre probe delays itself by this much so
                     // that its column N and the post probe's column N hold
                     // the same slice of audio. See THE DELAY below.
  CTRL_GRB   = 72;   // 1 = run the gain-reduction filterbank. Off unless the
                     // panel is drawing the measured trace, because it is
                     // the only per-sample work here that is not free.

  PRE_BASE  = 0x10000;
  POST_BASE = 0x20000;
  // A third region, written by the POST probe of whatever track the panel
  // is comparing against. It is a separate base rather than a slot scheme
  // because the comparison is between exactly two tracks: the one you are
  // looking at and the one you picked.
  CMP_BASE  = 0x30000;

  H_SEQ=0; H_RMS=1; H_PEAK=2; H_SRATE=3; H_NBINS=4; H_FFTSZ=5;
  H_SLICE=6; H_EPOCHACK=7; H_CUR=8; H_COLS=9; H_BLOCKS=10;
  H_ROLE=11; H_NCH=12; H_PKL=13; H_PKR=14; H_AVGN=15;
  H_BANDN=16; H_BANDLO=17; H_BANDHI=18;
  H_GRBN=19; H_GRBLO=20; H_GRBHI=21;
  H_LAG=22;                       // the delay actually applied, so the panel
                                  // can show what it compensated rather than
                                  // what it asked for

  // OFF_SPEC (64) and OFF_AVG (2048) used to carry a per-bin spectrum and
  // a per-bin average into gmem, about two thousand writes per frame per
  // probe. Nothing reads them: the panel reads the band summary below and
  // the scope ring, and the measurement scripts that wanted per-bin data
  // are archived with the probe they were written against. The regions are
  // left unwritten rather than reused, so an old tool reads zeros instead
  // of something that looks plausible and is not.
  OFF_SCOPE = 4096;
  SCOPE_COLS = 4096;              // 8.2 s of history at 2 ms per column

  // THE LOG-SPACED SUMMARY, AND WHY IT IS DONE HERE
  //   The panel used to read every one of 1024 bins from both probes and
  //   then draw a quad per pixel column -- about three thousand gmem reads
  //   and four thousand marshalled draw calls a frame, which is what made
  //   it lag. Nothing about that work needs to happen in Lua: this is one
  //   pass over data the DSP already has in front of it.
  //
  //   Summarising to a log grid is also the fix for the jagged response
  //   curve. A per-bin difference shows every bit of bin-to-bin noise in
  //   the average; a band holding a dozen bins averages it away, and it
  //   holds most bins exactly where the jaggedness was -- the top end.
  //
  //   Per point, stride 4:
  //     0  display level, dB, ballistic, loudest bin in the band
  //     1  measurement average, dB, mean POWER over the band
  //     2  response, dB   (post probe only: this band minus the pre probe's)
  //     3  excitation, dB below the loudest band  (post probe only, <= 0)
  OFF_BAND  = 16384;
  BANDS   = 256;
  BAND_LO = 20;
  BAND_HI = 20000;

  // Visualizer bridge -- the slot addressing TS_Visualizer.lua reads
  // (0x40000 + slot*2048, a header plus 256 band values per slot).
  VIS_SLOT_BASE   = 0x40000;
  VIS_SLOT_STRIDE = 2048;
  VIS_MAX_SLOTS   = 16;
  VIS_H_SEQ = 0; VIS_H_BANDN = 1; VIS_H_BANDLO = 2; VIS_H_BANDHI = 3; VIS_H_FFTSZ = 4;
  VIS_OFF_BAND = 16;
  vis_slotn = -2;   // last vis_slot a header was published for; forces one
                    // republish the first time vis_include+slot both hold,
                    // and again on every slot change after that
  vis_seq = 0;

  // THE GAIN-REDUCTION FILTERBANK, AND WHY IT EXISTS
  //   The measured trace used to be post RMS over pre RMS across the whole
  //   span. That is not gain: it is the span's LEVEL change, and when
  //   anything in the span changes the SPECTRUM, the level change depends
  //   on where the programme's energy happens to be sitting. One EQ band,
  //   +6 dB at 100 Hz, adds +6 dB to the ratio through a bass note and
  //   nothing through a cymbal. The EQ never moved; the music did, and it
  //   went onto the trace as if it were compression. Measured on a 13 dB
  //   reduction it drew a 39 dB one.
  //
  //   A per-BAND ratio does not have that property. Band b's ratio is the
  //   EQ's gain in band b whatever the programme is doing. So each probe
  //   publishes a per-band level per scope column, and the panel takes the
  //   part that MOVES and is COMMON TO EVERY BAND -- which is compression --
  //   after subtracting each band's own average, which is the static EQ.
  //
  //   Ten bands over 30 Hz to 18 kHz, two cascaded bandpass sections each.
  //   One section is not enough: its skirts overlap so far that neighbouring
  //   bands leak into each other and the separation that the whole idea
  //   rests on stops working. Measured over six EQ and saturation chains,
  //   one section gave 1.53 dB of error against the true reduction, two
  //   gave 0.86 -- the same as a 4th-order design costing twice as much.
  OFF_GRB = 17408;                // SCOPE_COLS * GRB_N, ends at 58368
  GRB_N   = 10;
  GRB_LO  = 30;
  GRB_HI  = 18000;

  // Long enough for any plugin that reports honestly -- a linear-phase EQ
  // at 4096 and a lookahead limiter at 50 ms both fit several times over.
  DLY_MAX = 65536;

  FFT_MAX = 4096;

  // Local buffers. The FFT workspace sits at offset 0 so it satisfies any
  // alignment REAPER wants, whatever the size ends up being.
  BUF_FFT = 0;                    // FFT_MAX*2, interleaved re/im
  BUF_ACC = 8192;                 // FFT_MAX,   accumulating input
  BUF_WIN = 16384;                // FFT_MAX,   Hann window
  BUF_MAG = 24576;                // FFT_MAX/2, smoothed dB per bin
  BUF_AVG = 32768;                // FFT_MAX/2, accumulated power for the
                                  //            measurement average
  BUF_BEDGE = 40960;              // BANDS+1, band edges in bins
  BUF_BA    = 41472;              // BANDS,   this probe's band average, dB
  BUF_BR    = 41728;              // BANDS,   the response before smoothing
  BUF_BT    = 41984;              // BANDS,   smoothing scratch
  BUF_BV    = 42240;              // BANDS,   1 where the band has real data
  BUF_GRC   = 42496;              // GRB_N*4, bandpass coefficients
  BUF_GRS   = 42624;              // GRB_N*4, two sections of state per band
  BUF_GRQ   = 42752;              // GRB_N,   squares accumulating this column
  BUF_DLY   = 49152;              // DLY_MAX+1, the pre probe's alignment delay

  fftsz = 0;                      // forces buildWindow on the first block
  last_meas = -1;                 // forces one clearAvg on the first block
  lagn = -1;                      // forces one setLag on the first block
  dpos = 0;
  grbon = 0;
  slice = 0;
  seq = 0;
  blocks = 0;
  last_epoch = -1;

  function buildWindow(n) local(i, ph) (
    i = 0;
    loop(n,
      ph = 2 * $pi * i / n;
      BUF_WIN[i] = 0.5 - 0.5 * cos(ph);
      i += 1;
    );
  );

  // Instant attack, exponential release, per hop. An analyser that averages
  // the attack as well hides exactly the transients you are looking at.
  function setBallistics() (
    rel = exp(-1 * (hop / srate) / (max(rel_ms, 10) * 0.001));
  );

  // The average is cleared on its own as well as with everything else,
  // because switching between the one-shot and running modes changes what
  // BUF_AVG holds -- a sum of powers in one, a mean power in the other --
  // and carrying a sum into a mean is nonsense. Clearing it must NOT take
  // the scope ring with it: panel 2 should not blank because panel 1
  // changed its averaging.
  function clearAvg() local(i) (
    avgn = 0;
    gmem[base + H_AVGN] = 0;
    i = 0; loop(FFT_MAX / 2, BUF_AVG[i] = 0; i += 1; );
  );

  // The filterbank's own state: the two sections per band, and the squares
  // part-way through the column being accumulated. Carrying either across a
  // restart puts audio from before the change into the column after it.
  function clearGR() local(i) (
    i = 0; loop(GRB_N * 4, BUF_GRS[i] = 0; i += 1; );
    i = 0; loop(GRB_N,     BUF_GRQ[i] = 0; i += 1; );
  );

  // Ten bandpass filters, log-spaced, two identical sections each. Only the
  // three coefficients a bandpass actually needs are kept: b1 is zero and b2
  // is -b0, so storing them would be storing a constant.
  //
  // The top edge is held below Nyquist rather than trusted to be: at 32 kHz
  // an 18 kHz band centre is not a filter, it is a division by zero waiting
  // for somebody working at a rate nobody tested.
  function buildGRBands() local(i, ratio, lo, hi, f0, q, w0, al, a0, hiC) (
    hiC = min(GRB_HI, srate * 0.45);
    ratio = log(hiC / GRB_LO);
    i = 0;
    loop(GRB_N,
      lo = GRB_LO * exp(ratio * i / GRB_N);
      hi = GRB_LO * exp(ratio * (i + 1) / GRB_N);
      f0 = sqrt(lo * hi);
      q  = f0 / max(hi - lo, 1);
      w0 = 2 * $pi * f0 / srate;
      al = sin(w0) / (2 * q);
      a0 = 1 + al;
      BUF_GRC[i * 4 + 0] = al / a0;                 // b0
      BUF_GRC[i * 4 + 1] = (-2 * cos(w0)) / a0;     // a1
      BUF_GRC[i * 4 + 2] = (1 - al) / a0;           // a2
      BUF_GRC[i * 4 + 3] = 0;
      i += 1;
    );
    clearGR();
  );

  // Only as much of the line as is in use is cleared, and only when the
  // length changes: this runs on a block boundary, and wiping 64k of memory
  // every time the panel repeats itself is a dropout waiting to happen.
  function setLag(n) local(i) (
    n = max(0, min(DLY_MAX, floor(n)));
    n != lagn ? (
      lagn = n;
      dpos = 0;
      i = 0; loop(lagn + 1, BUF_DLY[i] = 0; i += 1; );
    );
  );

  function restart() local(i) (
    cur = 0;
    sacc = 0; smin = 1; smax = -1; ssq = 0;
    fill = 0;
    gmem[base + H_CUR] = 0;
    i = 0; loop(SCOPE_COLS * 3, gmem[base + OFF_SCOPE + i] = 0; i += 1; );
    i = 0; loop(SCOPE_COLS * GRB_N, gmem[base + OFF_GRB + i] = 0; i += 1; );
    clearGR();
    // The measurement average restarts with everything else, so a capture
    // can never contain a frame from before the setting changed.
    clearAvg();
  );

  // Where each band starts and ends, in bins. Recomputed only when the FFT
  // size or the sample rate changes, so the per-frame pass has no logs in it.
  function buildBands() local(i, ratio) (
    ratio = log(BAND_HI / BAND_LO);
    i = 0;
    loop(BANDS + 1,
      BUF_BEDGE[i] = BAND_LO * exp(ratio * i / BANDS) * fftsz / srate;
      i += 1;
    );
  );

  function reconfigure(newsz, newslice) local(i) (
    fftsz = newsz;
    nbins = fftsz / 2;
    hop   = fftsz / 2;
    slice = newslice;
    buildWindow(fftsz);
    buildBands();
    buildGRBands();
    setBallistics();
    i = 0; loop(nbins, BUF_MAG[i] = -180; i += 1; );
    restart();
  );

  //-- the taps ----------------------------------------------------------
  CTRL_TAPHB  = 73;               // bumped by any reader; taps idle when it stops
  TAPTR_HDR   = 0x4F000;          // [0] taps in use, [1..4] each tap's reading
  TAPTR_BASE  = 0x50000;          // tap t's column t*SCOPE_COLS + cur
  TAP_MAX     = 4;
  TAP_BASE    = 131072;           // clear of everything above
  TAP_STRIDE  = 66560;            // a delay line, then the state below
  TAP_S       = 65544;            // state, relative to the tap's base
  TS_PRE = 0; TS_POST = 40;       // filter state, 10 bands x 4
  TS_PA = 80; TS_PB = 90;         // column power accumulators
  TS_SM = 100; TS_BS = 110;       // smoothed ratio, baseline (dB)
  TS_PK = 120; TS_HB = 130;       // band peak (power), has-baseline flag
  TS_SORT = 140;                  // median scratch
  TS_DPOS = 160; TS_LAGN = 161; TS_DISP = 162; TS_LAST = 163; TS_RST = 164;
  // the measured zero (THE ZERO POINT): power sums per band for each test
  // level, before and after; the zero and its validity; a candidate being
  // checked; column counts; the state reported on tap_calN
  TS_AA = 170; TS_AB = 180; TS_BA = 190; TS_BB = 200;
  TS_ZERO = 210; TS_ZV = 220; TS_ZT = 230; TS_ZTV = 240;
  TS_NA = 250; TS_NB = 251; TS_HASCAL = 252; TS_CST = 253; TS_STALE = 254;
  // levels: input and output peak (falling), input and output mean square
  TS_LIP = 260; TS_LOP = 261; TS_LIR = 262; TS_LOR = 263;
  LV_FALL = 20;                   // dB/s the published peak falls
  LV_RMS  = 0.3;                  // s, the RMS window
  LV_RATE = 30;                   // publications a second
  tap_lvc = 0; tap_lvdead = 0;
  TAP_SMOOTH = 0.3;               // per column, see the prototype notes
  TAP_RISE   = 0.5;
  TAP_DEC    = 0.1;               // dB/s the baseline sinks
  TAP_REL    = 150;               // dB/s the reading falls: a short hold, so a
                                  // frame-rate reader catches a 2 ms peak, and
                                  // no slower -- the reader adds its own hold
  TAP_C      = 43008;             // GRB_N*4 coefficients of the taps' own filterbank
  tap_sr = 0; tap_sacc = 0; tap_on = 0; tap_live = 0;
  hb_last = -1; hb_age = 1000000000;

  // per-plugin waveforms (PER-PLUGIN WAVEFORMS)
  CTRL_TWTRK = 74;
  TW_BASE = 0x54000;
  TW_HDR  = 0x5C000;
  TW_COLS = 2048;
  TW_ACC  = 400000;               // per tap: min, max, input peak, GR -- clear of the taps
  tw_on = 0; tw_cur = 0; tw_sacc = 0; tw_n = 0; tw_slice = 192;
  t = 0; loop(TAP_MAX, TW_ACC[t * 4] = 1; TW_ACC[t * 4 + 1] = -1;
                       TW_ACC[t * 4 + 2] = 0; TW_ACC[t * 4 + 3] = 0; t += 1; );

  // measuring the zero
  CAL_BASE   = 0x60000;           // + track index * CAL_STRIDE
  CAL_STRIDE = 8;
  CAL_SLOTS  = 4096;
  CS_CFG = 0;                     // post: taps in use
  CS_PHASE = 1;                   // pre: 0 idle, 1 level A, 2 level B, 3 tail
  CS_PREHB = 2;                   // pre: block counter
  CS_POSTHB = 3;                  // post: block counter
  CS_REQ = 4;                     // post: a tap needs its zero measuring
  CS_POSTPK = 5;                  // post: input peak, last block
  CS_ABORT = 6;                   // post: something real arrived, stop
  CAL_GA = 10 ^ (-60 / 20) / 1.7276;   // pink noise at -60 dBFS RMS ...
  CAL_GB = 10 ^ (-50 / 20) / 1.7276;   // ... and -50 (the filter's own RMS)
  CAL_WAIT = 1.0;                 // s of silence before starting
  CAL_LEN = 1.0;                  // s at each level
  CAL_TAIL = 0.5;                 // s still muted after, for latency
  CAL_SETTLE = 0.3;               // s of each level not used
  CAL_GAP = 5;                    // s between runs asked for while stopped
  CAL_QUIET_PRE = 0.00001;        // -100 dBFS: nothing coming in
  CAL_QUIET_POST = 0.001;         // -60 dBFS: a plugin's own hiss allowed
  CAL_LOUD = 0.25;                // -12 dBFS at the post probe: not ours
  CAL_MINCOL = 100;
  CAL_MINBANDS = 5;
  cal_phase = 0; cal_t = 0; cal_quiet = 0; cal_since = 1000000000;
  cal_was_playing = 0; cal_hb = 0; cal_phb = 0; cal_inpk = 0; cal_ppk = 0;
  cal_post_last = -1; cal_post_age = 1000000000;
  cal_pre_last = -1; cal_pre_age = 1000000000;
  cal_ph = 0; cal_pt = 0; cal_acc = 0; cal_mute = 0; cal_fails = 0;
  cal_gen_last = -1; cal_slot = -1;
  kb0 = kb1 = kb2 = 0;

  function tapBands() local(i, ratio, lo, hi, f0, q, w0, al, a0, hiC) (
    hiC = min(GRB_HI, srate * 0.45);
    ratio = log(hiC / GRB_LO);
    i = 0;
    loop(GRB_N,
      lo = GRB_LO * exp(ratio * i / GRB_N);
      hi = GRB_LO * exp(ratio * (i + 1) / GRB_N);
      f0 = sqrt(lo * hi);
      q  = f0 / max(hi - lo, 1);
      w0 = 2 * $pi * f0 / srate;
      al = sin(w0) / (2 * q);
      a0 = 1 + al;
      TAP_C[i * 4 + 0] = al / a0;
      TAP_C[i * 4 + 1] = (-2 * cos(w0)) / a0;
      TAP_C[i * 4 + 2] = (1 - al) / a0;
      i += 1;
    );
    tap_slice = max(8, floor(srate * 0.002));
    tap_cps   = srate / tap_slice;
    tap_dec   = TAP_DEC / tap_cps;
    tap_rel   = TAP_REL / tap_cps;
    tap_pkdec = 10 ^ (-6 / 10 / tap_cps);   // band peaks fall 6 dB/s
    tap_lvpk  = 10 ^ (-LV_FALL / 20 / srate);
    tap_lvrk  = 1 - exp(-1 / (srate * LV_RMS));
    tap_lvn   = max(64, floor(srate / LV_RATE));
    tap_sr = srate;
  );

  // Everything a tap has learnt, gone: filter state, accumulators, the
  // baselines, the reading. The delay line is left to setTapLag.
  function tapReset(t) local(s, i) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    i = 0; loop(TS_SORT, s[i] = 0; i += 1; );
    s[TS_DISP] = 0; s[TS_LAST] = 0;
  );

  function setTapLag(t, n) local(tb, s, i) (
    tb = TAP_BASE + t * TAP_STRIDE;
    s = tb + TAP_S;
    n = max(0, min(DLY_MAX, floor(n)));
    // Only the delay line is cleared. What the tap has learnt -- each
    // band's baseline -- is a property of the plugin, not of the
    // alignment, so a latency change keeps it.
    n != s[TS_LAGN] ? (
      s[TS_LAGN] = n;
      s[TS_DPOS] = 0;
      i = 0; loop(n + 1, tb[i] = 0; i += 1; );
    );
  );

  // One sample of one tap: `a` is the mono sum before the plugin, `b`
  // after it. Delay a, filter both, accumulate each band's power.
  function tapSample(t, a, b) local(tb, s, n, dp, bi, c, fs, y, z) (
    tb = TAP_BASE + t * TAP_STRIDE;
    s = tb + TAP_S;
    n = s[TS_LAGN];
    n > 0 ? (
      dp = s[TS_DPOS];
      tb[dp] = a;
      dp += 1; dp > n ? dp = 0;
      a = tb[dp];
      s[TS_DPOS] = dp;
    );
    bi = 0;
    loop(GRB_N,
      c = TAP_C + bi * 4;
      fs = s + TS_PRE + bi * 4;
      y = c[0] * a + fs[0];
      fs[0] = fs[1] - c[1] * y;
      fs[1] = -c[0] * a - c[2] * y;
      z = c[0] * y + fs[2];
      fs[2] = fs[3] - c[1] * z;
      fs[3] = -c[0] * y - c[2] * z;
      s[TS_PA + bi] += z * z;
      fs = s + TS_POST + bi * 4;
      y = c[0] * b + fs[0];
      fs[0] = fs[1] - c[1] * y;
      fs[1] = -c[0] * b - c[2] * y;
      z = c[0] * y + fs[2];
      fs[2] = fs[3] - c[1] * z;
      fs[3] = -c[0] * y - c[2] * z;
      s[TS_PB + bi] += z * z;
      bi += 1;
    );
  );

  // A column's worth of one tap: per-band ratio against its baseline,
  // the median across bands, the meter's ballistics.
  function tapColumn(t) local(s, bi, pa, pb, pk, gate, r, d, n, j, g, zo) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    n = 0;
    // While the zero is being measured: sum each band's power for this
    // test level, and nothing else -- no baseline, no peak, no reading.
    cal_mute ? (
      cal_acc ? (
        bi = 0;
        loop(GRB_N,
          cal_ph == 1 ? (
            s[TS_AA + bi] += s[TS_PA + bi] / tap_slice;
            s[TS_AB + bi] += s[TS_PB + bi] / tap_slice;
          ) : (
            s[TS_BA + bi] += s[TS_PA + bi] / tap_slice;
            s[TS_BB + bi] += s[TS_PB + bi] / tap_slice;
          );
          bi += 1;
        );
        cal_ph == 1 ? (s[TS_NA] += 1) : (s[TS_NB] += 1);
      );
      bi = 0; loop(GRB_N, s[TS_PA + bi] = 0; s[TS_PB + bi] = 0; bi += 1; );
      s[TS_LAST] = 0;
      s[TS_DISP] = max(0, s[TS_DISP] - tap_rel);
    ) : (
    zo = s[TS_HASCAL] > 0.5;
    bi = 0;
    loop(GRB_N,
      pa = s[TS_PA + bi] / tap_slice;
      pb = s[TS_PB + bi] / tap_slice;
      s[TS_PA + bi] = 0; s[TS_PB + bi] = 0;
      pk = max(pa, s[TS_PK + bi] * tap_pkdec);
      s[TS_PK + bi] = pk;
      gate = max(0.000000001, pk * 0.00001);          // -90 dB, and 50 dB under the band's peak
      (pa > gate && pb > 0.00000000000001) ? (
        r = 10 * log10(pb / pa);
        s[TS_HB + bi] < 0.5 ? (
          s[TS_SM + bi] = r; s[TS_BS + bi] = r; s[TS_HB + bi] = 1;
        ) : (
          s[TS_SM + bi] += (r - s[TS_SM + bi]) * TAP_SMOOTH;
          s[TS_SM + bi] > s[TS_BS + bi]
            ? s[TS_BS + bi] += (s[TS_SM + bi] - s[TS_BS + bi]) * TAP_RISE
            : s[TS_BS + bi] -= tap_dec;
        );
        // the measured zero where there is one, the music's baseline where not
        d = max(0, ((zo && s[TS_ZV + bi] > 0.5) ? s[TS_ZERO + bi] : s[TS_BS + bi]) - s[TS_SM + bi]);
        // insertion into the sorted scratch
        j = n;
        while (j > 0 && s[TS_SORT + j - 1] > d) (
          s[TS_SORT + j] = s[TS_SORT + j - 1];
          j -= 1;
        );
        s[TS_SORT + j] = d;
        n += 1;
      );
      bi += 1;
    );
    g = n < 1 ? 0 : ((n & 1) ? s[TS_SORT + (n - 1) / 2]
                             : (s[TS_SORT + n / 2 - 1] + s[TS_SORT + n / 2]) * 0.5);
    g = min(g, 60);
    s[TS_LAST] = g;
    s[TS_DISP] = max(g, s[TS_DISP] - tap_rel);
    );
  );

  // A new run: what earlier runs summed is dropped. The zero in use stays
  // until this run proves a better one.
  function calClear() local(t, s, i) (
    t = 0;
    loop(TAP_MAX,
      s = TAP_BASE + t * TAP_STRIDE + TAP_S;
      i = TS_AA; loop(TS_ZERO - TS_AA, s[i] = 0; i += 1; );
      s[TS_NA] = 0; s[TS_NB] = 0;
      t += 1;
    );
  );

  // A run finished: each band's zero is the higher of its two levels'
  // ratios (a release still finishing, or a gate, only ever pulls a ratio
  // DOWN). Adopted when enough bands had signal; otherwise the old zero
  // stays. Returns 1 when adopted.
  function calCommit(t) local(s, bi, na, nb, va, vb, za, zb, n, m, j, d) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    na = s[TS_NA]; nb = s[TS_NB];
    n = 0; m = 0;
    bi = 0;
    loop(GRB_N,
      va = na >= CAL_MINCOL && s[TS_AA + bi] > 0.000000000001 * na && s[TS_AB + bi] > 0.00000000000001 * na;
      vb = nb >= CAL_MINCOL && s[TS_BA + bi] > 0.000000000001 * nb && s[TS_BB + bi] > 0.00000000000001 * nb;
      va ? (za = 10 * log10(s[TS_AB + bi] / s[TS_AA + bi]));
      vb ? (zb = 10 * log10(s[TS_BB + bi] / s[TS_BA + bi]));
      (va || vb) ? (
        s[TS_ZT + bi] = (va && vb) ? max(za, zb) : (va ? za : zb);
        s[TS_ZTV + bi] = 1;
        n += 1;
        (va && vb) ? (
          d = zb - za;
          j = m;
          while (j > 0 && s[TS_SORT + j - 1] > d) (
            s[TS_SORT + j] = s[TS_SORT + j - 1];
            j -= 1;
          );
          s[TS_SORT + j] = d;
          m += 1;
        );
      ) : (s[TS_ZTV + bi] = 0);
      bi += 1;
    );
    n >= CAL_MINBANDS ? (
      bi = 0;
      loop(GRB_N,
        s[TS_ZERO + bi] = s[TS_ZT + bi];
        s[TS_ZV + bi] = s[TS_ZTV + bi];
        bi += 1;
      );
      d = m < 1 ? 0 : ((m & 1) ? s[TS_SORT + (m - 1) / 2]
                                : (s[TS_SORT + m / 2 - 1] + s[TS_SORT + m / 2]) * 0.5);
      s[TS_HASCAL] = 1;
      s[TS_STALE] = 0;
      s[TS_CST] = (m >= 3 && abs(d) > 1) ? 2 : 1;
      1;
    ) : 0;
  );

  function calState(t) local(s) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    s[TS_HASCAL] < 0.5 ? 0 : (s[TS_STALE] > 0.5 ? 3 : s[TS_CST]);
  );

  function tapReading(t) ( (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_DISP]; );

  // Whether tap t is in use and measuring gain reduction (not levels only).
  function tapIsGR(t) ( t < tap_cfg && ((tap_nogr >> t) & 1) == 0; );

  // One sample of one tap's levels: before L/R, after L/R.
  function tapLevels(t, bl, br, al, ar) local(s, v) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    v = max(abs(bl), abs(br)); s[TS_LIP] = max(v, s[TS_LIP] * tap_lvpk);
    v = max(abs(al), abs(ar)); s[TS_LOP] = max(v, s[TS_LOP] * tap_lvpk);
    s[TS_LIR] += ((bl * bl + br * br) * 0.5 - s[TS_LIR]) * tap_lvrk;
    s[TS_LOR] += ((al * al + ar * ar) * 0.5 - s[TS_LOR]) * tap_lvrk;
  );

  // dBFS to a tenth, -150 for silence. `ms` is a mean square.
  function lvAmp(x) ( x > 0.0000000316 ? floor(200 * log10(x) + 0.5) / 10 : -150; );
  function lvMS(ms) ( ms > 0.000000000000001 ? floor(100 * log10(ms) + 0.5) / 10 : -150; );
  function lvGet(t, k) ( t < tap_cfg ? (TAP_BASE + t * TAP_STRIDE + TAP_S)[k] : 0; );

  tapBands();

@slider

  base = role < 0.5 ? PRE_BASE : (role < 1.5 ? POST_BASE : CMP_BASE);
  fftsz > 0 ? setBallistics();

@block

  base = role < 0.5 ? PRE_BASE : (role < 1.5 ? POST_BASE : CMP_BASE);

  // vis_slot is only ever a real 0..15 claim while TS_Visualizer is
  // actually watching this instance; -1 (its default, and what disarming
  // sets it back to) means "not right now" even if vis_include is still
  // ticked. Both have to hold, same as Track Analyser's own Publish gates
  // everything on "is anything reading this".
  vis_active = vis_include >= 0.5 && vis_slot >= 0 && vis_slot < VIS_MAX_SLOTS;

  // A track ticked for the Visualizer runs its own FFT/band pipeline
  // whether or not Track Analyser's panel happens to be pointed at this
  // track right now -- the whole point is several tracks live at once,
  // which is exactly what Track Analyser's own Publish switch was never
  // meant to do (see the "WHY IT HAS A Publish SWITCH" note up top: one
  // armed pair at a time, driven by panel selection). The Visualizer path
  // does not touch that switch and is not touched by it.
  active = publish >= 0.5 || vis_active;

  active ? (
    // What size does the panel want? Fall back to something sane if it has
    // not said, or has said something silly.
    want = gmem[CTRL_FFT];
    (want != 256 && want != 512 && want != 1024 && want != 2048 && want != 4096) ? want = 2048;

    wantslice = gmem[CTRL_SLICE];
    (wantslice < 8 || wantslice > srate) ? wantslice = max(8, floor(srate * 0.002));

    (want != fftsz || wantslice != slice) ? reconfigure(want, wantslice);

    ep = gmem[CTRL_EPOCH];
    ep != last_epoch ? ( last_epoch = ep; restart(); gmem[base + H_EPOCHACK] = ep; );

    // 1 = accumulate for one capture, 2 = keep a running average so a panel
    // can watch the response change while knobs move.
    measmode = gmem[CTRL_MEAS];
    meas = measmode > 0.5;
    live = measmode > 1.5;
    measmode != last_meas ? ( last_meas = measmode; clearAvg(); );

    smoo_oct = gmem[CTRL_SMOO];
    (smoo_oct < 0 || smoo_oct > 2) ? smoo_oct = 0;

    // THE DELAY. The FX between the probes cost this many samples, so the
    // post probe is seeing what the pre probe saw that long ago. REAPER
    // compensates PDC at the track OUTPUT, not inside a chain, so nothing
    // has put this right before it reaches us. Only the pre probe delays --
    // the post probe is the one already late.
    wantlag = gmem[CTRL_LAG];
    (wantlag < 0 || wantlag > DLY_MAX) ? wantlag = 0;
    setLag(role < 0.5 ? wantlag : 0);

    grbon = gmem[CTRL_GRB] > 0.5;

    tau_s = gmem[CTRL_TAU] * 0.001;
    (tau_s < 0.05 || tau_s > 30) ? tau_s = 1.0;
    avg_k = 1 - exp(-1 * (hop / srate) / tau_s);

    blocks += 1;
    gmem[base + H_SRATE]  = srate;
    gmem[base + H_NBINS]  = nbins;
    gmem[base + H_FFTSZ]  = fftsz;
    gmem[base + H_SLICE]  = slice;
    gmem[base + H_COLS]   = SCOPE_COLS;
    gmem[base + H_BLOCKS] = blocks;
    gmem[base + H_ROLE]   = role;
    gmem[base + H_NCH]    = num_ch;
    gmem[base + H_BANDN]  = BANDS;
    gmem[base + H_BANDLO] = BAND_LO;
    gmem[base + H_BANDHI] = BAND_HI;
    gmem[base + H_GRBN]   = grbon ? GRB_N : 0;
    gmem[base + H_GRBLO]  = GRB_LO;
    gmem[base + H_GRBHI]  = min(GRB_HI, srate * 0.45);
    gmem[base + H_LAG]    = lagn;

    // Visualizer bridge header. Only touches VIS_SLOT_BASE, never this
    // instance's own PRE/POST/CMP block above -- Track Analyser's panel
    // reads that block and must never see a value change because a
    // completely different tool ticked a completely different checkbox.
    vis_active ? (
      vbase = VIS_SLOT_BASE + vis_slot * VIS_SLOT_STRIDE;
      vis_slot != vis_slotn ? (
        // Slot just claimed (or moved): the header at the new address
        // needs writing now, not on the next FFT frame, or a caller
        // reading it in between sees whatever the previous occupant of
        // this slot left behind.
        vis_slotn = vis_slot;
        gmem[vbase + VIS_H_BANDN] = BANDS;
        gmem[vbase + VIS_H_BANDLO] = BAND_LO;
        gmem[vbase + VIS_H_BANDHI] = min(BAND_HI, srate * 0.45);
        gmem[vbase + VIS_H_FFTSZ] = fftsz;
      );
    ) : (
      vis_slotn = -2;   // dropped (unticked, or the Visualizer let go of
                        // the slot) -- forces a fresh header write if it
                        // ever comes back, rather than trusting stale
                        // state from before
    );
  );

  //-- the taps -----------------------------------------------------------
  // Post probe only, and only while a reader keeps gmem[73] moving: three
  // seconds without a change and the taps stop, so a project with nothing
  // open to read them pays nothing.
  hb = gmem[CTRL_TAPHB];
  hb != hb_last ? ( hb_last = hb; hb_age = 0; ) : hb_age += samplesblock;
  tap_cfg  = (role >= 0.5 && role < 1.5) ? max(0, min(TAP_MAX, floor(tap_n))) : 0;
  tap_live = tap_cfg > 0 && hb_age < srate * 3;
  tap_live ? (
    tap_sr != srate ? ( tapBands(); t = 0; loop(TAP_MAX, tapReset(t); t += 1; ); );
    setTapLag(0, tap_lag1); setTapLag(1, tap_lag2);
    setTapLag(2, tap_lag3); setTapLag(3, tap_lag4);
    // A bumped relearn counter drops what that tap has learnt: ChannelView
    // bumps it when the plugin is touched, so a new make-up gain is found
    // again rather than read as reduction.
    (TAP_BASE + TAP_S)[TS_RST] != tap_rst1 ? ( tapReset(0); (TAP_BASE + TAP_S)[TS_RST] = tap_rst1;
      (TAP_BASE + TAP_S)[TS_HASCAL] > 0.5 ? (TAP_BASE + TAP_S)[TS_STALE] = 1; );
    (TAP_BASE + TAP_STRIDE + TAP_S)[TS_RST] != tap_rst2 ? ( tapReset(1); (TAP_BASE + TAP_STRIDE + TAP_S)[TS_RST] = tap_rst2;
      (TAP_BASE + TAP_STRIDE + TAP_S)[TS_HASCAL] > 0.5 ? (TAP_BASE + TAP_STRIDE + TAP_S)[TS_STALE] = 1; );
    (TAP_BASE + 2 * TAP_STRIDE + TAP_S)[TS_RST] != tap_rst3 ? ( tapReset(2); (TAP_BASE + 2 * TAP_STRIDE + TAP_S)[TS_RST] = tap_rst3;
      (TAP_BASE + 2 * TAP_STRIDE + TAP_S)[TS_HASCAL] > 0.5 ? (TAP_BASE + 2 * TAP_STRIDE + TAP_S)[TS_STALE] = 1; );
    (TAP_BASE + 3 * TAP_STRIDE + TAP_S)[TS_RST] != tap_rst4 ? ( tapReset(3); (TAP_BASE + 3 * TAP_STRIDE + TAP_S)[TS_RST] = tap_rst4;
      (TAP_BASE + 3 * TAP_STRIDE + TAP_S)[TS_HASCAL] > 0.5 ? (TAP_BASE + 3 * TAP_STRIDE + TAP_S)[TS_STALE] = 1; );
  );
  // The readings, every block: a tap not in use, or not running, reads 0.
  g1 = (tap_live && tapIsGR(0)) ? tapReading(0) : 0;
  g2 = (tap_live && tapIsGR(1)) ? tapReading(1) : 0;
  g3 = (tap_live && tapIsGR(2)) ? tapReading(2) : 0;
  g4 = (tap_live && tapIsGR(3)) ? tapReading(3) : 0;
  (g1 != tap_gr1 || g2 != tap_gr2 || g3 != tap_gr3 || g4 != tap_gr4) ? (
    tap_gr1 = g1; tap_gr2 = g2; tap_gr3 = g3; tap_gr4 = g4;
    sliderchange(tap_gr1); sliderchange(tap_gr2);
    sliderchange(tap_gr3); sliderchange(tap_gr4);
  );
  // The levels, about thirty times a second while a reader is alive;
  // silence once, when it goes away.
  tap_live ? (
    tap_lvdead = 0;
    tap_lvc += samplesblock;
    tap_lvc >= tap_lvn ? (
      tap_lvc = 0;
      tap_inpk1 = lvAmp(lvGet(0, TS_LIP)); tap_inpk2 = lvAmp(lvGet(1, TS_LIP));
      tap_inpk3 = lvAmp(lvGet(2, TS_LIP)); tap_inpk4 = lvAmp(lvGet(3, TS_LIP));
      tap_outpk1 = lvAmp(lvGet(0, TS_LOP)); tap_outpk2 = lvAmp(lvGet(1, TS_LOP));
      tap_outpk3 = lvAmp(lvGet(2, TS_LOP)); tap_outpk4 = lvAmp(lvGet(3, TS_LOP));
      tap_inrms1 = lvMS(lvGet(0, TS_LIR)); tap_inrms2 = lvMS(lvGet(1, TS_LIR));
      tap_inrms3 = lvMS(lvGet(2, TS_LIR)); tap_inrms4 = lvMS(lvGet(3, TS_LIR));
      tap_outrms1 = lvMS(lvGet(0, TS_LOR)); tap_outrms2 = lvMS(lvGet(1, TS_LOR));
      tap_outrms3 = lvMS(lvGet(2, TS_LOR)); tap_outrms4 = lvMS(lvGet(3, TS_LOR));
      lvChanged = 1;
    );
  ) : (tap_lvdead == 0 ? (
    tap_lvdead = 1;
    tap_inpk1 = tap_inpk2 = tap_inpk3 = tap_inpk4 = -150;
    tap_outpk1 = tap_outpk2 = tap_outpk3 = tap_outpk4 = -150;
    tap_inrms1 = tap_inrms2 = tap_inrms3 = tap_inrms4 = -150;
    tap_outrms1 = tap_outrms2 = tap_outrms3 = tap_outrms4 = -150;
    lvChanged = 1;
  ));
  lvChanged ? (
    lvChanged = 0;
    sliderchange(tap_inpk1); sliderchange(tap_inpk2); sliderchange(tap_inpk3); sliderchange(tap_inpk4);
    sliderchange(tap_outpk1); sliderchange(tap_outpk2); sliderchange(tap_outpk3); sliderchange(tap_outpk4);
    sliderchange(tap_inrms1); sliderchange(tap_inrms2); sliderchange(tap_inrms3); sliderchange(tap_inrms4);
    sliderchange(tap_outrms1); sliderchange(tap_outrms2); sliderchange(tap_outrms3); sliderchange(tap_outrms4);
  );

  (active && tap_cfg > 0) ? (
    gmem[TAPTR_HDR] = tap_live ? tap_cfg : 0;
    gmem[TAPTR_HDR + 1] = g1; gmem[TAPTR_HDR + 2] = g2;
    gmem[TAPTR_HDR + 3] = g3; gmem[TAPTR_HDR + 4] = g4;
  );

  //-- measuring the zero (THE ZERO POINT) ----------------------------------
  // The two probes of a track meet at CAL_BASE + its index * CAL_STRIDE.
  // Nothing for the master (-1) or the monitoring chain (-2).
  cal_slot = -1;
  cal_pl = get_host_placement();
  (cal_pl >= 0 && cal_pl < CAL_SLOTS) ? cal_slot = CAL_BASE + cal_pl * CAL_STRIDE;

  // The per-tap waveforms: this track's post probe, while asked for.
  tw_was = tw_on;
  tw_on = tap_live && cal_pl >= 0 && gmem[CTRL_TWTRK] == cal_pl + 1;
  // Columns only advance while the transport runs, so stopping leaves the
  // last pass on screen to look at rather than scrolling it into silence.
  tw_run = tw_on && (play_state & 1);
  tw_on ? (
    tw_slice = max(16, floor(srate * 0.004));
    !tw_was ? (
      tw_sacc = 0;
      t = 0; loop(TAP_MAX, TW_ACC[t * 4] = 1; TW_ACC[t * 4 + 1] = -1;
                           TW_ACC[t * 4 + 2] = 0; TW_ACC[t * 4 + 3] = 0; t += 1; );
    );
    gmem[TW_HDR + 1] = TW_COLS;
    gmem[TW_HDR + 2] = tw_slice;
    gmem[TW_HDR + 3] = srate;
    gmem[TW_HDR + 4] = cal_pl + 1;
  );
  cal_play = (play_state & 1) == 1;

  // A new routing: tap N may be another plugin now, so no zero is kept.
  tap_gen != cal_gen_last ? (
    cal_gen_last = tap_gen;
    t = 0;
    loop(TAP_MAX,
      (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_HASCAL] = 0;
      (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_STALE] = 0;
      t += 1;
    );
  );

  // THE PRE PROBE runs the clock and makes the noise.
  cal_pre = role < 0.5 && cal_arm >= 0.5 && cal_slot >= 0;
  cal_pre ? (
    cal_hb = (cal_hb + 1) % 1000000;
    gmem[cal_slot + CS_PREHB] = cal_hb;
    cp = gmem[cal_slot + CS_POSTHB];
    cp != cal_post_last ? ( cal_post_last = cp; cal_post_age = 0; ) : cal_post_age += samplesblock;
    // a post probe on this track, measuring taps, with a reader alive
    cal_ready = cal_post_age < srate * 0.25 && gmem[cal_slot + CS_CFG] > 0 && hb_age < srate * 3;
    cal_play ? cal_was_playing = 1;
    // what arrived in the block just gone, at either probe
    cal_loud = cal_inpk > CAL_QUIET_PRE || gmem[cal_slot + CS_ABORT] > 0;
    (cal_loud || gmem[cal_slot + CS_POSTPK] > CAL_QUIET_POST) ? cal_quiet = 0 : cal_quiet += samplesblock;
    cal_inpk = 0;
    cal_phase > 0 ? (
      (cal_play || !cal_ready || cal_loud) ? (
        cal_phase = 0; cal_t = 0; cal_since = 0;    // the post throws the run away
      ) : (
        cal_t += samplesblock;
        cal_phase == 1 ? (
          cal_t >= CAL_LEN * srate ? ( cal_phase = 2; cal_t = 0; );
        ) : cal_phase == 2 ? (
          cal_t >= CAL_LEN * srate ? ( cal_phase = 3; cal_t = 0; );
        ) : (
          cal_t >= CAL_TAIL * srate ? ( cal_phase = 0; cal_t = 0; cal_since = 0; );
        );
      );
    ) : (
      cal_since += samplesblock;
      // after every stop; while stopped, when the post asks, now and then
      (!cal_play && cal_ready && cal_quiet >= CAL_WAIT * srate &&
       (cal_was_playing || (gmem[cal_slot + CS_REQ] > 0 && cal_since >= CAL_GAP * srate))) ? (
        cal_was_playing = 0;
        cal_phase = 1; cal_t = 0;
        kb0 = kb1 = kb2 = 0;
      );
    );
    gmem[cal_slot + CS_PHASE] = cal_phase;
  ) : (
    cal_phase = 0;
  );

  // THE POST PROBE follows it: silent while it runs, summing what the
  // taps see once each level has settled, and keeping the result if the
  // run got to the end.
  cal_post = tap_live && cal_slot >= 0;
  cal_post ? (
    cal_phb = (cal_phb + 1) % 1000000;
    gmem[cal_slot + CS_POSTHB] = cal_phb;
    // Only taps measuring gain reduction want a zero; levels-only taps don't.
    tap_ngr = 0; t = 0; loop(tap_cfg, tapIsGR(t) ? tap_ngr += 1; t += 1; );
    gmem[cal_slot + CS_CFG] = tap_ngr;
    gmem[cal_slot + CS_POSTPK] = cal_ppk;
    cp = gmem[cal_slot + CS_PREHB];
    cp != cal_pre_last ? ( cal_pre_last = cp; cal_pre_age = 0; ) : cal_pre_age += samplesblock;
    ph = (cal_pre_age < srate * 0.25 && !cal_play) ? gmem[cal_slot + CS_PHASE] : 0;
    // something real at the post probe mid-run (an instrument played while
    // stopped): stop, and let it be heard
    gmem[cal_slot + CS_ABORT] = (cal_ph > 0 && cal_ppk > CAL_LOUD) ? 1 : 0;
    gmem[cal_slot + CS_ABORT] > 0 ? ph = 0;
    cal_ppk = 0;
    ph != cal_ph ? (
      (cal_ph == 2 && ph == 3) ? (
        cal_ok = 0;
        t = 0; loop(tap_cfg, tapIsGR(t) ? cal_ok += calCommit(t); t += 1; );
        cal_ok > 0 ? (cal_fails = 0) : (cal_fails += 1);
      );
      ph == 1 ? calClear();
      cal_ph = ph; cal_pt = 0;
    ) : cal_pt += samplesblock;
    cal_mute = ph > 0;
    cal_acc = (ph == 1 || ph == 2) && cal_pt >= CAL_SETTLE * srate;
    cal_play ? cal_fails = 0;
    cal_req = 0;
    t = 0; loop(tap_cfg, (tapIsGR(t) && (calState(t) == 0 || calState(t) == 3)) ? cal_req = 1; t += 1; );
    gmem[cal_slot + CS_REQ] = (cal_req && cal_fails < 3) ? 1 : 0;
  ) : (
    cal_ph = 0; cal_mute = 0; cal_acc = 0;
  );

  // Where each tap's zero stands, for ChannelView and Track Analyser.
  (role >= 0.5 && role < 1.5) ? (
    c1 = tapIsGR(0) ? calState(0) : 0;
    c2 = tapIsGR(1) ? calState(1) : 0;
    c3 = tapIsGR(2) ? calState(2) : 0;
    c4 = tapIsGR(3) ? calState(3) : 0;
    (c1 != tap_cal1 || c2 != tap_cal2 || c3 != tap_cal3 || c4 != tap_cal4) ? (
      tap_cal1 = c1; tap_cal2 = c2; tap_cal3 = c3; tap_cal4 = c4;
      sliderchange(tap_cal1); sliderchange(tap_cal2);
      sliderchange(tap_cal3); sliderchange(tap_cal4);
    );
  );

@sample

  // The post probe, while the zero is measured: nothing out, and nothing
  // for its own analysis either -- but what came in is looked at first.
  cal_post ? (
    cal_ppk = max(cal_ppk, max(abs(spl0), abs(spl1)));
    cal_mute ? ( spl0 = 0; spl1 = 0; );
  );

  active ? (

    m = (spl0 + spl1) * 0.5;

    //-- the alignment delay ------------------------------------------
    //   Pre probe only. Without it, column N of one probe and column N of
    //   the other hold audio taken at different moments, and on a transient
    //   the ratio between them is not a measurement of anything. At one
    //   whole column of skew a silent gap in one ring lines up with a hit
    //   in the other and the trace stops being wrong and starts being
    //   nonsense.
    lagn > 0 ? (
      BUF_DLY[dpos] = m;
      dpos += 1; dpos > lagn ? dpos = 0;
      m = BUF_DLY[dpos];
    );

    //-- scope column -------------------------------------------------
    m < smin ? smin = m;
    m > smax ? smax = m;
    ssq += m * m;
    sacc += 1;

    //-- the gain-reduction filterbank --------------------------------
    //   Off unless the panel is drawing the measured trace. It is the only
    //   per-sample work in here that costs anything worth naming, and a
    //   probe on a track nobody is looking at should not be paying it.
    grbon ? (
      grb = 0;
      loop(GRB_N,
        grc = BUF_GRC + grb * 4;
        grs = BUF_GRS + grb * 4;
        gy = grc[0] * m + grs[0];
        grs[0] = grs[1] - grc[1] * gy;
        grs[1] = -grc[0] * m - grc[2] * gy;
        gz = grc[0] * gy + grs[2];
        grs[2] = grs[3] - grc[1] * gz;
        grs[3] = -grc[0] * gy - grc[2] * gz;
        BUF_GRQ[grb] += gz * gz;
        grb += 1;
      );
    );

    sacc >= slice ? (
      gmem[base + OFF_SCOPE + cur * 3 + 0] = smin;
      gmem[base + OFF_SCOPE + cur * 3 + 1] = smax;
      gmem[base + OFF_SCOPE + cur * 3 + 2] = sqrt(ssq / slice);
      grb = 0;
      loop(GRB_N,
        gmem[base + OFF_GRB + cur * GRB_N + grb] =
          grbon ? sqrt(BUF_GRQ[grb] / slice) : 0;
        BUF_GRQ[grb] = 0;
        grb += 1;
      );
      // Each tap's latest column, on the panel's own clock, for its traces.
      (tap_live && role >= 0.5 && role < 1.5) ? (
        t = 0;
        loop(tap_cfg,
          gmem[TAPTR_BASE + t * SCOPE_COLS + cur] =
            (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_LAST];
          t += 1;
        );
      );
      cur += 1;
      cur >= SCOPE_COLS ? cur = 0;
      gmem[base + H_CUR] = cur;
      smin = 1; smax = -1; ssq = 0; sacc = 0;
    );

    //-- spectrum -----------------------------------------------------
    BUF_ACC[fill] = m;
    fill += 1;

    fill >= fftsz ? (
      i = 0;
      loop(fftsz,
        BUF_FFT[i * 2]     = BUF_ACC[i] * BUF_WIN[i];
        BUF_FFT[i * 2 + 1] = 0;
        i += 1;
      );
      fft(BUF_FFT, fftsz);
      fft_permute(BUF_FFT, fftsz);

      // A Hann window has a coherent gain of 0.5, and REAPER's fft is
      // unnormalised, so a sine of amplitude A lands at A*fftsz/4.
      sc = 4 / fftsz;

      i = 0;
      loop(nbins,
        re = BUF_FFT[i * 2];
        im = BUF_FFT[i * 2 + 1];
        pw = re * re + im * im;
        mag = sqrt(pw) * sc;
        d = mag > 0.000000001 ? 20 * log10(mag) : -180;
        d > BUF_MAG[i] ? BUF_MAG[i] = d
                       : BUF_MAG[i] = d + (BUF_MAG[i] - d) * rel;
        // Measurement average: linear in POWER, no ballistics. Both probes
        // hit this on the same block with the same frame alignment, so the
        // difference between the two averages is the magnitude response
        // and nothing else.
        meas ? (
          live ? BUF_AVG[i] += (pw - BUF_AVG[i]) * avg_k
               : BUF_AVG[i] += pw;
        );
        i += 1;
      );

      // The average itself stays in BUF_AVG, which the band summary reads
      // a few lines down. Only the count is published, so the panel can
      // tell a running average from a cold one.
      meas ? ( avgn += 1; gmem[base + H_AVGN] = avgn; );

      //-- log-spaced band summary ------------------------------------
      anorm = live ? 1 : (avgn > 0 ? 1 / avgn : 0);
      scdb  = 20 * log10(sc);
      bi = 0;
      loop(BANDS,
        b0 = BUF_BEDGE[bi]; b1 = BUF_BEDGE[bi + 1];
        k0 = ceil(b0); k1 = floor(b1);
        dmax = -180; psum = 0; pn = 0;
        (k1 >= k0 && k0 >= 1 && k1 <= nbins - 1) ? (
          kk = k0;
          loop(k1 - k0 + 1,
            BUF_MAG[kk] > dmax ? dmax = BUF_MAG[kk];
            psum += BUF_AVG[kk]; pn += 1;
            kk += 1;
          );
        ) : (
          // Narrower than a bin, which below about a kilohertz is every
          // band. Interpolate rather than leaving a hole.
          bc = (b0 + b1) * 0.5;
          kk = floor(bc); tt = bc - kk;

          // THE LEFT EDGE, AND WHY IT WAS BLANK
          //   A band whose centre falls below bin 1 has no pair of bins to
          //   interpolate between, so this test failed and the band kept
          //   its -180 -- which the panel draws at the floor. That is the
          //   gap at the bottom of the display: 20 Hz to the first bin,
          //   about 23 Hz at 2048 points and 48 kHz.
          //
          //   Bin 1 is still the nearest thing that was actually measured,
          //   and the energy down there is real even though the transform
          //   cannot resolve where in the band it sits. So the value is
          //   HELD from bin 1 rather than dropped: the trace runs flat to
          //   the axis instead of falling into a hole. It is the same
          //   thing TS_Visualizer does by construction -- its axis starts
          //   at bin 1, so its leftmost pixel IS bin 1.
          //
          //   The TOP end is deliberately not treated this way. Above
          //   Nyquist there is no energy to represent, so a floor there is
          //   the truth and a held value would be an invention.
          kk < 1 ? ( kk = 1; tt = 0; );

          (kk >= 1 && kk <= nbins - 2) ? (
            dmax = BUF_MAG[kk] + (BUF_MAG[kk + 1] - BUF_MAG[kk]) * tt;
            psum = BUF_AVG[kk] + (BUF_AVG[kk + 1] - BUF_AVG[kk]) * tt;
            pn = 1;
          );
        );
        gmem[base + OFF_BAND + bi * 4] = dmax;
        // Mirrored into the Visualizer's slot, verbatim, same band index --
        // TS_Visualizer.lua's read_folder_overlay_bands() reads this slot
        // layout directly, so band bi means the same frequency range on
        // both sides of the bridge.
        vis_active ? gmem[vbase + VIS_OFF_BAND + bi] = dmax;
        // Whether this band has a value at all. With the left edge held
        // from bin 1 the only bands that fail this now are the ones above
        // Nyquist, where a floor is the truth. A band with no value is
        // kept out of the response smoothing below, so two floors cannot
        // average a false zero into their neighbours -- which is what put
        // a little hook on the bottom of the high-pass.
        BUF_BV[bi] = pn > 0 ? 1 : 0;
        pwb = pn > 0 ? psum / pn * anorm : 0;
        BUF_BA[bi] = pwb > 0.000000000000000001 ? 10 * log10(pwb) + scdb : -240;
        gmem[base + OFF_BAND + bi * 4 + 1] = BUF_BA[bi];
        bi += 1;
      );

      //-- the response, computed by the POST probe -------------------
      // Within a block REAPER runs the whole of the pre probe before the
      // whole of the post probe, and both FFTs fire on the same sample
      // index because they restart together on the epoch. So by the time
      // this runs the pre probe has already published this frame's bands.
      // ROLE 1 ONLY. The response is this track's post minus this
      // track's pre; a comparison probe lives on a different track, where
      // PRE_BASE holds somebody else's audio entirely, and subtracting
      // that would be meaningless rather than merely wrong.
      (role >= 0.5 && role < 1.5 && meas) ? (
        pmax = -400;
        bi = 0;
        loop(BANDS,
          pv = gmem[PRE_BASE + OFF_BAND + bi * 4 + 1];
          pv > pmax ? pmax = pv;
          bi += 1;
        );
        bi = 0;
        loop(BANDS,
          pv = gmem[PRE_BASE + OFF_BAND + bi * 4 + 1];
          BUF_BR[bi] = BUF_BA[bi] - pv;
          // How far below the loudest band this one's excitation sits. The
          // panel gates on that rather than on an absolute level, so the
          // curve does not vanish when the track is quiet.
          gmem[base + OFF_BAND + bi * 4 + 3] = pv - pmax;
          bi += 1;
        );
        // SMOOTHING ACROSS FREQUENCY, IN OCTAVES
        //
        // The grid is uniform in LOG frequency, which is what makes this
        // easy: a fixed number of points is a fixed fraction of an octave
        // everywhere. 256 points across three decades is 25.7 per octave,
        // so the window in points follows straight from the width asked
        // for, and one setting behaves the same at 40 Hz as at 10 kHz.
        //
        // Two box passes rather than one, which gives a triangular window
        // -- smooth, where a single box leaves corners. Bands with no data
        // are excluded rather than averaged in, so the empty region below
        // the first bin cannot pull its neighbours toward zero.
        hw = floor(smoo_oct * (BANDS / (log(BAND_HI / BAND_LO) / log(2))) * 0.5 + 0.5);
        hw = max(0, min(64, hw));
        hw > 0 ? (
          sp = 0;
          loop(2,
            bi = 0;
            loop(BANDS,
              ba = max(0, bi - hw); bb = min(BANDS - 1, bi + hw);
              acc = 0; cnt = 0;
              kk = ba;
              loop(bb - ba + 1,
                BUF_BV[kk] > 0.5 ? ( acc += BUF_BR[kk]; cnt += 1; );
                kk += 1;
              );
              BUF_BT[bi] = cnt > 0 ? acc / cnt : BUF_BR[bi];
              bi += 1;
            );
            bi = 0; loop(BANDS, BUF_BR[bi] = BUF_BT[bi]; bi += 1; );
            sp += 1;
          );
        );
        bi = 0;
        loop(BANDS,
          gmem[base + OFF_BAND + bi * 4 + 2] = BUF_BR[bi];
          bi += 1;
        );
      );

      // Published last, and only once everything above is in place: the
      // panel treats a change here as "a complete new frame is ready".
      seq += 1;
      gmem[base + H_SEQ] = seq;
      vis_active ? ( vis_seq += 1; gmem[vbase + VIS_H_SEQ] = vis_seq; );

      memcpy(BUF_ACC, BUF_ACC + hop, hop);
      fill = hop;
    );
  );

  //-- the taps -----------------------------------------------------------
  tap_live ? (
    // Levels, every tap -- falling away while the zero is measured, so
    // the test noise never shows on a meter.
    cal_mute ? (
      t = 0; loop(tap_cfg, tapLevels(t, 0, 0, 0, 0); t += 1; );
    ) : (
      tapLevels(0, spl2, spl3, spl4, spl5);
      tap_cfg >= 2 ? tapLevels(1, spl6, spl7, spl8, spl9);
      tap_cfg >= 3 ? tapLevels(2, spl10, spl11, spl12, spl13);
      tap_cfg >= 4 ? tapLevels(3, spl14, spl15, spl16, spl17);
    );
    // Gain reduction, only for the taps measuring it.
    tapIsGR(0) ? tapSample(0, (spl2 + spl3) * 0.5, (spl4 + spl5) * 0.5);
    tapIsGR(1) ? tapSample(1, (spl6 + spl7) * 0.5, (spl8 + spl9) * 0.5);
    tapIsGR(2) ? tapSample(2, (spl10 + spl11) * 0.5, (spl12 + spl13) * 0.5);
    tapIsGR(3) ? tapSample(3, (spl14 + spl15) * 0.5, (spl16 + spl17) * 0.5);
    tap_sacc += 1;
    tap_sacc >= tap_slice ? (
      tap_sacc = 0;
      t = 0; loop(tap_cfg, tapIsGR(t) ? tapColumn(t); t += 1; );
    );

    // Per-plugin waveforms (PER-PLUGIN WAVEFORMS). Tap t's before pair is
    // channels 2+4t/3+4t, its after pair 4+4t/5+4t, 0-based.
    tw_run ? (
      tw_t = 0;
      loop(tap_cfg,
        tw_a = TW_ACC + tw_t * 4;
        cal_mute ? ( tw_o = 0; tw_i = 0; ) : (
          tw_o = (spl(4 + tw_t * 4) + spl(5 + tw_t * 4)) * 0.5;
          tw_i = max(abs(spl(2 + tw_t * 4)), abs(spl(3 + tw_t * 4)));
        );
        tw_o < tw_a[0] ? tw_a[0] = tw_o;
        tw_o > tw_a[1] ? tw_a[1] = tw_o;
        tw_i > tw_a[2] ? tw_a[2] = tw_i;
        tapIsGR(tw_t) ? (
          tw_g = (TAP_BASE + tw_t * TAP_STRIDE + TAP_S)[TS_LAST];
          tw_g > tw_a[3] ? tw_a[3] = tw_g;
        );
        tw_t += 1;
      );
      tw_sacc += 1;
      tw_sacc >= tw_slice ? (
        tw_sacc = 0;
        tw_t = 0;
        loop(TAP_MAX,
          tw_a = TW_ACC + tw_t * 4;
          tw_b = TW_BASE + (tw_t * TW_COLS + tw_cur) * 4;
          tw_t < tap_cfg ? (
            gmem[tw_b] = (tw_a[0] <= tw_a[1] ? tw_a[0] : 0);
            gmem[tw_b + 1] = (tw_a[0] <= tw_a[1] ? tw_a[1] : 0);
            gmem[tw_b + 2] = tw_a[2];
            gmem[tw_b + 3] = tw_a[3];
          ) : (
            gmem[tw_b] = 0; gmem[tw_b + 1] = 0; gmem[tw_b + 2] = 0; gmem[tw_b + 3] = 0;
          );
          tw_a[0] = 1; tw_a[1] = -1; tw_a[2] = 0; tw_a[3] = 0;
          tw_t += 1;
        );
        gmem[TW_HDR] = tw_cur;
        tw_cur += 1; tw_cur >= TW_COLS ? tw_cur = 0;
        tw_n += 1; gmem[TW_HDR + 5] = tw_n;
      );
    );
  );

  // The pre probe, while the zero is measured: the input is looked at
  // (it must stay silent), then the test noise goes in, after its own
  // analysis has seen the input as it was. Pink: Paul Kellet's economy
  // filter on white noise.
  cal_pre ? (
    cal_inpk = max(cal_inpk, max(abs(spl0), abs(spl1)));
    (cal_phase == 1 || cal_phase == 2) ? (
      cal_w = rand(2) - 1;
      kb0 = 0.99765 * kb0 + cal_w * 0.0990460;
      kb1 = 0.96300 * kb1 + cal_w * 0.2965164;
      kb2 = 0.57000 * kb2 + cal_w * 1.0526913;
      cal_w = (kb0 + kb1 + kb2 + cal_w * 0.1848) * (cal_phase == 1 ? CAL_GA : CAL_GB);
      spl0 += cal_w; spl1 += cal_w;
    );
  );
