desc:- TS_TrackProbe -
version: 2.8.0
author: Tim Shadgett
// @noindex
// Ships as part of the Track Analyser package (its @provides lists this
// file as [effect]); it is not a package to install on its own.
// MIT licence -- see LICENSE in the TS-ReaScripts repository.
//========================================================================
// One JSFX, two jobs. Put a copy either side of InfiniStrip inside an FX
// container and the panel gets both the untouched signal and the processed
// one, from the same audio thread, on the same block boundaries.
//
// It does not alter the audio. It reads it.
//
// NO PARAMETERS
//   Everything ChannelView, Track Analyser and the Visualizer tell a
//   probe -- which one it is, whether to publish, the taps' latencies --
//   and everything it tells them back goes through gmem, in a block per
//   track (THE PROBE BLOCK below), not sliders. A hidden slider is still
//   a REAPER parameter: it sits in every automation and learn list, and
//   each write makes it REAPER's "last touched", so last-touched tools
//   would land on it instead of what you had just moved. REAPER sees
//   only its own Bypass, Wet and Delta.
//
//   WHICH PROBE IS WHICH. A probe finds its track and its place in the
//   chain with get_host_placement(). The scripts write, into the track's
//   block, the place of the probe that is "pre" and the one that is
//   "post" (the first and the second of a pair); each probe compares its
//   own place with them. A probe nobody has named does nothing. The
//   panel never inserts or removes anything to arm a pair: it writes
//   the block, and an idle pair costs a branch per sample.
//
//   NOTHING TO SET BY HAND. Spectrum release is Track Analyser's setting
//   (CTRL_REL), and "Include in Visualizer" is kept on the track by
//   ChannelView and the Visualizer. The plugin's window just says what
//   it is doing.
//
// gmem namespace TS_TA_Mem, shared with the measurement tools.
//   0  - 19    TS_TA_Cal        (calibration rig -- do not reuse)
//   20 - 23    TS_TA_WaveProbe  (reserved, unused)
//   64 - 95    control, panel -> probes
//   0x10000    PRE  block
//   0x20000    POST block
//   0x30000    COMPARISON block -- the post probe of the track the panel
//              is comparing against, for the masking overlay
//   0x40000    Visualizer slots, + slot*2048
//   0x4F000    tap header, 0x50000 tap traces (PER-PLUGIN GAIN REDUCTION)
//   0x54000    per-tap waveforms, 0x5C000 their header (PER-PLUGIN WAVEFORMS)
//   0x60000    measuring the taps' zero, + track index * 8 (THE ZERO POINT)
//   0x70000    third-octave reduction, + track index * 128
//   0x100000   THE PROBE BLOCK, + (track index + 1) * 128 (the master is 0)
//   0x310000   tap traces for taps 5..8 (its address at 0x4F000 + 9)
//   0x318000   per-tap waveforms for taps 5..8 (its address at 0x5C000 + 7)
//   0x340000   one tap's stereo scope (STEREO, ONE TAP)
//   0x350000   each tap's levels per channel, + (track index + 1) * 64
//              (LEVELS PER CHANNEL)
//   0x3A0000   each track's spectrum for ChannelView, + (track index + 1)
//              * 272 (A SPECTRUM PER TRACK)
//   0x4C0000   where a probe that isn't publishing writes its block, so
//              it never lands on the one Track Analyser reads
//   0x4E0000   each track's ERB bands and left / right levels for
//              ChannelView's Collisions, + (track index + 1) * 64
//              (COLLISIONS)
//   73         tap heartbeat, bumped by any reader
//   74         which track's post probe writes the per-tap waveforms
//   75         spectrum release, ms (0: 400)
//   77         which track writes the stereo scope (index + 2; 0 none)
//   78         moving while ChannelView is learning a plugin: no zero is
//              measured meanwhile (THE ZERO POINT)
//
// THE PROBE BLOCK, at 0x100000 + (track index + 1) * 128.
//   The scripts write:
//     0  the pre probe's place + 1 (get_host_placement's chain_pos; 0 none)
//     1  the post probe's place + 1
//     2  publish, pre probe        3  publish, post probe
//     4  1: the post probe is the comparison (Track Analyser's masking)
//     5  Visualizer slot + 1, pre  6  Visualizer slot + 1, post (0 none)
//     7  moving while the track is on screen (ONLY THE TRACKS ON SCREEN)
//     8  tap_n         9..12  tap_lag1..4     13..16  tap_rst1..4
//    17  tap_gen      18  cal_arm (pre)      19  tap_nogr
//    20  tap_mb       21..23  tap_mbx1..3    24  tap_fine
//    25  tap_st (the stereo tap, 1..8; 0 none)
//    26..29  tap_mug1..4   30..31  tap_mbmug1..2 (MAKE-UP GAIN, FOLLOWED)
//    50..53  tap_lag5..8   54..57  tap_rst5..8
//    58..61  tap_mug5..8   62..63  tap_mbmug3..4
//   The probes write:
//    32  the pre probe's block count     33  the post probe's (a probe
//        that has recognised itself; a script sees a pair come alive)
//    34..49  every probe on the track, recognised or not: [34 + k] its
//        place + 1, [42 + k] its block count, k = (place + 1) mod 8
//    64..67  tap_gr1..4      68..71  tap_cal1..4
//    72..75  tap_inpk1..4    76..79  tap_outpk1..4
//    80..83  tap_inrms1..4   84..87  tap_outrms1..4
//    88..91  tap_mbgr1..4    92..95  tap_mbl1..4
//    96  counts the post probe's writes of the above
//    97..100  tap_gr5..8     101..104  tap_cal5..8
//    105..108  tap_inpk5..8  109..112  tap_outpk5..8
//    113..116  tap_inrms5..8 117..120  tap_outrms5..8
//    121  how many plugins this probe can measure (8; nothing from older ones: 4)
//    122  the stereo tap's correlation   123..124  its mid and side (dBFS, RMS)
//    125  1: this probe measures stereo (nothing from older ones)
//    126  1: this probe follows make-up gain (nothing from older ones)
//   The scripts write:
//    127  moving while ChannelView shows this track's spectrum (A
//         SPECTRUM PER TRACK)
//   Taps 5..8 sit apart from 1..4 so that a script or probe that knows
//   only four finds 1..4 where it expects them. The names are those of
//   the readings; the probe keeps them in TV_* (one per tap).
//
// INPUT AND OUTPUT LEVELS, PER TAP
//   The same two copies a tap measures gain reduction from are also the
//   plugin's input and output, so their levels are kept too: peak (falling
//   20 dB/s, so a reader polling at frame rate still catches a transient)
//   and true RMS (300 ms), both channels, published in dBFS about thirty
//   times a second on tap_inpkN / tap_outpkN / tap_inrmsN / tap_outrmsN.
//   ChannelView draws them as a plugin's input and output meters.
//
//   A tap can be laid for levels alone (tap_nogr, a bit per tap, set by
//   ChannelView): a plugin that reports its own gain reduction but whose
//   levels you want. Such a tap skips the filterbank entirely -- levels
//   cost a few operations a sample -- and takes no part in the zero
//   measurement. While the zero is being measured the levels fall away
//   rather than show the test noise.
//
// LEVELS PER CHANNEL
//   Each tap's levels, left and right apart, for ChannelView's stereo VU
//   meters: at 0x350000 + (track index + 1) * 64 + tap * 8, [0..3] the
//   peaks (input L, R, output L, R), [4..7] the RMS the same way, in dBFS,
//   published with the others. Tracks to index 2999 (the region stops
//   short of 0x380000, ChannelView's Learn).
//
// STEREO, ONE TAP
//   For ChannelView's Width visualiser: the output of the tap named by
//   tap_st, its correlation (-1..+1) and its mid and side levels, over the
//   same 300 ms as the RMS levels, published with them. And a scope: its
//   last 512 samples (taken at about 24 kHz), L and R, oldest first, at
//   0x340010 -- [0x340000] counts the frames, [+1] the points, [+2] the
//   writer (track index + 2). One track writes it, the one ChannelView
//   names in gmem[77].
//
// PER-PLUGIN WAVEFORMS
//   For ChannelView's expanded gain-reduction panel: each tapped plugin's
//   output waveform (min and max), its input peak, and -- for a tap that
//   measures it -- its gain reduction, one column every 4 ms, 2048 columns
//   (8.2 s) per tap, advancing only while the transport runs. On a clock of their own, not the scope's: the scope
//   only runs while Track Analyser publishes this track, and the panel
//   must work without it.
//   The region is shared by every probe in the project, so ONE track
//   writes it: the one whose index + 1 ChannelView puts in gmem[74], and
//   only while the tap heartbeat (73) is alive. 0 there and nobody writes.
//     0x5C000  [0] newest column  [1] columns  [2] samples per column
//              [3] sample rate    [4] writer (track index + 1)
//              [5] columns written, ever (a reader spots a stalled writer)
//              [6] taps in use (older probes leave it 0: read four)
//              [7] where taps 5..8 are (older probes leave it 0: 0x208000)
//     0x54000 + (tap * 2048 + column) * 4 for taps 1..4, and
//     0x318000 + ((tap - 4) * 2048 + column) * 4 for taps 5..8 (0-based tap):
//              [0] output min  [1] output max  [2] input peak  [3] GR dB

// Control block (the panel writes these; 0 means "use my default"):
//   64  epoch      bump to make both probes restart in step
//   65  fft size   power of two, 256 .. 4096
//   66  slice      samples per scope column
//   67  heartbeat  panel is alive
//   68  measure    1 = accumulate a linear power average for measurement
//
// MEASURING A PLUGIN WITH TWO PROBES
//   Both probes live in the same audio thread, take the same FFT size, and
//   restart together on the epoch, so their frames are sample-aligned. The
//   difference between their averaged spectra is therefore the magnitude
//   response of whatever sits between them -- the whole curve at 1024
//   points, from one capture, instead of a stepped tone sweep.
//
//   That matters for narrow features. A Q 20 bell at 632 Hz is about
//   0.036 octaves wide; a tone sweep stepping 0.23 octaves can miss the
//   peak entirely. Bin spacing here is about 0.001 octaves there.
//
//   The source never has to be spectrally flat: any colour in it cancels in
//   the ratio between the two probes. What does NOT cancel is
//   non-linearity, so a reading taken through heavy saturation describes
//   the saturation as much as the filter.
//
// Probe block, relative to its base:
//    0  seq            increments on every publication -- the panel waits
//                      for this to advance rather than sampling on a clock
//    3  srate
//    4  nbins
//    5  fft size
//    6  slice
//    7  epoch ack
//    8  scope cursor   next column to be written
//    9  scope columns
//   10  block counter  heartbeat, panel uses it to spot a dead probe
//   11  role           0 pre, 1 post, 2 comparison
//   12  channels
//   15  average count  frames in the measurement average, 0 when not measuring
// 4096  + col*3 + 0            scope minimum
// 4096  + col*3 + 1            scope maximum
// 4096  + col*3 + 2            scope RMS
// 16384 + band*4 + 0           display level, dB, ballistic
// 16384 + band*4 + 1           band average, dB, mean power
// 16384 + band*4 + 2           response, dB          (post probe only)
// 16384 + band*4 + 3           excitation, dB <= 0   (post probe only)
//
// SLOTS 1, 2, 13 AND 14 ARE RESERVED, NOT PUBLISHED. Named here so
// nothing else claims them.
//
// "INCLUDE IN VISUALIZER SPECTRUM" (vis_include / vis_slot)
//   TS_Visualizer's Spectrum panel can colour its peaks by whichever
//   watched track is loudest at that frequency. This plugin's
//   Pre/Post/Comparison addressing has room for at most two tracks
//   project-wide -- fine for Track Analyser's own panel, not for several
//   tracks watched at once -- so the Visualizer gets a second,
//   independent publishing path out of the SAME probe, and nothing extra
//   needs inserting.
//
//   A TS_TrackProbe pair ships baked into every track template, so EVERY
//   track has one, almost always idle, and "has the plugin" can't be what
//   makes a track selectable in the Visualizer's picker or the list would
//   be the whole project. Whether a track is included is kept on the
//   track by ChannelView and the Visualizer, independent of this track's
//   own Publish, so leaving Track Analyser's panel pointed elsewhere
//   doesn't drop a track out of the Visualizer.
//
//   vis_slot is TS_Visualizer's claim, read from the probe block (0..15,
//   or -1 for "not watching this one"): a slot at 0x40000 + slot*2048.
//   vis_include just means "has a slot". Nothing is published under this
//   track's identity until the Visualizer's picker selects it and hands
//   back a slot.
//
//   Whichever band data this probe already has -- this instance's own
//   role, Pre or Post or Comparison, whatever track it is physically on --
//   is what gets copied out. There's no re-analysis: the FFT and the
//   per-band ballistic level (field 0 of the block below) already exist
//   for Track Analyser's own use; this just mirrors that same number into
//   a simpler one-field-per-band layout at the claimed slot, once
//   vis_include and a claimed slot both hold.
//
// PER-PLUGIN GAIN REDUCTION: THE TAPS
//   Everything above measures the span between the two probes as one
//   thing. That cannot tell two compressors apart, and it cannot give a
//   compressor that doesn't report its gain reduction a meter of its own.
//   The taps can. For each plugin being measured (up to four), ChannelView
//   routes two extra stereo pairs to the POST probe: a copy of the signal
//   going into that plugin (written by whatever plugin sits in front of
//   it) and a copy of what comes out. Those arrive here on pins 3..18.
//   Nothing is inserted next to the plugin; the pairs just ride along on
//   spare track channels.
//
//   Each tap runs the same idea as the span's measured trace, but on its
//   own plugin only:
//     * the "before" signal is delayed by that plugin's reported latency
//       (tap_lagN, written by ChannelView), so both sides line up
//     * both are split into ten bands, a column every 2 ms (THE TEN
//       BANDS, BY FFT below)
//     * per band, the ratio after/before, smoothed. A static EQ inside the
//       plugin is a constant per band; make-up gain is a constant in every
//       band; compression moves every band together
//     * each band keeps a BASELINE: the highest ratio it has seen, sinking
//       at 0.1 dB/s. Reduction is how far below its baseline a band sits,
//       and the tap's reading is the MEDIAN across bands, so one band
//       doing something odd cannot drag the number.
//
//   The baseline is the zero point, and it is the part that can be wrong:
//   learnt from the music, it is the least-compressed moment the plugin
//   has shown, and a compressor that never lets go reads low -- by how
//   much it never releases. So the baseline is only the fallback. The
//   real zero is MEASURED, while playback is stopped:
//
// THE TEN BANDS, BY FFT
//   Each tap keeps its last ~85 ms of both copies, "before" and "after"
//   packed as one complex signal, and splits them with REAPER's own FFT
//   at three sizes, each band taken from the smallest that gives it at
//   least three bins: 256 points every column for the top bands, 1024
//   every second column for the middle, 4096 every eighth for the lowest
//   (all doubled at 88.2/96 kHz, and again at 176.4/192). One complex FFT
//   gives both copies' spectra; a band's power is its bins' power, as a
//   mean square. Between its FFTs a band holds its last value. Much
//   cheaper than ten bandpass filters a sample on each copy, and the
//   lows answer a little slower (their window is longer).
//
// A MULTIBAND COMPRESSOR, BAND BY BAND
//   A multiband plugin reports one reduction to REAPER, if any. Its tap
//   already measures every filterbank band on its own, so ChannelView can
//   ask for the bands grouped at the plugin's crossovers: tap_mb names the
//   tap (1..4, 0 none), tap_mbx1..3 the crossovers in Hz (0 unused, so 2
//   to 4 bands), and each band's reduction comes out on tap_mbgr1..4 --
//   the median of the filterbank bands whose centres fall inside it (the
//   one nearest its middle when none do), with the same zero, smoothing
//   and fall as the tap's own reading. One multiband tap per probe.
//   Each band's INPUT level comes out too, on tap_mbl1..4:
//   the filterbank bands' power inside it on the way in, a 2 ms mean
//   square scaled so a sine reads its peak, falling 20 dB/s. It needs
//   no zero and no alignment, so it can be trusted where the per-band
//   reduction can't; ChannelView draws it against each band's threshold.
//
// THIRD-OCTAVE REDUCTION, FOR ONE TAP
//   The ten-band filterbank is for one number, fast. For a picture of
//   WHERE a plugin reduces -- a bus compressor pulling the lows harder
//   than the top, a de-esser's band, a dynamic EQ's moving bands -- one
//   tap at a time can also be measured in third-octaves (25 Hz to 20 kHz,
//   the standard centres): tap_fine names the tap (1..4, 0 none), and only
//   that tap pays for it. Both copies go through an 8192-point FFT every
//   1024 samples (about 170 ms of audio, so the lows answer slower than
//   the meter -- it's for watching, not for metering), the bins summed
//   into each third-octave, after/before per band. The zero is the same
//   idea as the taps': measured while stopped from the same pink noise,
//   the music's baseline until then. Out on gmem at 0x70000 + track index
//   * 128: [0] a count that moves with every frame, [1] bands, [2] the
//   tap, [3] 1 when the zero is measured, [4] sample rate; per band b
//   (centre 1000 * 2^((b - 16) / 3) Hz): [8 + b] how far it sits from its
//   zero, dB (below 0 is reduction, -999 no signal), [72 + b] the level
//   going in, dBFS. A third of the cost of the tap's filterbank.
//
// A SPECTRUM PER TRACK
//   Track Analyser's spectrum is one track's at a time (Publish), in the
//   PRE / POST blocks. ChannelView shows spectra behind its EQ canvases
//   on any track it has on screen at once: channel view, the rack, its
//   pop-outs. While block field 127 keeps moving (written by whatever
//   draws that track's EQ canvas), the post probe runs its spectrum and
//   writes it at 0x3A0000 + (track index + 1) * 272: [0] a count that
//   moves with every frame, [1] bands (256), [2] lowest and [3] highest
//   frequency, [4] FFT size, [5] the track index + 2 (who wrote it), and
//   from [16] each band's level, dB, as Track Analyser's band field 0.
//   Tracks to index 4094. A second without field 127 moving and it stops.
//
//   A probe running its spectrum for the Visualizer or for ChannelView,
//   but not for Track Analyser, writes its own block at 0x4C0000 rather
//   than over the PRE / POST block Track Analyser is reading.
//
// COLLISIONS
//   ChannelView marks, on its track list, the tracks that cover the one
//   in view, and how much of the time. The spectrum above is a display
//   level (instant attack, a slow release), which would make a kick look
//   as if it never stops; this is each frame as it is. While A SPECTRUM
//   PER TRACK runs, the post probe also writes, at 0x4E0000 + (track
//   index + 1) * 64: [0] a count that moves with every frame, [1] bands,
//   [2] lowest and [3] highest frequency, [4] the left and [5] the right
//   channel's level since the last frame (dB, mean square), [6] the track
//   index + 2 (who wrote it), and from [8] each band's power this frame
//   (dB, mean square, a sine of amplitude 1 at -3). The bands are
//   equivalent rectangular bandwidths (Glasberg & Moore), one each from
//   20 Hz to 20 kHz: the grid ChannelView's masking model works on, so
//   nothing has to be regrouped there. A band narrower than a bin (the
//   lowest) takes the nearest bin's density times its width.
//
// LISTENING TO A BAND
//   The same place, written by ChannelView: [6] a frequency (Hz), [7] a
//   Q, [8] a count that moves while someone listens, [9] what's heard:
//   0 the band about the frequency (a band-pass, two sections, of that
//   Q), 1 below it (a low-pass), 2 above it (a high-pass). While [8]
//   moves and [6] is above 0, the post probe's output is that alone,
//   faded in and out over 10 ms; a quarter of a second without [8]
//   moving and it lets go. Its own analysis is of the audio before.
//
// MAKE-UP GAIN, FOLLOWED
//   A plugin's make-up (or output) gain moves every band's after/before
//   ratio by the same amount, and would read as reduction, or hide it.
//   ChannelView writes each tap's make-up in dB (tap_mugN) as it is now,
//   automation included, and the probe takes it out of every ratio before
//   anything else sees it: the smoothing, the music's baseline, the
//   measured zero, the third-octaves. So the zero holds through any
//   make-up change. A multiband tap (tap_mb) also has each of its split
//   bands' own gain (tap_mbmug1..4), taken out of the filterbank bands
//   inside it.
//
//   Each is written as dB + 1000 * a count (0..99). A make-up that moves
//   with the count unchanged is the plugin's make-up moving: the audio
//   moved with it. A new count says only what is taken out changed (the
//   script started, or another control is the make-up now), not the
//   audio: what the probe has learnt and measured is moved by the same
//   amount, so the reading doesn't jump. A new multiband split
//   (tap_mb, tap_mbx) counts the same way. This is kept up while the
//   zero is being measured too: a zero measured before anything has
//   played is already in the make-up as it is.
//
//   The make-up is written at the script's frame rate, so it can arrive a
//   frame after the audio changed. A ratio climbing in that frame would
//   lift the music's baseline, which only sinks 0.1 dB/s; so when a tap's
//   make-up moves, each band's baseline goes back to what it was a
//   little before (TS_BSB, kept every 32 columns), if that was lower --
//   or, learnt only since then, is learnt again.
//
//   When a tap has no zero yet, or its plugin has been touched since, the
//   pre probe feeds a quiet test signal into the chain while stopped --
//   pink noise, one second at -60 dBFS and one at -50 -- and the post
//   probe silences its own output while it does, so nothing is heard and
//   Track Analyser sees nothing. Once per change, not at every stop. Quiet enough that no
//   compressor set for music is working on it, so what each tap sees then
//   -- every band's after/before ratio -- is the plugin with NO reduction:
//   its make-up, its static EQ, its saturation's small-signal gain. That
//   is the zero. While playing, reduction is how far each band sits below
//   it, median across bands.
//
//   Each band keeps the higher of the two levels' ratios, so a compressor
//   still recovering from the music, or a gate shut on the quieter level,
//   doesn't drag the zero down. When the two disagree by more than 1 dB
//   the plugin was level-dependent even down there, and tap_calN says so.
//
//   It waits for a second of silence at both probes first (the music's
//   end, and the compressor's release, have to clear), stops the moment
//   playback starts or anything arrives at either probe, and is only done
//   for a pre probe ChannelView has armed (cal_arm: not on a track armed
//   to record) and never while gmem[78] moves (ChannelView learning a
//   plugin). A run interrupted keeps the zero there was, and is tried
//   again five seconds on; three tries that don't finish, and it waits
//   for play. At the post probe, "anything arriving" is a peak over
//   -12 dBFS that's also well over what the test signal should reach
//   there (a chain with a lot of gain lifts the noise itself that far).
//   The zero survives play and stop: ext_noinit is set, so REAPER
//   doesn't re-zero this plugin's memory on every transport change,
//   which it otherwise does.
//
//   tap_calN, read-only: 0 never measured (the music baseline is in use),
//   1 measured, 2 measured but the plugin was level-dependent at the test
//   level, 3 measured but the plugin has been touched since -- a make-up
//   change moves the zero, and it is measured again. 4: shut on the test
//   signal (cut CAL_SHUT dB or more in every band, or to nothing), so no
//   zero: the music baseline is in use. 5: that, and seen open on the
//   music since (GATE_OPEN over its shut level): a gate or expander for
//   certain. With nothing coming in, a gate's reading holds at its closed
//   level -- its shut level under the music's baseline -- where any other
//   plugin's falls to 0. A touch
//   (tap_rstN) also resets the music baseline. A new routing
//   (tap_gen bumped by ChannelView) forgets every zero: tap 1 may be a
//   different plugin now.
//
//   The two probes talk through gmem at CAL_BASE + track index * 8, the
//   track index from get_host_placement(). Needs REAPER's "Run FX when
//   stopped" (on by default).
//
// THE ZERO, KEPT ON THE MUSIC
//   A measured zero holds until playback stops again, but a gain inside
//   the plugin that nothing follows (a second output knob, a change made
//   in the plugin's own window) moves what "no reduction" is meanwhile.
//   So while playing, the zero is checked against the music, in STEADY
//   STRETCHES: 80 ms (Q_COLS) where the median across bands of each
//   band's ratio over its zero wanders less than Q_SPAN. A release still
//   running drifts more than that, so it never counts.
//     * A stretch sitting OVER the zero by more than Q_TOL can't be
//       reduction: the plugin's gain went up. The zero moves Q_STEP of
//       the way to it, touched or not.
//     * Under the zero is either the gain coming down or a compressor
//       that never lets go, and the music can't tell which. Untouched,
//       the zero holds. Touched since it was measured (tap_calN 3), a
//       QUIET stretch (the input Q_QUIET under its falling peak) moves
//       it back to where quiet stretches sat before the touch (TS_QR,
//       learnt from them while untouched): a gain change moves them by
//       the change, a threshold moved on a compressor that never lets
//       go hardly at all. With no such place learnt yet, it holds.
//     * Touched, after the music moved it up: when for Q_WIN even the
//       highest steady stretch no louder than the one that moved it up
//       sits under where that one was put, the gain came back down, and
//       it goes back -- never below the measured zero (a gain raised,
//       then lowered: a plugin whose output knob isn't followed).
//   While a followed make-up moves, and for Q_MUGHOLD after, none of it:
//   the plugin's gain and ChannelView's word of it don't arrive together,
//   and a knob turned steadily keeps the two a steady distance apart. Nor
//   while it sits more than Q_MUGDROP under where it was when the zero was
//   measured: a knob turned that far down is where its dB is least sure.
//   The next stopped measurement replaces it all.
//
//   The reading comes out on tap_grN, in the track's probe block, so a
//   script can read any track's taps without arming anything, every
//   track at once. While Track Analyser has this
//   track armed, each tap's per-column reduction also goes to gmem at
//   TAPTR_BASE on the panel's own column clock, for its traces.
//
//   The taps only run while a reader is alive: something must keep
//   changing gmem[73] (ChannelView and Track Analyser both do). With
//   neither open they cost nothing.
//
//   ONLY THE TRACKS ON SCREEN. A reader that says which tracks it shows
//   keeps gmem[76] moving, and bumps PB_WATCH (7) in each of those
//   tracks' blocks. While it does, a post probe measures only if its own
//   track's PB_WATCH moved in the last second (or Track Analyser is
//   publishing it); otherwise it skips the filterbank and the levels and
//   reads 0. The zero is still measured at every stop, on every track,
//   so a track comes on screen already zeroed. With no such reader
//   (gmem[76] still for three seconds) every track measures.
//
//   The tap pins are INPUTS ONLY. The copies carry on along their spare
//   channels after this probe; ChannelView picks channels that nothing
//   after the probe uses and that a parent track has too few channels to
//   receive. Declaring outputs to silence them would be tidier, but a
//   probe saved in a project can come back with those output pins
//   mapped and their inputs not -- and then it would write silence over
//   channels 3/4 on every track, sidechains included.
//========================================================================

options:gmem=TS_TA_Mem

// No sliders: see NO PARAMETERS and THE PROBE BLOCK above.

in_pin:left
in_pin:right
in_pin:tap 1 before L
in_pin:tap 1 before R
in_pin:tap 1 after L
in_pin:tap 1 after R
in_pin:tap 2 before L
in_pin:tap 2 before R
in_pin:tap 2 after L
in_pin:tap 2 after R
in_pin:tap 3 before L
in_pin:tap 3 before R
in_pin:tap 3 after L
in_pin:tap 3 after R
in_pin:tap 4 before L
in_pin:tap 4 before R
in_pin:tap 4 after L
in_pin:tap 4 after R
in_pin:tap 5 before L
in_pin:tap 5 before R
in_pin:tap 5 after L
in_pin:tap 5 after R
in_pin:tap 6 before L
in_pin:tap 6 before R
in_pin:tap 6 after L
in_pin:tap 6 after R
in_pin:tap 7 before L
in_pin:tap 7 before R
in_pin:tap 7 after L
in_pin:tap 7 after R
in_pin:tap 8 before L
in_pin:tap 8 before R
in_pin:tap 8 after L
in_pin:tap 8 after R
out_pin:left
out_pin:right

@init

  // REAPER re-zeroes a JSFX's memory and re-runs @init on every play and
  // stop unless told not to. The taps' zero is measured WHILE stopped and
  // used while playing, so it has to survive the transport.
  ext_noinit = 1;

  // THE PROBE BLOCK (see above)
  PB_BASE = 0x100000; PB_STRIDE = 128; PB_TRACKS = 8192;
  PB_PRE = 0; PB_POST = 1; PB_PUBPRE = 2; PB_PUBPOST = 3; PB_CMP = 4;
  PB_VISPRE = 5; PB_VISPOST = 6; PB_WATCH = 7;
  PB_TAPN = 8; PB_LAG = 9; PB_RST = 13; PB_GEN = 17; PB_ARM = 18;
  PB_NOGR = 19; PB_MB = 20; PB_MBX = 21; PB_FINE = 24;
  PB_ACKPRE = 32; PB_ACKPOST = 33; PB_SEEN = 34; PB_SEENN = 42;
  PB_GR = 64; PB_CAL = 68; PB_INPK = 72; PB_OUTPK = 76; PB_INRMS = 80;
  PB_OUTRMS = 84; PB_MBGR = 88; PB_MBL = 92; PB_RSEQ = 96;
  // taps 5..8, apart (THE PROBE BLOCK)
  PB_LAG2 = 50; PB_RST2 = 54; PB_GR2 = 97; PB_CAL2 = 101; PB_INPK2 = 105;
  PB_OUTPK2 = 109; PB_INRMS2 = 113; PB_OUTRMS2 = 117; PB_CAP = 121;
  // a tap's field in the block: taps 1..4 at `lo`, 5..8 at `hi`
  function pbAt(lo, hi, t) ( t < 4 ? lo + t : hi + t - 4; );
  CTRL_REL = 75;
  CTRL_GATE = 76;   // moving: a reader names the tracks it shows (PB_WATCH)
  !gate_init ? ( gate_init = 1; gate_age = watch_age = 1000000000; gate_last = watch_last = 0; );

  // the settings and readings, at their defaults
  role = -1; publish = 0; rel_ms = 400; vis_include = 0; vis_slot = -1;
  tap_n = 0; tap_gen = 0; cal_arm = 0; tap_nogr = 0;
  // per tap (TAP_MAX of each): its latency and relearn count (in), its
  // reduction, its zero's state and its levels (out)
  TV_LAG = 400100; TV_RST = 400110; TV_GR = 400120; TV_CAL = 400130;
  TV_INPK = 400140; TV_OUTPK = 400150; TV_INRMS = 400160; TV_OUTRMS = 400170;
  // ... and its make-up, dB (in); a multiband tap's split bands' own
  // (and the count each came with: MAKE-UP GAIN, FOLLOWED)
  TV_MUG = 400180; MB_MUG = 400190; TV_MK = 400200; MB_MK = 400210;
  t = 0;
  loop(4, MB_MUG[t] = MB_MK[t] = 0; t += 1; );
  mb_seq = 0; mbp_t = mbp_1 = mbp_2 = mbp_3 = 0;
  t = 0;
  loop(8,
    TV_MUG[t] = TV_MK[t] = 0;
    TV_LAG[t] = TV_RST[t] = TV_GR[t] = TV_CAL[t] = 0;
    TV_INPK[t] = TV_OUTPK[t] = TV_INRMS[t] = TV_OUTRMS[t] = -150;
    t += 1;
  );
  tap_mb = 0; tap_mbx1 = tap_mbx2 = tap_mbx3 = 0;
  // the stereo tap (STEREO, ONE TAP): its sums, its readings, its scope's
  // ring (L R pairs, here) and where it's published
  PB_ST = 25; PB_CORR = 122; PB_STM = 123; PB_STS = 124; PB_STCAP = 125;
  PB_MUG = 26; PB_MUG2 = 58; PB_MBMUG = 30; PB_MBMUG2 = 62; PB_MUGCAP = 126;
  // A SPECTRUM PER TRACK
  PB_CVSPEC = 127; CVS_BASE = 0x3A0000; CVS_STRIDE = 272; CVS_TRACKS = 4096; CVS_OFF_BAND = 16;
  SINK_BASE = 0x4C0000;
  // COLLISIONS
  COL_BASE = 0x4E0000; COL_STRIDE = 64; COL_OFF = 8; COL_MAXB = 48;
  COL_E = 43000;                  // COL_MAXB+1, band edges in bins
  col_nb = 0; col_hi = 20000; col_seq = 0; col_l = col_r = col_n = 0;
  cvs_v = cvs_last = 0; cvs_age = 1000000000; cvs_seq = 0; cv_active = 0;
  lsn_hb = lsn_last = 0; lsn_age = 1000000000; lsn_on = 0; lsn_mix = 0;
  lsn_f = lsn_q = lsn_k = -1;
  lsn_l1 = lsn_l2 = lsn_l3 = lsn_l4 = lsn_r1 = lsn_r2 = lsn_r3 = lsn_r4 = 0;
  CTRL_STTRK = 77;
  CTRL_NOZERO = 78; // moving: ChannelView is learning a plugin (THE ZERO POINT)
  STH_BASE = 0x340000; STP_BASE = 0x340010; STP_N = 512;
  STR_RING = 1600000;
  // levels per channel (LEVELS PER CHANNEL)
  PLV_BASE = 0x350000; PLV_STRIDE = 64; PLV_TRACKS = 3000;
  tap_st = 0; stc_was = 0; stc_pos = 0; stc_skip = 0; stc_seq = 0;
  stc_ll = stc_rr = stc_lr = stc_mm = stc_ss = 0;
  stc_corr = 0; stc_mdb = stc_sdb = -150;
  tap_mbgr1 = tap_mbgr2 = tap_mbgr3 = tap_mbgr4 = 0;
  tap_fine = 0;
  tap_mbl1 = tap_mbl2 = tap_mbl3 = tap_mbl4 = -150;
  pb = -1; pl_tr = -3; pl_pos = -1; pl_fl = 0; pb_blocks = 0;


  CTRL_EPOCH = 64;
  CTRL_FFT   = 65;
  CTRL_SLICE = 66;
  CTRL_BEAT  = 67;
  CTRL_MEAS  = 68;   // 0 = off, 1 = accumulate (one capture), 2 = running
  CTRL_TAU   = 69;   // running-average time constant in ms, mode 2 only
  CTRL_SMOO  = 70;   // response smoothing width in OCTAVES, 0 = none
  CTRL_LAG   = 71;   // samples of latency reported by the FX BETWEEN the
                     // probes. The pre probe delays itself by this much so
                     // that its column N and the post probe's column N hold
                     // the same slice of audio. See THE DELAY below.
  CTRL_GRB   = 72;   // 1 = run the gain-reduction filterbank. Off unless the
                     // panel is drawing the measured trace, because it is
                     // the only per-sample work here that is not free.

  PRE_BASE  = 0x10000;
  POST_BASE = 0x20000;
  // A third region, written by the POST probe of whatever track the panel
  // is comparing against. It is a separate base rather than a slot scheme
  // because the comparison is between exactly two tracks: the one you are
  // looking at and the one you picked.
  CMP_BASE  = 0x30000;

  H_SEQ=0; H_RMS=1; H_PEAK=2; H_SRATE=3; H_NBINS=4; H_FFTSZ=5;
  H_SLICE=6; H_EPOCHACK=7; H_CUR=8; H_COLS=9; H_BLOCKS=10;
  H_ROLE=11; H_NCH=12; H_PKL=13; H_PKR=14; H_AVGN=15;
  H_BANDN=16; H_BANDLO=17; H_BANDHI=18;
  H_GRBN=19; H_GRBLO=20; H_GRBHI=21;
  H_LAG=22;                       // the delay actually applied, so the panel
                                  // can show what it compensated rather than
                                  // what it asked for

  // No per-bin data goes to gmem: the panel reads the band summary below
  // and the scope ring. Offsets 64 to 4095 are left unwritten rather than
  // reused, so an older tool reads zeros there instead of something that
  // looks plausible and is not.
  OFF_SCOPE = 4096;
  SCOPE_COLS = 4096;              // 8.2 s of history at 2 ms per column

  // THE LOG-SPACED SUMMARY, AND WHY IT IS DONE HERE
  //   Reading all 1024 bins from both probes and drawing a quad per pixel
  //   column would be about three thousand gmem reads and four thousand
  //   marshalled draw calls a frame, enough to make the panel lag. Here it
  //   is one pass over data the DSP already has in front of it.
  //
  //   Summarising to a log grid also keeps the response curve from going
  //   jagged. A per-bin difference shows every bit of bin-to-bin noise in
  //   the average; a band holding a dozen bins averages it away, and it
  //   holds most bins exactly where the jaggedness was -- the top end.
  //
  //   Per point, stride 4:
  //     0  display level, dB, ballistic, loudest bin in the band
  //     1  measurement average, dB, mean POWER over the band
  //     2  response, dB   (post probe only: this band minus the pre probe's)
  //     3  excitation, dB below the loudest band  (post probe only, <= 0)
  OFF_BAND  = 16384;
  BANDS   = 256;
  BAND_LO = 20;
  BAND_HI = 20000;

  // Visualizer bridge -- the slot addressing TS_Visualizer.lua reads
  // (0x40000 + slot*2048, a header plus 256 band values per slot).
  VIS_SLOT_BASE   = 0x40000;
  VIS_SLOT_STRIDE = 2048;
  VIS_MAX_SLOTS   = 16;
  VIS_H_SEQ = 0; VIS_H_BANDN = 1; VIS_H_BANDLO = 2; VIS_H_BANDHI = 3; VIS_H_FFTSZ = 4;
  VIS_OFF_BAND = 16;
  vis_slotn = -2;   // last vis_slot a header was published for; forces one
                    // republish the first time vis_include+slot both hold,
                    // and again on every slot change after that
  vis_seq = 0;

  // THE GAIN-REDUCTION FILTERBANK, AND WHY IT EXISTS
  //   Post RMS over pre RMS across the whole span is not gain: it is the
  //   span's LEVEL change, and when
  //   anything in the span changes the SPECTRUM, the level change depends
  //   on where the programme's energy happens to be sitting. One EQ band,
  //   +6 dB at 100 Hz, adds +6 dB to the ratio through a bass note and
  //   nothing through a cymbal. The EQ never moved; the music did, and it
  //   would go onto the trace as if it were compression.
  //
  //   A per-BAND ratio does not have that property. Band b's ratio is the
  //   EQ's gain in band b whatever the programme is doing. So each probe
  //   publishes a per-band level per scope column, and the panel takes the
  //   part that MOVES and is COMMON TO EVERY BAND -- which is compression --
  //   after subtracting each band's own average, which is the static EQ.
  //
  //   Ten bands over 30 Hz to 18 kHz, two cascaded bandpass sections each.
  //   One section is not enough: its skirts overlap so far that neighbouring
  //   bands leak into each other and the separation that the whole idea
  //   rests on stops working. Measured over six EQ and saturation chains,
  //   one section gave 1.53 dB of error against the true reduction, two
  //   gave 0.86 -- the same as a 4th-order design costing twice as much.
  OFF_GRB = 17408;                // SCOPE_COLS * GRB_N, ends at 58368
  GRB_N   = 10;
  GRB_LO  = 30;
  GRB_HI  = 18000;

  // Long enough for any plugin that reports honestly -- a linear-phase EQ
  // at 4096 and a lookahead limiter at 50 ms both fit several times over.
  DLY_MAX = 65536;

  FFT_MAX = 4096;

  // Local buffers. The FFT workspace sits at offset 0 so it satisfies any
  // alignment REAPER wants, whatever the size ends up being.
  BUF_FFT = 0;                    // FFT_MAX*2, interleaved re/im
  BUF_ACC = 8192;                 // FFT_MAX,   accumulating input
  BUF_WIN = 16384;                // FFT_MAX,   Hann window
  BUF_MAG = 24576;                // FFT_MAX/2, smoothed dB per bin
  BUF_AVG = 32768;                // FFT_MAX/2, accumulated power for the
                                  //            measurement average
  BUF_BEDGE = 40960;              // BANDS+1, band edges in bins
  BUF_BA    = 41472;              // BANDS,   this probe's band average, dB
  BUF_BR    = 41728;              // BANDS,   the response before smoothing
  BUF_BT    = 41984;              // BANDS,   smoothing scratch
  BUF_BV    = 42240;              // BANDS,   1 where the band has real data
  BUF_GRC   = 42496;              // GRB_N*4, bandpass coefficients
  BUF_GRS   = 42624;              // GRB_N*4, two sections of state per band
  BUF_GRQ   = 42752;              // GRB_N,   squares accumulating this column
  BUF_DLY   = 49152;              // DLY_MAX+1, the pre probe's alignment delay

  fftsz = 0;                      // forces buildWindow on the first block
  last_meas = -1;                 // forces one clearAvg on the first block
  lagn = -1;                      // forces one setLag on the first block
  dpos = 0;
  grbon = 0;
  slice = 0;
  seq = 0;
  blocks = 0;
  last_epoch = -1;

  function buildWindow(n) local(i, ph) (
    i = 0;
    loop(n,
      ph = 2 * $pi * i / n;
      BUF_WIN[i] = 0.5 - 0.5 * cos(ph);
      i += 1;
    );
  );

  // Instant attack, exponential release, per hop. An analyser that averages
  // the attack as well hides exactly the transients you are looking at.
  function setBallistics() (
    rel = exp(-1 * (hop / srate) / (max(rel_ms, 10) * 0.001));
  );

  // The average is cleared on its own as well as with everything else,
  // because switching between the one-shot and running modes changes what
  // BUF_AVG holds -- a sum of powers in one, a mean power in the other --
  // and carrying a sum into a mean is nonsense. Clearing it must NOT take
  // the scope ring with it: panel 2 should not blank because panel 1
  // changed its averaging.
  function clearAvg() local(i) (
    avgn = 0;
    gmem[base + H_AVGN] = 0;
    i = 0; loop(FFT_MAX / 2, BUF_AVG[i] = 0; i += 1; );
  );

  // The filterbank's own state: the two sections per band, and the squares
  // part-way through the column being accumulated. Carrying either across a
  // restart puts audio from before the change into the column after it.
  function clearGR() local(i) (
    i = 0; loop(GRB_N * 4, BUF_GRS[i] = 0; i += 1; );
    i = 0; loop(GRB_N,     BUF_GRQ[i] = 0; i += 1; );
  );

  // Ten bandpass filters, log-spaced, two identical sections each. Only the
  // three coefficients a bandpass actually needs are kept: b1 is zero and b2
  // is -b0, so storing them would be storing a constant.
  //
  // The top edge is held below Nyquist rather than trusted to be: at 32 kHz
  // an 18 kHz band centre is not a filter, it is a division by zero waiting
  // for somebody working at a rate nobody tested.
  function buildGRBands() local(i, ratio, lo, hi, f0, q, w0, al, a0, hiC) (
    hiC = min(GRB_HI, srate * 0.45);
    ratio = log(hiC / GRB_LO);
    i = 0;
    loop(GRB_N,
      lo = GRB_LO * exp(ratio * i / GRB_N);
      hi = GRB_LO * exp(ratio * (i + 1) / GRB_N);
      f0 = sqrt(lo * hi);
      q  = f0 / max(hi - lo, 1);
      w0 = 2 * $pi * f0 / srate;
      al = sin(w0) / (2 * q);
      a0 = 1 + al;
      BUF_GRC[i * 4 + 0] = al / a0;                 // b0
      BUF_GRC[i * 4 + 1] = (-2 * cos(w0)) / a0;     // a1
      BUF_GRC[i * 4 + 2] = (1 - al) / a0;           // a2
      BUF_GRC[i * 4 + 3] = 0;
      i += 1;
    );
    clearGR();
  );

  // Only as much of the line as is in use is cleared, and only when the
  // length changes: this runs on a block boundary, and wiping 64k of memory
  // every time the panel repeats itself is a dropout waiting to happen.
  function setLag(n) local(i) (
    n = max(0, min(DLY_MAX, floor(n)));
    n != lagn ? (
      lagn = n;
      dpos = 0;
      i = 0; loop(lagn + 1, BUF_DLY[i] = 0; i += 1; );
    );
  );

  function restart() local(i) (
    cur = 0;
    sacc = 0; smin = 1; smax = -1; ssq = 0;
    fill = 0;
    gmem[base + H_CUR] = 0;
    i = 0; loop(SCOPE_COLS * 3, gmem[base + OFF_SCOPE + i] = 0; i += 1; );
    i = 0; loop(SCOPE_COLS * GRB_N, gmem[base + OFF_GRB + i] = 0; i += 1; );
    clearGR();
    // The measurement average restarts with everything else, so a capture
    // can never contain a frame from before the setting changed.
    clearAvg();
  );

  // Where each band starts and ends, in bins. Recomputed only when the FFT
  // size or the sample rate changes, so the per-frame pass has no logs in it.
  function buildBands() local(i, ratio, elo, ehi) (
    ratio = log(BAND_HI / BAND_LO);
    i = 0;
    loop(BANDS + 1,
      BUF_BEDGE[i] = BAND_LO * exp(ratio * i / BANDS) * fftsz / srate;
      i += 1;
    );
    // COLLISIONS: one band per ERB from BAND_LO to the top (below Nyquist)
    col_hi = min(BAND_HI, srate * 0.45);
    elo = 21.4 * log10(4.37 * BAND_LO / 1000 + 1);
    ehi = 21.4 * log10(4.37 * col_hi / 1000 + 1);
    col_nb = max(4, min(COL_MAXB, floor(ehi - elo + 0.5)));
    i = 0;
    loop(col_nb + 1,
      COL_E[i] = (10 ^ ((elo + i * (ehi - elo) / col_nb) / 21.4) - 1) * 1000 / 4.37 * fftsz / srate;
      i += 1;
    );
  );

  function reconfigure(newsz, newslice) local(i) (
    fftsz = newsz;
    nbins = fftsz / 2;
    hop   = fftsz / 2;
    slice = newslice;
    buildWindow(fftsz);
    buildBands();
    buildGRBands();
    setBallistics();
    i = 0; loop(nbins, BUF_MAG[i] = -180; i += 1; );
    restart();
  );

  //-- the taps ----------------------------------------------------------
  CTRL_TAPHB  = 73;               // bumped by any reader; taps idle when it stops
  TAPTR_HDR   = 0x4F000;          // [0] taps in use, [1..8] each tap's reading, [9] TAPTR_BASE2
  TAPTR_BASE  = 0x50000;          // tap t's column t*SCOPE_COLS + cur (taps 1..4)
  TAPTR_BASE2 = 0x310000;         // ... taps 5..8, (t-4)*SCOPE_COLS + cur (clear of the Trimmer's blocks)
  TAP_MAX     = 8;
  TAP_BASE    = 1048576;          // clear of everything above (and the FFT rings)
  TAP_STRIDE  = 66560;            // a delay line, then the state below
  TAP_S       = 65544;            // state, relative to the tap's base
  TS_PRE = 0; TS_POST = 40;       // filter state, 10 bands x 4
  TS_PA = 80; TS_PB = 90;         // each band's power, before and after (mean square)
  TS_SM = 100; TS_BS = 110;       // smoothed ratio, baseline (dB)
  TS_PK = 120; TS_HB = 130;       // band peak (power), has-baseline flag
  TS_SORT = 140;                  // median scratch
  TS_DPOS = 160; TS_LAGN = 161; TS_DISP = 162; TS_LAST = 163; TS_RST = 164;
  // the measured zero (THE ZERO POINT): power sums per band for each test
  // level, before and after; the zero and its validity; a candidate being
  // checked; column counts; the state reported on tap_calN
  TS_AA = 170; TS_AB = 180; TS_BA = 190; TS_BB = 200;
  TS_ZERO = 210; TS_ZV = 220; TS_ZT = 230; TS_ZTV = 240;
  TS_NA = 250; TS_NB = 251; TS_HASCAL = 252; TS_CST = 253; TS_STALE = 254;
  // levels: input and output peak (falling), input and output mean square
  TS_LIP = 260; TS_LOP = 261; TS_LIR = 262; TS_LOR = 263;
  // a multiband tap: each filterbank band's reduction this column (-1
  // when gated), and each of the plugin's bands' reading
  TS_MBD = 270; TS_MBG = 280;
  TS_HOLD = 290;                  // samples until a latency change has flushed through
  TS_MBP = 300;                   // a multiband tap: each filterbank band's input power this column
  TS_MBL = 320;                   // ... and each of the plugin's bands' input level (dBFS)
  TS_RPOS = 340;                  // where the next sample goes in its ring (THE TEN BANDS, BY FFT)
  TS_LCP = 350;                   // levels per channel: peaks (in L, R, out L, R), then mean squares
  TS_LCR = 354;
  TS_ZSH = 360; TS_ZSV = 370;     // a shut zero: each band's level when shut on the test signal, valid
  TS_GATE = 380; TS_GOPEN = 381;  // a gate for certain (THE ZERO POINT), columns seen open
  TS_BSA = 390; TS_BSB = 400;     // each band's baseline, kept every 32 columns: latest, and the one before
  TS_MO = 410;                    // each band's make-up last column (MAKE-UP GAIN, FOLLOWED)
  TS_MK = 420; TS_MBS = 421;      // ... the count, and the multiband split's, last seen
  TS_HBA = 430;                   // each band's columns since its baseline was first learnt
  // the zero kept on the music (THE ZERO, KEPT ON THE MUSIC): each band's
  // ratio over its zero this column; the input's falling peak (dB); the
  // last column's median; the steady stretch's columns, sum, and whether
  // all of it was quiet; where the quiet stretches sit, and whether known
  TS_ZQ = 440; TS_QIP = 450; TS_QM = 451; TS_QN = 452; TS_QS = 453; TS_QQ = 454;
  TS_QR = 455; TS_QRV = 456; TS_QLO = 457; TS_QHI = 458;
  // how far the music has moved the zero up from its measurement; the
  // highest steady stretch in the window, the stretches and columns in it
  TS_QUP = 459; TS_QWM = 460; TS_QWN = 461; TS_QWT = 462;
  // a stretch's input level summed; the level of the last that moved it
  // up, and where such a stretch sits since
  TS_QIS = 463; TS_QUL = 464; TS_QUM = 465; TS_QMH = 466; TS_QMZ = 467;
  LV_FALL = 20;                   // dB/s the published peak falls
  LV_RMS  = 0.3;                  // s, the RMS window
  LV_RATE = 30;                   // publications a second
  tap_lvc = 0; tap_lvdead = 0;
  TAP_SMOOTH = 0.3;               // per column
  TAP_RISE   = 0.5;
  TAP_DEC    = 0.1;               // dB/s the baseline sinks
  TAP_REL    = 150;               // dB/s the reading falls: a short hold, so a
                                  // frame-rate reader catches a 2 ms peak, and
                                  // no slower -- the reader adds its own hold
  // THE TEN BANDS, BY FFT
  TF_WS   = 524288;               // FFT workspace, up to 16384 complex: on a 65536 boundary
  TF_W2   = 557056;               // the windows, complex (w, 0): the largest size ...
  TF_W1   = 589824;               // ... the middle ...
  TF_W0   = 598016;               // ... and the smallest
  TF_BR   = 600100;               // per band: which size (0 small, 1 middle, 2 large)
  TF_BK0  = 600120;               // ... its first bin
  TF_BK1  = 600140;               // ... its last bin
  TF_RING = 655360;               // per tap, its ring: before and after, packed
  TF_RSTR = 32768;                // a ring's room: 16384 complex
  tap_col = 0;
  tap_sr = 0; tap_sacc = 0; tap_on = 0; tap_live = 0;
  hb_last = -1; hb_age = 1000000000;

  // per-plugin waveforms (PER-PLUGIN WAVEFORMS)
  CTRL_TWTRK = 74;
  TW_BASE = 0x54000;              // taps 1..4
  TW_BASE2 = 0x318000;            // taps 5..8 (clear of the Trimmer's blocks)
  function twAt(t, c) ( t < 4 ? TW_BASE + (t * TW_COLS + c) * 4 : TW_BASE2 + ((t - 4) * TW_COLS + c) * 4; );
  TW_HDR  = 0x5C000;
  TW_COLS = 2048;
  TW_ACC  = 400000;               // per tap: min, max, input peak, GR (8 x 4)
  tw_on = 0; tw_cur = 0; tw_sacc = 0; tw_n = 0; tw_slice = 192;
  t = 0; loop(TAP_MAX, TW_ACC[t * 4] = 1; TW_ACC[t * 4 + 1] = -1;
                       TW_ACC[t * 4 + 2] = 0; TW_ACC[t * 4 + 3] = 0; t += 1; );

  // measuring the zero
  CAL_BASE   = 0x60000;           // + track index * CAL_STRIDE
  CAL_STRIDE = 8;
  CAL_SLOTS  = 4096;
  CS_CFG = 0;                     // post: taps in use
  CS_PHASE = 1;                   // pre: 0 idle, 1 level A, 2 level B, 3 tail
  CS_PREHB = 2;                   // pre: block counter
  CS_POSTHB = 3;                  // post: block counter
  CS_REQ = 4;                     // post: a tap needs its zero measuring
  CS_POSTPK = 5;                  // post: input peak, last block
  CS_ABORT = 6;                   // post: something real arrived, stop
  CAL_GA = 10 ^ (-60 / 20) / 1.7276;   // pink noise at -60 dBFS RMS ...
  CAL_GB = 10 ^ (-50 / 20) / 1.7276;   // ... and -50 (the filter's own RMS)
  CAL_WAIT = 1.0;                 // s of silence before starting
  CAL_LEN = 1.0;                  // s at each level
  CAL_TAIL = 0.5;                 // s still muted after, for latency
  CAL_SETTLE = 0.3;               // s of each level not used
  CAL_GAP = 5;                    // s between runs asked for while stopped
  CAL_QUIET_PRE = 0.00001;        // -100 dBFS: nothing coming in
  CAL_QUIET_POST = 0.001;         // -60 dBFS: a plugin's own hiss allowed
  CAL_LOUD = 0.25;                // -12 dBFS at the post probe: not ours
  CAL_MINCOL = 100;
  CAL_MINBANDS = 5;
  CAL_SHUT = -10;                 // dB: every band this far down on the test signal: shut on it
  GATE_OPEN = 6;                  // dB over its shut level in most bands, while playing: open
  GATE_COLS = 25;                 // columns seen open before it's a gate for certain
  Q_SPAN   = 0.6;                 // dB the median may wander in a steady stretch
  Q_COLS   = 40;                  // columns (80 ms) of it to count
  Q_QUIET  = 20;                  // dB under the input's peak: quiet
  Q_TOL    = 0.25;                // dB off the zero before it moves
  Q_STEP   = 0.6;                 // of the way, each time
  Q_REF    = 0.3;                 // how fast the quiet stretches' place is learnt
  Q_WIN    = 1;                   // s: touched, the highest steady stretch over this
  Q_FALL   = 6;                   // dB/s the input's peak falls
  Q_MUGHOLD = 1;                  // s after a followed make-up last moved
  Q_MUGDROP = 40;                 // dB a followed make-up may sit under the zero's
  cal_phase = 0; cal_t = 0; cal_quiet = 0; cal_since = 1000000000;
  nz_last = gmem[CTRL_NOZERO]; nz_age = 1000000000; cal_held = 0;
  cal_hb = 0; cal_phb = 0; cal_inpk = 0; cal_ppk = 0;
  cal_post_last = -1; cal_post_age = 1000000000;
  cal_pre_last = -1; cal_pre_age = 1000000000;
  cal_ph = 0; cal_pt = 0; cal_acc = 0; cal_mute = 0; cal_fails = 0; cal_p1 = 0;
  cal_gen_last = -1; cal_slot = -1;
  kb0 = kb1 = kb2 = 0;

  // third-octaves for one tap (THIRD-OCTAVE REDUCTION)
  FN_N = 8192; FN_HOP = 1024; FN_MAXB = 30; FN_FL = 18;
  FN_A  = 420000;                 // before, a ring of FN_N
  FN_B  = FN_A + FN_N;            // after
  FN_W  = FN_B + FN_N;            // the window
  // FFT workspace, 2 * FN_N each: fft() needs a buffer that doesn't cross
  // a 65536 boundary, so these start on one
  FN_FA = 458752;
  FN_FB = FN_FA + 2 * FN_N;
  FN_S  = FN_W + FN_N;            // per band, FN_FL fields:
  //   0 first bin  1 last bin  2 power before  3 power after (smoothed)
  //   4 ratio dB  5 baseline  6 has baseline  7 peak power before
  //   8 zero  9 zero valid  10..13 the zero's sums (A before/after, B)
  //   16 the make-up taken out last frame (MAKE-UP GAIN, FOLLOWED)
  //   14 published  15 has signal
  FN_GM = 0x70000; FN_GSTR = 128;
  fn_sr = 0; fn_pos = 0; fn_cnt = 0; fn_nb = 0; fn_tap = -1; fn_seq = 0;
  fn_hascal = 0; fn_cna = 0; fn_cnb = 0;
  // samples to wait before the third-octaves count again: a window still
  // holding audio from before a change (the "before" delay line cleared
  // when the tap's latency moves -- silence on one side, music on the
  // other) reads as a jump the zero then believes for minutes
  fn_hold = 0; fn_rebase = 0;
  // how fast the zero learnt from the music climbs to a higher ratio, a
  // frame (the taps' 0.5 would let one odd frame lift it halfway)
  FN_RISE = 0.03;

  // A tap's make-up gain at frequency f, dB (MAKE-UP GAIN, FOLLOWED): its
  // own, and on the multiband tap, that of the split band f falls in.
  function mugAt(t, f) local(o, k) (
    o = t >= 0 ? TV_MUG[t] : 0;
    t == tap_mb - 1 ? (
      k = (tap_mbx1 > 0 && f >= tap_mbx1) + (tap_mbx2 > 0 && f >= tap_mbx2) + (tap_mbx3 > 0 && f >= tap_mbx3);
      o += MB_MUG[k];
    );
    o;
  );
  // ... at filterbank band bi's centre
  function mugBand(t, bi) (
    t == tap_mb - 1
      ? mugAt(t, GRB_LO * exp(log(min(GRB_HI, srate * 0.45) / GRB_LO) * (bi + 0.5) / GRB_N))
      : TV_MUG[t];
  );

  function fineSetup() local(i, k, fc, fl, fh, b, lo, hi, j) (
    i = 0; loop(FN_N, FN_W[i] = 0.5 - 0.5 * cos(2 * $pi * i / FN_N); FN_A[i] = 0; FN_B[i] = 0; i += 1; );
    fn_nb = 0;
    k = -16;
    loop(FN_MAXB,
      fc = 1000 * 2 ^ (k / 3);
      fl = fc * 2 ^ (-1 / 6); fh = fc * 2 ^ (1 / 6);
      fh < srate * 0.48 ? (
        b = FN_S + fn_nb * FN_FL;
        lo = ceil(fl * FN_N / srate); hi = floor(fh * FN_N / srate);
        hi < lo ? ( lo = floor(fc * FN_N / srate + 0.5); hi = lo; );
        // at least three bins: a low band of one or two swings with every
        // hit (its neighbours overlap a little -- it's for watching)
        hi - lo + 1 < 3 ? ( lo = floor(fc * FN_N / srate + 0.5) - 1; hi = lo + 2; );
        b[0] = max(1, lo); b[1] = max(b[0], hi);
        j = 2; loop(FN_FL - 2, b[j] = 0; j += 1; );
        fn_nb += 1;
      );
      k += 1;
    );
    fn_sr = srate; fn_pos = 0; fn_cnt = 0; fn_hascal = 0; fn_cna = 0; fn_cnb = 0;
    fn_pkdec = 10 ^ (-6 / 10 * FN_HOP / srate);
  );

  // what the music taught the bands, gone (the plugin was touched)
  function fineForget() local(k) (
    k = 0; loop(fn_nb, (FN_S + k * FN_FL)[6] = 0; k += 1; );
    fn_hold = FN_N;
  );

  // a new zero measurement: the sums start again
  function fineCalClear() local(k, b) (
    k = 0; loop(fn_nb, b = FN_S + k * FN_FL; b[10] = b[11] = b[12] = b[13] = 0; k += 1; );
    fn_cna = 0; fn_cnb = 0;
  );

  // the run finished: each band's zero, the higher of its two levels'
  // ratios, kept when enough bands had signal
  function fineCalCommit() local(k, b, va, vb, za, zb, n) (
    n = 0;
    k = 0;
    loop(fn_nb,
      b = FN_S + k * FN_FL;
      va = fn_cna >= 8 && b[10] > 0.0000001 * fn_cna && b[11] > 0.000000001 * fn_cna;
      vb = fn_cnb >= 8 && b[12] > 0.0000001 * fn_cnb && b[13] > 0.000000001 * fn_cnb;
      va ? (za = 10 * log10(b[11] / b[10]) - mugAt(tap_fine - 1, 1000 * 2 ^ ((k - 16) / 3)));
      vb ? (zb = 10 * log10(b[13] / b[12]) - mugAt(tap_fine - 1, 1000 * 2 ^ ((k - 16) / 3)));
      (va || vb) ? ( b[8] = (va && vb) ? max(za, zb) : (va ? za : zb); b[9] = 1; n += 1; ) : (b[9] = 0);
      k += 1;
    );
    n >= 10 ? (fn_hascal = 1);
  );

  function fineFrame() local(i, j, b, k, pa, pb, r, d, dec, rel, gb, lv, mo) (
    i = 0;
    loop(FN_N,
      j = fn_pos + i; j >= FN_N ? (j -= FN_N);
      FN_FA[2 * i] = FN_A[j] * FN_W[i]; FN_FA[2 * i + 1] = 0;
      FN_FB[2 * i] = FN_B[j] * FN_W[i]; FN_FB[2 * i + 1] = 0;
      i += 1;
    );
    fft(FN_FA, FN_N); fft_permute(FN_FA, FN_N);
    fft(FN_FB, FN_N); fft_permute(FN_FB, FN_N);
    dec = TAP_DEC * FN_HOP / srate;
    rel = 40 * FN_HOP / srate;      // dB a frame the picture lets go
    cal_mute ? (
      cal_acc ? ( cal_ph == 1 ? (fn_cna += 1) : (fn_cnb += 1); );
    );
    k = 0;
    loop(fn_nb,
      b = FN_S + k * FN_FL;
      // the make-up taken out (MAKE-UP GAIN, FOLLOWED): moved with what's
      // taken out, everything learnt moves with it
      mo = mugAt(tap_fine - 1, 1000 * 2 ^ ((k - 16) / 3));
      fn_rebase ? ( d = mo - b[16]; b[4] -= d; b[5] -= d; b[8] -= d; );
      b[16] = mo;
      pa = 0; pb = 0; i = b[0];
      loop(b[1] - b[0] + 1,
        pa += sqr(FN_FA[2 * i]) + sqr(FN_FA[2 * i + 1]);
        pb += sqr(FN_FB[2 * i]) + sqr(FN_FB[2 * i + 1]);
        i += 1;
      );
      cal_mute ? (
        cal_acc ? ( cal_ph == 1 ? ( b[10] += pa; b[11] += pb; ) : ( b[12] += pa; b[13] += pb; ); );
        b[15] = 0;
      ) : (
        b[2] += (pa - b[2]) * 0.6; b[3] += (pb - b[3]) * 0.6;
        b[7] = max(b[2], b[7] * fn_pkdec);
        (fn_hold <= 0 && b[2] > max(0.001, b[7] * 0.00001) && b[3] > 0.000000000001) ? (
          r = 10 * log10(b[3] / b[2]) - mo;
          b[6] < 0.5 ? ( b[4] = r; b[5] = r; b[6] = 1; b[14] = 0; ) : (
            b[4] = r;
            b[4] > b[5] ? (b[5] += (b[4] - b[5]) * FN_RISE) : (b[5] -= dec);
          );
          d = r - ((fn_hascal && b[9] > 0.5) ? b[8] : b[5]);
          // as measured: ChannelView smooths it. (Held at its deepest, a
          // kick landing at a window's edge -- one frame's swing -- reads
          // as reduction that isn't there.)
          b[14] = d;
          b[15] = 1;
        ) : ( b[15] = 0; b[14] = min(0, b[14] + rel); );
      );
      k += 1;
    );
    fn_rebase = 0;
    // out to gmem, for this track
    (cal_pl >= 0 && cal_pl < CAL_SLOTS) ? (
      gb = FN_GM + cal_pl * FN_GSTR;
      fn_seq = (fn_seq + 1) % 1000000;
      gmem[gb + 1] = fn_nb; gmem[gb + 2] = tap_fine; gmem[gb + 3] = fn_hascal; gmem[gb + 4] = srate;
      k = 0;
      loop(fn_nb,
        b = FN_S + k * FN_FL;
        gmem[gb + 8 + k] = b[15] > 0.5 ? b[14] : -999;
        lv = b[2] / (FN_N * FN_N / 16);
        gmem[gb + 72 + k] = lv > 0.000000000000001 ? 10 * log10(lv) : -150;
        k += 1;
      );
      gmem[gb] = fn_seq;
    );
  );

  // one sample of the third-octave tap: `a` before (already lined up), `b` after
  function fineIn(a, b) (
    fn_hold > 0 ? (fn_hold -= 1);
    FN_A[fn_pos] = a; FN_B[fn_pos] = b;
    fn_pos += 1; fn_pos >= FN_N ? (fn_pos = 0);
    fn_cnt += 1;
    fn_cnt >= FN_HOP ? ( fn_cnt = 0; fineFrame(); );
  );

  // a Hann window of n points, as complex pairs (w, 0), at `w`
  function tfWindow(w, n) local(i) (
    i = 0;
    loop(n, w[i * 2] = 0.5 - 0.5 * cos(2 * $pi * i / n); w[i * 2 + 1] = 0; i += 1; );
  );

  function tapBands() local(i, ratio, lo, hi, hiC, k, r, n, b0, b1) (
    hiC = min(GRB_HI, srate * 0.45);
    ratio = log(hiC / GRB_LO);
    // the three sizes, scaled with the rate (THE TEN BANDS, BY FFT)
    k = srate > 132000 ? 4 : (srate > 66000 ? 2 : 1);
    tf_n0 = 256 * k; tf_n1 = 1024 * k; tf_n2 = 4096 * k;
    tf_rn = tf_n2;
    tfWindow(TF_W0, tf_n0); tfWindow(TF_W1, tf_n1); tfWindow(TF_W2, tf_n2);
    i = 0;
    loop(GRB_N,
      lo = GRB_LO * exp(ratio * i / GRB_N);
      hi = GRB_LO * exp(ratio * (i + 1) / GRB_N);
      // the smallest size giving it three bins or more
      r = 0;
      while (r < 2 && (hi - lo) * (r == 0 ? tf_n0 : tf_n1) / srate < 3) ( r += 1; );
      n = r == 0 ? tf_n0 : (r == 1 ? tf_n1 : tf_n2);
      b0 = max(1, ceil(lo * n / srate));
      b1 = min(n / 2 - 1, max(b0, ceil(hi * n / srate) - 1));
      TF_BR[i] = r; TF_BK0[i] = b0; TF_BK1[i] = b1;
      i += 1;
    );
    tap_slice = max(8, floor(srate * 0.002));
    tap_cps   = srate / tap_slice;
    tap_dec   = TAP_DEC / tap_cps;
    tap_rel   = TAP_REL / tap_cps;
    tap_pkdec = 10 ^ (-6 / 10 / tap_cps);   // band peaks fall 6 dB/s
    tap_qfall = Q_FALL / tap_cps;
    tap_qwin  = Q_WIN * tap_cps;
    tap_qmh   = Q_MUGHOLD * tap_cps;
    tap_lvpk  = 10 ^ (-LV_FALL / 20 / srate);
    tap_lvcol = LV_FALL / tap_cps;          // dB a column the bands' input levels fall
    tap_lvrk  = 1 - exp(-1 / (srate * LV_RMS));
    tap_lvn   = max(64, floor(srate / LV_RATE));
    tap_sr = srate;
  );

  // Everything a tap has learnt, gone: filter state, accumulators, the
  // baselines, the reading. The delay line is left to setTapLag.
  function tapReset(t) local(s, i) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    i = 0; loop(TS_SORT, s[i] = 0; i += 1; );
    s[TS_DISP] = 0; s[TS_LAST] = 0; s[TS_QN] = 0;
    i = 0; loop(4, s[TS_MBG + i] = 0; i += 1; );
    t == tap_fine - 1 ? (fineForget());
  );

  function setTapLag(t, n) local(tb, s, i) (
    tb = TAP_BASE + t * TAP_STRIDE;
    s = tb + TAP_S;
    n = max(0, min(DLY_MAX, floor(n)));
    // The delay line is cleared -- and the baseline learnt from the music
    // too: learnt with the two sides out of line, it climbs to the
    // biggest swings a hit makes and reads as reduction on a plugin doing
    // nothing. The measured zero (THE ZERO POINT) is the plugin's own and
    // stays.
    n != s[TS_LAGN] ? (
      s[TS_LAGN] = n;
      s[TS_DPOS] = 0;
      i = 0; loop(n + 1, tb[i] = 0; i += 1; );
      // until the cleared line has refilled, "before" is part silence: a
      // ratio taken then jumps, and the baseline climbs to it and sinks
      // back at 0.1 dB/s -- minutes of reduction that isn't there
      s[TS_HOLD] = n + 2 * max(1, tap_slice) + tf_rn;   // (and the FFTs' longest window)
      i = 0; loop(GRB_N, s[TS_HB + i] = 0; i += 1; );
      // the third-octaves' zero, learnt across the jump, would be wrong
      t == tap_fine - 1 ? ( fineForget(); fn_hold = FN_N + n; );
    );
  );

  // One sample of one tap: `a` is the mono sum before the plugin, `b`
  // after it. Delay a, and keep both for the FFTs.
  function tapSample(t, a, b) local(tb, s, n, dp, rg) (
    tb = TAP_BASE + t * TAP_STRIDE;
    s = tb + TAP_S;
    n = s[TS_LAGN];
    s[TS_HOLD] > 0 ? (s[TS_HOLD] -= 1);
    n > 0 ? (
      dp = s[TS_DPOS];
      tb[dp] = a;
      dp += 1; dp > n ? dp = 0;
      a = tb[dp];
      s[TS_DPOS] = dp;
    );
    // into its ring, before and after packed as one complex sample
    rg = TF_RING + t * TF_RSTR;
    dp = s[TS_RPOS];
    rg[dp * 2] = a; rg[dp * 2 + 1] = b;
    dp += 1; dp >= tf_rn ? dp = 0;
    s[TS_RPOS] = dp;
    t == tap_fine - 1 ? (fineIn(a, b));
  );

  // The bands taken at size r (0 small, 1 middle, 2 large) from tap t's
  // ring: its last n samples, windowed, one complex FFT; each band's power
  // before and after, as mean squares, into TS_PA / TS_PB.
  function tapFFT(t, r) local(s, n, w, rg, st, n1, sc, bi, k, kk, zr, zi, yr, yi, sa, sb, u, v) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    n = r == 0 ? tf_n0 : (r == 1 ? tf_n1 : tf_n2);
    w = r == 0 ? TF_W0 : (r == 1 ? TF_W1 : TF_W2);
    rg = TF_RING + t * TF_RSTR;
    st = s[TS_RPOS] - n; st < 0 ? st += tf_rn;
    n1 = min(n, tf_rn - st);
    memcpy(TF_WS, rg + st * 2, n1 * 2);
    n1 < n ? memcpy(TF_WS + n1 * 2, rg, (n - n1) * 2);
    convolve_c(TF_WS, w, n);
    fft(TF_WS, n); fft_permute(TF_WS, n);
    // Hann: a mean square is 2 x the bins' power / (0.375 n^2); the two
    // spectra out of the one: A = (Z[k] + conj Z[n-k]) / 2, B = (Z[k] - conj Z[n-k]) / 2i
    sc = 0.5 / (0.375 * n * n);
    bi = 0;
    loop(GRB_N,
      TF_BR[bi] == r ? (
        sa = 0; sb = 0;
        k = TF_BK0[bi];
        loop(TF_BK1[bi] - k + 1,
          zr = TF_WS[k * 2]; zi = TF_WS[k * 2 + 1];
          kk = (n - k) * 2; yr = TF_WS[kk]; yi = TF_WS[kk + 1];
          u = zr + yr; v = zi - yi; sa += u * u + v * v;
          u = zi + yi; v = zr - yr; sb += u * u + v * v;
          k += 1;
        );
        s[TS_PA + bi] = sa * sc;
        s[TS_PB + bi] = sb * sc;
      );
      bi += 1;
    );
  );

  // A multiband tap's bands: the median reduction of the filterbank bands
  // whose centres fall between each pair of crossovers (or the one nearest
  // the band's middle, when none do), with the tap's own fall.
  function tapMB(s) local(nk, hiC, lr, k, lo, hi, n, bi, f0, d, j, g, fc, pw, lv) (
    nk = 1 + (tap_mbx1 > 0) + (tap_mbx2 > 0) + (tap_mbx3 > 0);
    hiC = min(GRB_HI, srate * 0.45);
    lr = log(hiC / GRB_LO);
    k = 0;
    loop(4,
      k < nk ? (
        lo = k == 0 ? 0 : (k == 1 ? tap_mbx1 : (k == 2 ? tap_mbx2 : tap_mbx3));
        hi = k == nk - 1 ? 1000000 : (k == 0 ? tap_mbx1 : (k == 1 ? tap_mbx2 : tap_mbx3));
        n = 0;
        pw = 0;
        bi = 0;
        loop(GRB_N,
          f0 = GRB_LO * exp(lr * (bi + 0.5) / GRB_N);
          (f0 >= lo && f0 < hi) ? pw += s[TS_MBP + bi];
          d = s[TS_MBD + bi];
          (f0 >= lo && f0 < hi && d >= 0) ? (
            j = n;
            while (j > 0 && s[TS_SORT + j - 1] > d) (
              s[TS_SORT + j] = s[TS_SORT + j - 1];
              j -= 1;
            );
            s[TS_SORT + j] = d;
            n += 1;
          );
          bi += 1;
        );
        // its input level: the power of the filterbank bands inside it
        // (the nearest one's, for a band too narrow to hold one)
        pw <= 0 ? (
          fc = sqrt(max(lo, GRB_LO) * min(hi, hiC));
          bi = max(0, min(GRB_N - 1, floor(log(fc / GRB_LO) / lr * GRB_N)));
          pw = s[TS_MBP + bi];
        );
        lv = pw > 0.000000000000001 ? 10 * log10(pw * 2) : -150;
        s[TS_MBL + k] = max(lv, s[TS_MBL + k] - tap_lvcol);
        n < 1 ? (
          fc = sqrt(max(lo, GRB_LO) * min(hi, hiC));
          bi = max(0, min(GRB_N - 1, floor(log(fc / GRB_LO) / lr * GRB_N)));
          d = s[TS_MBD + bi];
          g = d >= 0 ? d : 0;
        ) : (
          g = (n & 1) ? s[TS_SORT + (n - 1) / 2] : (s[TS_SORT + n / 2 - 1] + s[TS_SORT + n / 2]) * 0.5;
        );
        g = min(g, 60);
        s[TS_MBG + k] = max(g, s[TS_MBG + k] - tap_rel);
      ) : (
        s[TS_MBG + k] = 0;
        s[TS_MBL + k] = -150;
      );
      k += 1;
    );
  );

  // A column's worth of one tap: per-band ratio against its baseline,
  // the median across bands, the meter's ballistics.
  function tapColumn(t) local(s, bi, pa, pb, pk, gate, r, d, n, j, g, zo, sh, gv, go, mo, snap, rb, dm, nq, pin, ind, m, e, sft) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    n = 0;
    // the bands due this column (THE TEN BANDS, BY FFT), staggered
    tapFFT(t, 0);
    (tap_col & 1) == 1 ? tapFFT(t, 1);
    (tap_col & 7) == 2 ? tapFFT(t, 2);
    // While the zero is being measured: sum each band's power for this
    // test level, and nothing else -- no baseline, no peak, no reading.
    cal_mute ? (
      cal_acc ? (
        bi = 0;
        loop(GRB_N,
          cal_ph == 1 ? (
            s[TS_AA + bi] += s[TS_PA + bi];
            s[TS_AB + bi] += s[TS_PB + bi];
          ) : (
            s[TS_BA + bi] += s[TS_PA + bi];
            s[TS_BB + bi] += s[TS_PB + bi];
          );
          bi += 1;
        );
        cal_ph == 1 ? (s[TS_NA] += 1) : (s[TS_NB] += 1);
      );
      // The make-up kept in step meanwhile, as below (MAKE-UP GAIN,
      // FOLLOWED): the zero this run finds is in today's make-up, and
      // the first column played mustn't move it again.
      rb = TV_MK[t] != s[TS_MK] || mb_seq != s[TS_MBS];
      s[TS_MK] = TV_MK[t]; s[TS_MBS] = mb_seq;
      rb && t == tap_fine - 1 ? fn_rebase = 1;
      bi = 0;
      loop(GRB_N,
        mo = mugBand(t, bi);
        dm = mo - s[TS_MO + bi];
        (rb && abs(dm) > 0.0001) ? (
          s[TS_SM + bi] -= dm; s[TS_BS + bi] -= dm; s[TS_BSA + bi] -= dm; s[TS_BSB + bi] -= dm;
          s[TS_ZERO + bi] -= dm; s[TS_ZSH + bi] -= dm; bi == 0 ? s[TS_QMZ] += dm;
        );
        s[TS_MO + bi] = mo;
        bi += 1;
      );
      s[TS_LAST] = 0;
      s[TS_DISP] = max(0, s[TS_DISP] - tap_rel);
      bi = 0; loop(4, s[TS_MBG + bi] = max(0, s[TS_MBG + bi] - tap_rel); bi += 1; );
    ) : (
    zo = s[TS_HASCAL] > 0.5;
    sh = zo && s[TS_CST] == 4 && s[TS_STALE] < 0.5;   // shut on the test signal
    gv = 0; go = 0; nq = 0; pin = 0;
    snap = (tap_col & 31) == 0;
    // what's taken out changed, not the audio (MAKE-UP GAIN, FOLLOWED)
    rb = TV_MK[t] != s[TS_MK] || mb_seq != s[TS_MBS];
    s[TS_MK] = TV_MK[t]; s[TS_MBS] = mb_seq;
    rb && t == tap_fine - 1 ? fn_rebase = 1;
    s[TS_QMH] > 0 ? s[TS_QMH] -= 1;
    bi = 0;
    loop(GRB_N,
      mo = mugBand(t, bi);
      dm = mo - s[TS_MO + bi];
      abs(dm) > 0.0001 ? (
        !rb ? s[TS_QMH] = tap_qmh;
        rb ? (
          // all of it moved with what's taken out
          s[TS_SM + bi] -= dm; s[TS_BS + bi] -= dm; s[TS_BSA + bi] -= dm; s[TS_BSB + bi] -= dm;
          s[TS_ZERO + bi] -= dm; s[TS_ZSH + bi] -= dm; bi == 0 ? s[TS_QMZ] += dm;
        ) : abs(dm) > 0.05 && s[TS_HB + bi] > 0.5 ? (
          // the make-up moved: the baseline goes back to before a ratio
          // could have climbed on it, or is learnt again
          s[TS_HBA + bi] < 64 ? s[TS_HB + bi] = 0 : (
            s[TS_BS + bi] = min(s[TS_BS + bi], s[TS_BSB + bi]);
            s[TS_BSA + bi] = min(s[TS_BSA + bi], s[TS_BS + bi]);
          );
        );
        s[TS_MO + bi] = mo;
      );
      snap ? ( s[TS_BSB + bi] = s[TS_BSA + bi]; s[TS_BSA + bi] = s[TS_BS + bi]; );
      s[TS_HB + bi] > 0.5 ? s[TS_HBA + bi] = min(s[TS_HBA + bi] + 1, 100000);
      pa = s[TS_PA + bi];
      pb = s[TS_PB + bi];
      pin += pa;
      s[TS_MBP + bi] = pa;
      pk = max(pa, s[TS_PK + bi] * tap_pkdec);
      s[TS_PK + bi] = pk;
      gate = max(0.000000001, pk * 0.00001);          // -90 dB, and 50 dB under the band's peak
      s[TS_MBD + bi] = -1;
      (s[TS_HOLD] <= 0 && pa > gate && pb > 0.00000000000001) ? (
        r = 10 * log10(pb / pa) - mo;
        s[TS_HB + bi] < 0.5 ? (
          s[TS_SM + bi] = r; s[TS_BS + bi] = r; s[TS_HB + bi] = 1;
          s[TS_BSA + bi] = s[TS_BSB + bi] = r; s[TS_HBA + bi] = 0;
        ) : (
          s[TS_SM + bi] += (r - s[TS_SM + bi]) * TAP_SMOOTH;
          s[TS_SM + bi] > s[TS_BS + bi]
            ? s[TS_BS + bi] += (s[TS_SM + bi] - s[TS_BS + bi]) * TAP_RISE
            : s[TS_BS + bi] -= tap_dec;
        );
        // the measured zero where there is one, the music's baseline where not
        d = max(0, ((zo && s[TS_ZV + bi] > 0.5) ? s[TS_ZERO + bi] : s[TS_BS + bi]) - s[TS_SM + bi]);
        s[TS_MBD + bi] = d;
        // how far over its zero (THE ZERO, KEPT ON THE MUSIC), sorted
        (zo && s[TS_ZV + bi] > 0.5) ? (
          e = s[TS_SM + bi] - s[TS_ZERO + bi];
          j = nq;
          while (j > 0 && s[TS_ZQ + j - 1] > e) ( s[TS_ZQ + j] = s[TS_ZQ + j - 1]; j -= 1; );
          s[TS_ZQ + j] = e;
          nq += 1;
        );
        // shut on the test signal: open now, by GATE_OPEN or more?
        (sh && s[TS_ZSV + bi] > 0.5) ? ( gv += 1; s[TS_SM + bi] - s[TS_ZSH + bi] >= GATE_OPEN ? go += 1; );
        // insertion into the sorted scratch
        j = n;
        while (j > 0 && s[TS_SORT + j - 1] > d) (
          s[TS_SORT + j] = s[TS_SORT + j - 1];
          j -= 1;
        );
        s[TS_SORT + j] = d;
        n += 1;
      );
      bi += 1;
    );
    g = n < 1 ? 0 : ((n & 1) ? s[TS_SORT + (n - 1) / 2]
                             : (s[TS_SORT + n / 2 - 1] + s[TS_SORT + n / 2]) * 0.5);
    // The measured zero, checked against the music (THE ZERO, KEPT ON
    // THE MUSIC): a steady stretch over it moves it up; a steady quiet
    // one under it, since a touch, moves it down.
    ind = pin > 0.000000000000001 ? 10 * log10(pin) : -150;
    s[TS_QIP] = max(ind, s[TS_QIP] - tap_qfall);
    (zo && !sh && nq >= 4 && s[TS_HOLD] <= 0 && s[TS_QMH] <= 0 && TV_MUG[t] >= s[TS_QMZ] - Q_MUGDROP) ? (
      m = (nq & 1) ? s[TS_ZQ + (nq - 1) / 2] : (s[TS_ZQ + nq / 2 - 1] + s[TS_ZQ + nq / 2]) * 0.5;
      (s[TS_QN] > 0 && max(m, s[TS_QHI]) - min(m, s[TS_QLO]) < Q_SPAN) ? (
        s[TS_QN] += 1; s[TS_QS] += m; s[TS_QIS] += ind;
        s[TS_QLO] = min(m, s[TS_QLO]); s[TS_QHI] = max(m, s[TS_QHI]);
        ind > s[TS_QIP] - Q_QUIET ? s[TS_QQ] = 0;
      ) : (
        s[TS_QN] = 1; s[TS_QS] = m; s[TS_QIS] = ind; s[TS_QLO] = s[TS_QHI] = m;
        s[TS_QQ] = ind <= s[TS_QIP] - Q_QUIET;
      );
      s[TS_QM] = m;
      s[TS_QN] >= Q_COLS ? (
        e = s[TS_QS] / s[TS_QN];
        sft = 0;
        (s[TS_STALE] > 0.5 && s[TS_QQ] > 0.5 && s[TS_QRV] > 0.5) ? (
          // touched: the quiet stretches go back to where they sat before
          abs(e - s[TS_QR]) > Q_TOL ? sft = (e - s[TS_QR]) * Q_STEP;
          sft > 0 ? ( s[TS_QUL] = s[TS_QIS] / s[TS_QN]; s[TS_QUM] = s[TS_QR]; );
        ) : e > Q_TOL ? ( sft = e * Q_STEP; s[TS_QUL] = s[TS_QIS] / s[TS_QN]; s[TS_QUM] = 0; );
        (s[TS_STALE] < 0.5 && s[TS_QQ] > 0.5) ? (
          s[TS_QR] = s[TS_QRV] > 0.5 ? s[TS_QR] + (e - sft - s[TS_QR]) * Q_REF : e - sft;
          s[TS_QRV] = 1;
        );
        // the highest steady stretch lately (touched, the zero moved up), of
        // those no louder than the one that last moved it up: no more
        // compressed than that one was, so under the zero it's the gain
        s[TS_QIS] / s[TS_QN] <= s[TS_QUL] + 1 ? (
          s[TS_QWM] = s[TS_QWN] > 0 ? max(s[TS_QWM], e - sft) : e - sft;
          s[TS_QWN] += 1;
        );
        sft != 0 ? ( bi = 0; loop(GRB_N, s[TS_ZERO + bi] += sft; bi += 1; ); s[TS_QUP] += sft; );
        s[TS_QN] = 0;
      );
    ) : s[TS_QN] = 0;
    // Touched, with the zero moved up by the music since it was measured:
    // when even the highest steady stretch over Q_WIN, no louder than the
    // one that moved it up, sits under where that one was put (TS_QUM),
    // the gain came back down. It goes back towards the measured zero, never
    // past it -- so a compressor that never lets go reads no lower than it
    // did before the music moved it.
    (zo && !sh && s[TS_STALE] > 0.5 && s[TS_QUP] > Q_TOL && s[TS_QMH] <= 0 && TV_MUG[t] >= s[TS_QMZ] - Q_MUGDROP) ? (
      s[TS_QWT] += 1;
      s[TS_QWT] >= tap_qwin ? (
        (s[TS_QWN] >= 3 && s[TS_QWM] < s[TS_QUM] - Q_TOL) ? (
          sft = max((s[TS_QWM] - s[TS_QUM]) * Q_STEP, -s[TS_QUP]);
          bi = 0; loop(GRB_N, s[TS_ZERO + bi] += sft; bi += 1; );
          s[TS_QUP] += sft;
        );
        s[TS_QWT] = 0; s[TS_QWN] = 0;
      );
    ) : ( s[TS_QWT] = 0; s[TS_QWN] = 0; );
    // Shut on the test signal and seen open on the music: a gate (or
    // expander) for certain -- a plugin just turned down never opens.
    (sh && s[TS_GATE] < 0.5 && gv >= 3 && go * 2 >= gv) ? (
      s[TS_GOPEN] += 1;
      s[TS_GOPEN] >= GATE_COLS ? s[TS_GATE] = 1;
    );
    // A gate for certain, and nothing coming in: it's shut. Its closed
    // reading held: how far its shut level sits under the music's
    // baseline, median across bands.
    (n < 1 && sh && s[TS_GATE] > 0.5) ? (
      bi = 0;
      loop(GRB_N,
        (s[TS_HB + bi] > 0.5 && s[TS_ZSV + bi] > 0.5) ? (
          d = max(0, s[TS_BS + bi] - s[TS_ZSH + bi]);
          j = n;
          while (j > 0 && s[TS_SORT + j - 1] > d) ( s[TS_SORT + j] = s[TS_SORT + j - 1]; j -= 1; );
          s[TS_SORT + j] = d;
          n += 1;
        );
        bi += 1;
      );
      g = n < 1 ? 0 : ((n & 1) ? s[TS_SORT + (n - 1) / 2]
                               : (s[TS_SORT + n / 2 - 1] + s[TS_SORT + n / 2]) * 0.5);
    );
    g = min(g, 60);
    s[TS_LAST] = g;
    // (a gate for certain: the reading follows it, opening as fast as it
    // shuts, rather than falling away from closed at the meter's release)
    (sh && s[TS_GATE] > 0.5) ? s[TS_DISP] = g : s[TS_DISP] = max(g, s[TS_DISP] - tap_rel);
    t == tap_mb - 1 ? tapMB(s);
    );
  );

  // A new run: what earlier runs summed is dropped. The zero in use stays
  // until this run proves a better one.
  function calClear() local(t, s, i) (
    t = 0;
    loop(TAP_MAX,
      s = TAP_BASE + t * TAP_STRIDE + TAP_S;
      i = TS_AA; loop(TS_ZERO - TS_AA, s[i] = 0; i += 1; );
      s[TS_NA] = 0; s[TS_NB] = 0;
      t += 1;
    );
  );

  // A run finished: each band's zero is the higher of its two levels'
  // ratios (a release still finishing, or a gate, only ever pulls a ratio
  // DOWN). Adopted when enough bands had signal; otherwise the old zero
  // stays. Returns 1 when adopted.
  function calCommit(t) local(s, bi, na, nb, va, vb, za, zb, n, m, j, d, ni, zmax) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    na = s[TS_NA]; nb = s[TS_NB];
    n = 0; m = 0; ni = 0; zmax = -1000;
    bi = 0;
    loop(GRB_N,
      va = na >= CAL_MINCOL && s[TS_AA + bi] > 0.000000000001 * na && s[TS_AB + bi] > 0.00000000000001 * na;
      vb = nb >= CAL_MINCOL && s[TS_BA + bi] > 0.000000000001 * nb && s[TS_BB + bi] > 0.00000000000001 * nb;
      // (the test signal got in, whatever came out)
      ((na >= CAL_MINCOL && s[TS_AA + bi] > 0.000000000001 * na) ||
       (nb >= CAL_MINCOL && s[TS_BA + bi] > 0.000000000001 * nb)) ? ni += 1;
      // (the make-up taken out, as from every ratio: MAKE-UP GAIN, FOLLOWED)
      va ? (za = 10 * log10(s[TS_AB + bi] / s[TS_AA + bi]) - mugBand(t, bi));
      vb ? (zb = 10 * log10(s[TS_BB + bi] / s[TS_BA + bi]) - mugBand(t, bi));
      (va || vb) ? (
        s[TS_ZT + bi] = (va && vb) ? max(za, zb) : (va ? za : zb);
        s[TS_ZTV + bi] = 1;
        zmax = max(zmax, s[TS_ZT + bi]);
        n += 1;
        (va && vb) ? (
          d = zb - za;
          j = m;
          while (j > 0 && s[TS_SORT + j - 1] > d) (
            s[TS_SORT + j] = s[TS_SORT + j - 1];
            j -= 1;
          );
          s[TS_SORT + j] = d;
          m += 1;
        );
      ) : (s[TS_ZTV + bi] = 0);
      bi += 1;
    );
    s[TS_GATE] = 0; s[TS_GOPEN] = 0;
    // Cut hard in every band, or to nothing: shut on the test signal (a
    // gate, an expander -- or a plugin turned right down). That's no zero:
    // the music's baseline is used, and its shut level kept, to tell a
    // gate for certain once it opens (THE ZERO POINT).
    ((n >= CAL_MINBANDS && zmax < CAL_SHUT) || (n < CAL_MINBANDS && ni >= CAL_MINBANDS)) ? (
      bi = 0;
      loop(GRB_N,
        s[TS_ZV + bi] = 0;
        s[TS_ZSH + bi] = s[TS_ZTV + bi] > 0.5 ? s[TS_ZT + bi] : -150;
        s[TS_ZSV + bi] = 1;
        bi += 1;
      );
      s[TS_HASCAL] = 1;
      s[TS_STALE] = 0;
      s[TS_CST] = 4;
      s[TS_QMZ] = TV_MUG[t];
      1;
    ) : n >= CAL_MINBANDS ? (
      bi = 0;
      loop(GRB_N,
        s[TS_ZERO + bi] = s[TS_ZT + bi];
        s[TS_ZV + bi] = s[TS_ZTV + bi];
        s[TS_ZSV + bi] = 0;
        bi += 1;
      );
      d = m < 1 ? 0 : ((m & 1) ? s[TS_SORT + (m - 1) / 2]
                                : (s[TS_SORT + m / 2 - 1] + s[TS_SORT + m / 2]) * 0.5);
      s[TS_HASCAL] = 1;
      s[TS_STALE] = 0;
      s[TS_QRV] = 0; s[TS_QN] = 0; s[TS_QUP] = 0; s[TS_QWN] = 0; s[TS_QWT] = 0;
      s[TS_QMZ] = TV_MUG[t];
      s[TS_CST] = (m >= 3 && abs(d) > 1) ? 2 : 1;
      1;
    ) : 0;
  );

  function calState(t) local(s) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    s[TS_HASCAL] < 0.5 ? 0 : (s[TS_STALE] > 0.5 ? 3 : (s[TS_CST] == 4 && s[TS_GATE] > 0.5 ? 5 : s[TS_CST]));
  );

  function tapReading(t) ( (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_DISP]; );

  // Whether tap t is in use and measuring gain reduction (not levels only).
  function tapIsGR(t) ( t < tap_cfg && ((tap_nogr >> t) & 1) == 0; );

  // One sample of one tap's levels: before L/R, after L/R.
  function tapLevels(t, bl, br, al, ar) local(s, v) (
    s = TAP_BASE + t * TAP_STRIDE + TAP_S;
    v = max(abs(bl), abs(br)); s[TS_LIP] = max(v, s[TS_LIP] * tap_lvpk);
    v = max(abs(al), abs(ar)); s[TS_LOP] = max(v, s[TS_LOP] * tap_lvpk);
    s[TS_LIR] += ((bl * bl + br * br) * 0.5 - s[TS_LIR]) * tap_lvrk;
    s[TS_LOR] += ((al * al + ar * ar) * 0.5 - s[TS_LOR]) * tap_lvrk;
    // and each channel apart (LEVELS PER CHANNEL)
    s[TS_LCP] = max(abs(bl), s[TS_LCP] * tap_lvpk); s[TS_LCP + 1] = max(abs(br), s[TS_LCP + 1] * tap_lvpk);
    s[TS_LCP + 2] = max(abs(al), s[TS_LCP + 2] * tap_lvpk); s[TS_LCP + 3] = max(abs(ar), s[TS_LCP + 3] * tap_lvpk);
    s[TS_LCR] += (bl * bl - s[TS_LCR]) * tap_lvrk; s[TS_LCR + 1] += (br * br - s[TS_LCR + 1]) * tap_lvrk;
    s[TS_LCR + 2] += (al * al - s[TS_LCR + 2]) * tap_lvrk; s[TS_LCR + 3] += (ar * ar - s[TS_LCR + 3]) * tap_lvrk;
  );

  // dBFS to a tenth, -150 for silence. `ms` is a mean square.
  function lvAmp(x) ( x > 0.0000000316 ? floor(200 * log10(x) + 0.5) / 10 : -150; );
  function lvMS(ms) ( ms > 0.000000000000001 ? floor(100 * log10(ms) + 0.5) / 10 : -150; );
  function lvGet(t, k) ( t < tap_cfg ? (TAP_BASE + t * TAP_STRIDE + TAP_S)[k] : 0; );
  // A tap's levels per channel into this track's place, or silence.
  function tapLevelsLR(t, quiet) local(b, k) (
    (role == 1 && pl_tr >= -1 && pl_tr + 1 < PLV_TRACKS) ? (
      b = PLV_BASE + (pl_tr + 1) * PLV_STRIDE + t * 8;
      k = 0;
      loop(4,
        gmem[b + k] = quiet ? -150 : lvAmp(lvGet(t, TS_LCP + k));
        gmem[b + 4 + k] = quiet ? -150 : lvMS(lvGet(t, TS_LCR + k));
        k += 1;
      );
    );
  );

  tapBands();

  // Where this probe is and what it has been told: its track's block,
  // its place, and so its role (-1 nobody has named it). Every block.
  function readControl() local(me, k, r, v) (
    pl_tr = get_host_placement(pl_pos, pl_fl);
    pb = (pl_tr >= -1 && pl_tr < PB_TRACKS - 1) ? PB_BASE + (pl_tr + 1) * PB_STRIDE : -1;
    pb_blocks += 1;
    r = -1;
    pb >= 0 ? (
      me = pl_pos + 1;
      k = me % 8;
      gmem[pb + PB_SEEN + k] = me;
      gmem[pb + PB_SEENN + k] = pb_blocks;
      gmem[pb + PB_PRE] == me ? r = 0
      : gmem[pb + PB_POST] == me ? r = (gmem[pb + PB_CMP] >= 0.5 ? 2 : 1);
    );
    role = r;
    role == 0 ? (
      gmem[pb + PB_ACKPRE] = pb_blocks;
      publish = gmem[pb + PB_PUBPRE];
      vis_slot = gmem[pb + PB_VISPRE] - 1;
      cal_arm = gmem[pb + PB_ARM];
    ) : role > 0 ? (
      gmem[pb + PB_ACKPOST] = pb_blocks;
      publish = gmem[pb + PB_PUBPOST];
      vis_slot = gmem[pb + PB_VISPOST] - 1;
      cal_arm = 0;
    ) : (
      publish = 0; vis_slot = -1; cal_arm = 0;
    );
    vis_include = vis_slot >= 0;
    // the taps' settings: the post probe's
    role == 1 ? (
      tap_n = gmem[pb + PB_TAPN];
      k = 0;
      loop(TAP_MAX,
        TV_LAG[k] = gmem[pb + pbAt(PB_LAG, PB_LAG2, k)];
        TV_RST[k] = gmem[pb + pbAt(PB_RST, PB_RST2, k)];
        v = gmem[pb + pbAt(PB_MUG, PB_MUG2, k)];
        r = floor((v + 500) / 1000);
        TV_MK[k] = r;
        TV_MUG[k] = max(-150, min(60, v - 1000 * r));
        k += 1;
      );
      k = 0;
      loop(4,
        v = gmem[pb + (k < 2 ? PB_MBMUG + k : PB_MBMUG2 + k - 2)];
        r = floor((v + 500) / 1000);
        r != MB_MK[k] ? ( MB_MK[k] = r; mb_seq += 1; );
        MB_MUG[k] = max(-150, min(60, v - 1000 * r));
        k += 1;
      );
      tap_gen = gmem[pb + PB_GEN];
      tap_nogr = gmem[pb + PB_NOGR];
      tap_mb = gmem[pb + PB_MB];
      tap_mbx1 = gmem[pb + PB_MBX]; tap_mbx2 = gmem[pb + PB_MBX + 1]; tap_mbx3 = gmem[pb + PB_MBX + 2];
      // a new split: what's taken out changed, not the audio
      (tap_mb != mbp_t || tap_mbx1 != mbp_1 || tap_mbx2 != mbp_2 || tap_mbx3 != mbp_3) ? (
        mbp_t = tap_mb; mbp_1 = tap_mbx1; mbp_2 = tap_mbx2; mbp_3 = tap_mbx3;
        mb_seq += 1;
      );
      tap_fine = gmem[pb + PB_FINE];
      tap_watch = gmem[pb + PB_WATCH];
      tap_st = gmem[pb + PB_ST];
      cvs_v = gmem[pb + PB_CVSPEC];
    ) : (
      // (the post probe while Track Analyser compares against this track:
      // still asked for ChannelView's spectrum)
      cvs_v = role == 2 ? gmem[pb + PB_CVSPEC] : cvs_last;
      tap_n = 0; tap_mb = 0; tap_fine = 0; tap_watch = 0; tap_st = 0;
      k = 0; loop(TAP_MAX, TV_MUG[k] = 0; k += 1; );
      k = 0; loop(4, MB_MUG[k] = 0; k += 1; );
    );
    // Track Analyser's spectrum release
    v = gmem[CTRL_REL];
    (v < 50 || v > 2000) ? v = 400;
    v != rel_ms ? ( rel_ms = v; fftsz > 0 ? setBallistics(); );
  );

  // What the post probe has to say, into its block.
  function writeReadings() local(k) (
    (role == 1 && pb >= 0) ? (
      k = 0;
      loop(TAP_MAX,
        gmem[pb + pbAt(PB_GR, PB_GR2, k)] = TV_GR[k];
        gmem[pb + pbAt(PB_CAL, PB_CAL2, k)] = TV_CAL[k];
        gmem[pb + pbAt(PB_INPK, PB_INPK2, k)] = TV_INPK[k];
        gmem[pb + pbAt(PB_OUTPK, PB_OUTPK2, k)] = TV_OUTPK[k];
        gmem[pb + pbAt(PB_INRMS, PB_INRMS2, k)] = TV_INRMS[k];
        gmem[pb + pbAt(PB_OUTRMS, PB_OUTRMS2, k)] = TV_OUTRMS[k];
        k += 1;
      );
      gmem[pb + PB_CAP] = TAP_MAX;
      gmem[pb + PB_MBGR] = tap_mbgr1; gmem[pb + PB_MBGR + 1] = tap_mbgr2;
      gmem[pb + PB_MBGR + 2] = tap_mbgr3; gmem[pb + PB_MBGR + 3] = tap_mbgr4;
      gmem[pb + PB_MBL] = tap_mbl1; gmem[pb + PB_MBL + 1] = tap_mbl2;
      gmem[pb + PB_MBL + 2] = tap_mbl3; gmem[pb + PB_MBL + 3] = tap_mbl4;
      gmem[pb + PB_CORR] = stc_corr; gmem[pb + PB_STM] = stc_mdb; gmem[pb + PB_STS] = stc_sdb;
      gmem[pb + PB_STCAP] = 1;
      gmem[pb + PB_MUGCAP] = 1;
      gmem[pb + PB_RSEQ] += 1;
    );
  );

@block

  readControl();
  // (not publishing for Track Analyser: a block of its own, A SPECTRUM
  // PER TRACK)
  base = publish < 0.5 ? SINK_BASE : role < 0.5 ? PRE_BASE : (role < 1.5 ? POST_BASE : CMP_BASE);
  // ChannelView wants this track's spectrum while field 127 moves
  cvs_v != cvs_last ? ( cvs_last = cvs_v; cvs_age = 0; ) : cvs_age += samplesblock;
  // (2: the post probe while Track Analyser compares against this track)
  cv_active = (role == 1 || role == 2) && cvs_last != 0 && cvs_age < srate && pl_tr >= -1 && pl_tr + 1 < CVS_TRACKS;
  cbase = CVS_BASE + (pl_tr + 1) * CVS_STRIDE;
  // ChannelView listening to a band (LISTENING TO A BAND)
  lsn_ok = (role == 1 || role == 2) && pl_tr >= -1 && pl_tr + 1 < CVS_TRACKS;
  lsn_hb = lsn_ok ? gmem[cbase + 8] : 0;
  lsn_hb != lsn_last ? ( lsn_last = lsn_hb; lsn_age = 0; ) : lsn_age += samplesblock;
  lsn_on = lsn_ok && lsn_last != 0 && lsn_age < srate * 0.25 && gmem[cbase + 6] > 0;
  lsn_on ? (
    lsn_nf = max(10, min(gmem[cbase + 6], srate * 0.45));
    lsn_nq = max(0.1, min(gmem[cbase + 7], 40));
    lsn_nk = gmem[cbase + 9];
    (lsn_nf != lsn_f || lsn_nq != lsn_q || lsn_nk != lsn_k) ? (
      lsn_f = lsn_nf; lsn_q = lsn_nq; lsn_k = lsn_nk;
      lsn_w = 2 * $pi * lsn_f / srate; lsn_c = cos(lsn_w);
      lsn_k == 0 ? (
        lsn_al = sin(lsn_w) / (2 * lsn_q);
        lsn_b0 = lsn_al; lsn_b1 = 0; lsn_b2 = -lsn_al;
      ) : (
        lsn_al = sin(lsn_w) / (2 * 0.7071);
        lsn_k == 1 ? ( lsn_b0 = (1 - lsn_c) / 2; lsn_b1 = 1 - lsn_c; )
                   : ( lsn_b0 = (1 + lsn_c) / 2; lsn_b1 = -(1 + lsn_c); );
        lsn_b2 = lsn_b0;
      );
      lsn_a0 = 1 + lsn_al;
      lsn_b0 /= lsn_a0; lsn_b1 /= lsn_a0; lsn_b2 /= lsn_a0;
      lsn_a1 = -2 * lsn_c / lsn_a0; lsn_a2 = (1 - lsn_al) / lsn_a0;
    );
  );
  lsn_inc = 1 / (0.01 * srate);

  // vis_slot is a real 0..15 claim only while TS_Visualizer is watching
  // this instance; -1 means "not right now". Like Track Analyser's own
  // Publish, it gates everything on "is anything reading this".
  vis_active = vis_include >= 0.5 && vis_slot >= 0 && vis_slot < VIS_MAX_SLOTS;

  // A track the Visualizer is watching runs its own FFT/band pipeline
  // whether or not Track Analyser's panel is pointed at it: the
  // Visualizer watches several tracks at once, where Track Analyser's
  // Publish arms one pair at a time, driven by panel selection. The
  // Visualizer path does not touch Publish and is not touched by it.
  active = role >= 0 && (publish >= 0.5 || vis_active || cv_active);

  active ? (
    // What size does the panel want? Fall back to something sane if it has
    // not said, or has said something silly.
    want = gmem[CTRL_FFT];
    (want != 256 && want != 512 && want != 1024 && want != 2048 && want != 4096) ? want = 2048;

    wantslice = gmem[CTRL_SLICE];
    (wantslice < 8 || wantslice > srate) ? wantslice = max(8, floor(srate * 0.002));

    (want != fftsz || wantslice != slice) ? reconfigure(want, wantslice);

    ep = gmem[CTRL_EPOCH];
    ep != last_epoch ? ( last_epoch = ep; restart(); gmem[base + H_EPOCHACK] = ep; );

    // 1 = accumulate for one capture, 2 = keep a running average so a panel
    // can watch the response change while knobs move.
    measmode = gmem[CTRL_MEAS];
    meas = measmode > 0.5;
    live = measmode > 1.5;
    measmode != last_meas ? ( last_meas = measmode; clearAvg(); );

    smoo_oct = gmem[CTRL_SMOO];
    (smoo_oct < 0 || smoo_oct > 2) ? smoo_oct = 0;

    // THE DELAY. The FX between the probes cost this many samples, so the
    // post probe is seeing what the pre probe saw that long ago. REAPER
    // compensates PDC at the track OUTPUT, not inside a chain, so nothing
    // has put this right before it reaches us. Only the pre probe delays --
    // the post probe is the one already late.
    wantlag = gmem[CTRL_LAG];
    (wantlag < 0 || wantlag > DLY_MAX) ? wantlag = 0;
    setLag(role < 0.5 ? wantlag : 0);

    grbon = gmem[CTRL_GRB] > 0.5;

    tau_s = gmem[CTRL_TAU] * 0.001;
    (tau_s < 0.05 || tau_s > 30) ? tau_s = 1.0;
    avg_k = 1 - exp(-1 * (hop / srate) / tau_s);

    blocks += 1;
    gmem[base + H_SRATE]  = srate;
    gmem[base + H_NBINS]  = nbins;
    gmem[base + H_FFTSZ]  = fftsz;
    gmem[base + H_SLICE]  = slice;
    gmem[base + H_COLS]   = SCOPE_COLS;
    gmem[base + H_BLOCKS] = blocks;
    gmem[base + H_ROLE]   = role;
    gmem[base + H_NCH]    = num_ch;
    gmem[base + H_BANDN]  = BANDS;
    gmem[base + H_BANDLO] = BAND_LO;
    gmem[base + H_BANDHI] = BAND_HI;
    gmem[base + H_GRBN]   = grbon ? GRB_N : 0;
    gmem[base + H_GRBLO]  = GRB_LO;
    gmem[base + H_GRBHI]  = min(GRB_HI, srate * 0.45);
    gmem[base + H_LAG]    = lagn;

    // Visualizer bridge header. Only touches VIS_SLOT_BASE, never this
    // instance's own PRE/POST/CMP block above -- Track Analyser's panel
    // reads that block and must never see a value change because a
    // different tool claimed a slot.
    cv_active ? (
      gmem[cbase + 1] = BANDS; gmem[cbase + 2] = BAND_LO;
      gmem[cbase + 3] = BAND_HI; gmem[cbase + 4] = fftsz;
      gmem[cbase + 5] = pl_tr + 2;
    );
    vis_active ? (
      vbase = VIS_SLOT_BASE + vis_slot * VIS_SLOT_STRIDE;
      vis_slot != vis_slotn ? (
        // Slot just claimed (or moved): the header at the new address
        // needs writing now, not on the next FFT frame, or a caller
        // reading it in between sees whatever the previous occupant of
        // this slot left behind.
        vis_slotn = vis_slot;
        gmem[vbase + VIS_H_BANDN] = BANDS;
        gmem[vbase + VIS_H_BANDLO] = BAND_LO;
        gmem[vbase + VIS_H_BANDHI] = min(BAND_HI, srate * 0.45);
        gmem[vbase + VIS_H_FFTSZ] = fftsz;
      );
    ) : (
      vis_slotn = -2;   // dropped (the Visualizer let go of the slot) --
                        // forces a fresh header write if it comes back,
                        // rather than trusting stale state
    );
  );

  //-- the taps -----------------------------------------------------------
  // Post probe only, and only while a reader keeps gmem[73] moving: three
  // seconds without a change and the taps stop, so a project with nothing
  // open to read them pays nothing.
  hb = gmem[CTRL_TAPHB];
  hb != hb_last ? ( hb_last = hb; hb_age = 0; ) : hb_age += samplesblock;
  tap_cfg  = (role >= 0.5 && role < 1.5) ? max(0, min(TAP_MAX, floor(tap_n))) : 0;
  tap_live = tap_cfg > 0 && hb_age < srate * 3;
  // on screen (ONLY THE TRACKS ON SCREEN), or measuring the zero
  tap_watch != watch_last ? ( watch_last = tap_watch; watch_age = 0; ) : watch_age += samplesblock;
  gate_v = gmem[CTRL_GATE];
  gate_v != gate_last ? ( gate_last = gate_v; gate_age = 0; ) : gate_age += samplesblock;
  tap_seen = gate_age >= srate * 3 || watch_age < srate || publish >= 0.5;
  tap_run = tap_live && (tap_seen || cal_ph > 0);
  // the third-octave tap: set up afresh when it's another tap, or a new rate
  (tap_fine != fn_tap || fn_sr != srate) ? ( fn_tap = tap_fine; fineSetup(); );
  tap_live ? (
    tap_sr != srate ? ( tapBands(); t = 0; loop(TAP_MAX, tapReset(t); t += 1; ); );
    // A bumped relearn counter drops what that tap has learnt: ChannelView
    // bumps it when the plugin is touched, so a new make-up gain is found
    // again rather than read as reduction.
    t = 0;
    loop(TAP_MAX,
      setTapLag(t, TV_LAG[t]);
      ts = TAP_BASE + t * TAP_STRIDE + TAP_S;
      ts[TS_RST] != TV_RST[t] ? ( tapReset(t); ts[TS_RST] = TV_RST[t];
        ts[TS_HASCAL] > 0.5 ? ts[TS_STALE] = 1; );
      t += 1;
    );
  );
  // the stereo tap: started afresh when it's another one
  tap_st != stc_was ? (
    stc_was = tap_st;
    stc_ll = stc_rr = stc_lr = stc_mm = stc_ss = 0;
    memset(STR_RING, 0, STP_N * 2);
  );
  stc_dec = max(1, floor(srate / 24000 + 0.5));
  // The readings, every block: a tap not in use, or not running, reads 0.
  t = 0; loop(TAP_MAX, TV_GR[t] = (tap_run && tapIsGR(t)) ? tapReading(t) : 0; t += 1; );
  // a multiband tap's bands, the same way
  mbs = (tap_mb >= 1 && tap_mb <= TAP_MAX && tap_run && tapIsGR(tap_mb - 1)) ? TAP_BASE + (tap_mb - 1) * TAP_STRIDE + TAP_S : 0;
  m1 = mbs ? mbs[TS_MBG] : 0;     m2 = mbs ? mbs[TS_MBG + 1] : 0;
  m3 = mbs ? mbs[TS_MBG + 2] : 0; m4 = mbs ? mbs[TS_MBG + 3] : 0;
  (m1 != tap_mbgr1 || m2 != tap_mbgr2 || m3 != tap_mbgr3 || m4 != tap_mbgr4) ? (
    tap_mbgr1 = m1; tap_mbgr2 = m2; tap_mbgr3 = m3; tap_mbgr4 = m4;
  );
  // and its bands' input levels, to a tenth of a dB
  m1 = mbs ? floor(max(-150, mbs[TS_MBL]) * 10 + 0.5) / 10 : -150;
  m2 = mbs ? floor(max(-150, mbs[TS_MBL + 1]) * 10 + 0.5) / 10 : -150;
  m3 = mbs ? floor(max(-150, mbs[TS_MBL + 2]) * 10 + 0.5) / 10 : -150;
  m4 = mbs ? floor(max(-150, mbs[TS_MBL + 3]) * 10 + 0.5) / 10 : -150;
  // (with the other levels, about thirty times a second)
  (!mbs || tap_lvc == 0) && (m1 != tap_mbl1 || m2 != tap_mbl2 || m3 != tap_mbl3 || m4 != tap_mbl4) ? (
    tap_mbl1 = m1; tap_mbl2 = m2; tap_mbl3 = m3; tap_mbl4 = m4;
  );
  // The levels, about thirty times a second while a reader is alive and
  // the track on screen; silence once, when either goes away.
  tap_run ? (
    tap_lvdead = 0;
    tap_lvc += samplesblock;
    tap_lvc >= tap_lvn ? (
      tap_lvc = 0;
      t = 0;
      loop(TAP_MAX,
        TV_INPK[t] = lvAmp(lvGet(t, TS_LIP)); TV_OUTPK[t] = lvAmp(lvGet(t, TS_LOP));
        TV_INRMS[t] = lvMS(lvGet(t, TS_LIR)); TV_OUTRMS[t] = lvMS(lvGet(t, TS_LOR));
        tapLevelsLR(t, t >= tap_cfg);
        t += 1;
      );
      // the stereo tap's, and its scope when this track writes it
      (tap_st >= 1 && tap_st <= tap_cfg) ? (
        stc_corr = (stc_ll > 0.000000000001 && stc_rr > 0.000000000001)
          ? floor(stc_lr / sqrt(stc_ll * stc_rr) * 1000 + 0.5) / 1000 : 0;
        stc_mdb = lvMS(stc_mm); stc_sdb = lvMS(stc_ss);
        gmem[CTRL_STTRK] == pl_tr + 2 ? (
          stc_i = 0;
          loop(STP_N,
            stc_k = ((stc_pos + stc_i) % STP_N) * 2;
            gmem[STP_BASE + stc_i * 2] = STR_RING[stc_k];
            gmem[STP_BASE + stc_i * 2 + 1] = STR_RING[stc_k + 1];
            stc_i += 1;
          );
          gmem[STH_BASE + 1] = STP_N; gmem[STH_BASE + 2] = pl_tr + 2;
          stc_seq += 1; gmem[STH_BASE] = stc_seq;
        );
      ) : (
        stc_corr = 0; stc_mdb = stc_sdb = -150;
      );
      lvChanged = 1;
    );
  ) : (tap_lvdead == 0 ? (
    tap_lvdead = 1;
    t = 0; loop(TAP_MAX, TV_INPK[t] = TV_OUTPK[t] = TV_INRMS[t] = TV_OUTRMS[t] = -150; tapLevelsLR(t, 1); t += 1; );
    stc_corr = 0; stc_mdb = stc_sdb = -150;
    lvChanged = 1;
  ));
  lvChanged ? (
    lvChanged = 0;
  );

  (active && tap_cfg > 0) ? (
    gmem[TAPTR_HDR] = tap_run ? tap_cfg : 0;
    t = 0; loop(TAP_MAX, gmem[TAPTR_HDR + 1 + t] = TV_GR[t]; t += 1; );
    gmem[TAPTR_HDR + 9] = TAPTR_BASE2;
  );

  //-- measuring the zero (THE ZERO POINT) ----------------------------------
  // The two probes of a track meet at CAL_BASE + its index * CAL_STRIDE.
  // Nothing for the master (-1) or the monitoring chain (-2).
  cal_slot = -1;
  cal_pl = get_host_placement();
  (cal_pl >= 0 && cal_pl < CAL_SLOTS) ? cal_slot = CAL_BASE + cal_pl * CAL_STRIDE;

  // The per-tap waveforms: this track's post probe, while asked for.
  tw_was = tw_on;
  tw_on = tap_run && cal_pl >= 0 && gmem[CTRL_TWTRK] == cal_pl + 1;
  // Columns only advance while the transport runs, so stopping leaves the
  // last pass on screen to look at rather than scrolling it into silence.
  tw_run = tw_on && (play_state & 1);
  tw_on ? (
    tw_slice = max(16, floor(srate * 0.004));
    !tw_was ? (
      tw_sacc = 0;
      t = 0; loop(TAP_MAX, TW_ACC[t * 4] = 1; TW_ACC[t * 4 + 1] = -1;
                           TW_ACC[t * 4 + 2] = 0; TW_ACC[t * 4 + 3] = 0; t += 1; );
    );
    gmem[TW_HDR + 1] = TW_COLS;
    gmem[TW_HDR + 2] = tw_slice;
    gmem[TW_HDR + 3] = srate;
    gmem[TW_HDR + 4] = cal_pl + 1;
    gmem[TW_HDR + 6] = tap_cfg;
    gmem[TW_HDR + 7] = TW_BASE2;
  );
  cal_play = (play_state & 1) == 1;

  // A new routing: tap N may be another plugin now, so no zero is kept.
  tap_gen != cal_gen_last ? (
    cal_gen_last = tap_gen;
    t = 0;
    loop(TAP_MAX,
      (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_HASCAL] = 0;
      (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_GATE] = 0;
      (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_STALE] = 0;
      t += 1;
    );
  );

  // THE PRE PROBE runs the clock and makes the noise.
  cal_pre = role == 0 && cal_arm >= 0.5 && cal_slot >= 0;
  cal_pre ? (
    cal_hb = (cal_hb + 1) % 1000000;
    gmem[cal_slot + CS_PREHB] = cal_hb;
    cp = gmem[cal_slot + CS_POSTHB];
    cp != cal_post_last ? ( cal_post_last = cp; cal_post_age = 0; ) : cal_post_age += samplesblock;
    // a post probe on this track, measuring taps, with a reader alive
    cal_ready = cal_post_age < srate * 0.25 && gmem[cal_slot + CS_CFG] > 0 && hb_age < srate * 3;
    // something learning a plugin: no run (gmem[78] moving)
    nz = gmem[CTRL_NOZERO];
    nz != nz_last ? ( nz_last = nz; nz_age = 0; ) : nz_age += samplesblock;
    cal_held = nz_age < srate;
    // what arrived in the block just gone, at either probe
    cal_loud = cal_inpk > CAL_QUIET_PRE || gmem[cal_slot + CS_ABORT] > 0;
    (cal_loud || gmem[cal_slot + CS_POSTPK] > CAL_QUIET_POST) ? cal_quiet = 0 : cal_quiet += samplesblock;
    cal_inpk = 0;
    cal_phase > 0 ? (
      (cal_play || !cal_ready || cal_loud || cal_held) ? (
        cal_phase = 0; cal_t = 0; cal_since = 0;    // the post throws the run away
      ) : (
        cal_t += samplesblock;
        cal_phase == 1 ? (
          cal_t >= CAL_LEN * srate ? ( cal_phase = 2; cal_t = 0; );
        ) : cal_phase == 2 ? (
          cal_t >= CAL_LEN * srate ? ( cal_phase = 3; cal_t = 0; );
        ) : (
          cal_t >= CAL_TAIL * srate ? ( cal_phase = 0; cal_t = 0; cal_since = 0; );
        );
      );
    ) : (
      cal_since += samplesblock;
      // while stopped, when the post asks (a tap with no zero, or touched
      // since), five seconds after the last try
      (!cal_play && cal_ready && !cal_held && cal_quiet >= CAL_WAIT * srate &&
       gmem[cal_slot + CS_REQ] > 0 && cal_since >= CAL_GAP * srate) ? (
        cal_phase = 1; cal_t = 0;
        kb0 = kb1 = kb2 = 0;
      );
    );
    gmem[cal_slot + CS_PHASE] = cal_phase;
  ) : (
    cal_phase = 0;
  );

  // THE POST PROBE follows it: silent while it runs, summing what the
  // taps see once each level has settled, and keeping the result if the
  // run got to the end.
  cal_post = tap_live && cal_slot >= 0;
  cal_post ? (
    cal_phb = (cal_phb + 1) % 1000000;
    gmem[cal_slot + CS_POSTHB] = cal_phb;
    // Only taps measuring gain reduction want a zero; levels-only taps don't.
    tap_ngr = 0; t = 0; loop(tap_cfg, tapIsGR(t) ? tap_ngr += 1; t += 1; );
    gmem[cal_slot + CS_CFG] = tap_ngr;
    gmem[cal_slot + CS_POSTPK] = cal_ppk;
    cp = gmem[cal_slot + CS_PREHB];
    cp != cal_pre_last ? ( cal_pre_last = cp; cal_pre_age = 0; ) : cal_pre_age += samplesblock;
    ph = (cal_pre_age < srate * 0.25 && !cal_play) ? gmem[cal_slot + CS_PHASE] : 0;
    // something real at the post probe mid-run (an instrument played while
    // stopped): stop, and let it be heard. Loud, and well over what the
    // first level's settled peak says the second should reach (10 dB up):
    // a chain with a lot of gain lifts the test noise itself past CAL_LOUD.
    (cal_ph == 1 && cal_pt >= CAL_SETTLE * srate) ? cal_p1 = max(cal_p1, cal_ppk);
    cal_lim = (cal_ph >= 2 && cal_p1 > 0) ? max(CAL_LOUD, cal_p1 * 3.1623 * 4) : CAL_LOUD;
    gmem[cal_slot + CS_ABORT] = (cal_ph > 0 && cal_ppk > cal_lim) ? 1 : 0;
    gmem[cal_slot + CS_ABORT] > 0 ? ph = 0;
    cal_ppk = 0;
    ph != cal_ph ? (
      (cal_ph == 2 && ph == 3) ? (
        cal_ok = 0;
        t = 0; loop(tap_cfg, tapIsGR(t) ? cal_ok += calCommit(t); t += 1; );
        tap_fine >= 1 ? (fineCalCommit());
        cal_ok > 0 ? (cal_fails = 0) : (cal_fails += 1);
      );
      // a run thrown away while stopped counts as a try too: after three
      // it waits for play
      ((cal_ph == 1 || cal_ph == 2) && ph == 0 && !cal_play) ? cal_fails += 1;
      ph == 1 ? ( calClear(); fineCalClear(); cal_p1 = 0; );
      cal_ph = ph; cal_pt = 0;
    ) : cal_pt += samplesblock;
    cal_mute = ph > 0;
    cal_acc = (ph == 1 || ph == 2) && cal_pt >= CAL_SETTLE * srate;
    cal_play ? cal_fails = 0;
    cal_req = 0;
    t = 0; loop(tap_cfg, (tapIsGR(t) && (calState(t) == 0 || calState(t) == 3)) ? cal_req = 1; t += 1; );
    gmem[cal_slot + CS_REQ] = (cal_req && cal_fails < 3) ? 1 : 0;
  ) : (
    cal_ph = 0; cal_mute = 0; cal_acc = 0;
  );

  // Where each tap's zero stands, for ChannelView and Track Analyser.
  (role >= 0.5 && role < 1.5) ? (
    t = 0; loop(TAP_MAX, TV_CAL[t] = tapIsGR(t) ? calState(t) : 0; t += 1; );
  );

  writeReadings();

@sample

  // The post probe, while the zero is measured: nothing out, and nothing
  // for its own analysis either -- but what came in is looked at first.
  cal_post ? (
    cal_ppk = max(cal_ppk, max(abs(spl0), abs(spl1)));
    cal_mute ? ( spl0 = 0; spl1 = 0; );
  );

  active ? (

    m = (spl0 + spl1) * 0.5;
    // COLLISIONS: each channel's level, for where the track sits
    cv_active ? ( col_l += spl0 * spl0; col_r += spl1 * spl1; col_n += 1; );

    //-- the alignment delay ------------------------------------------
    //   Pre probe only. Without it, column N of one probe and column N of
    //   the other hold audio taken at different moments, and on a transient
    //   the ratio between them is not a measurement of anything. At one
    //   whole column of skew a silent gap in one ring lines up with a hit
    //   in the other and the trace stops being wrong and starts being
    //   nonsense.
    lagn > 0 ? (
      BUF_DLY[dpos] = m;
      dpos += 1; dpos > lagn ? dpos = 0;
      m = BUF_DLY[dpos];
    );

    //-- scope column -------------------------------------------------
    m < smin ? smin = m;
    m > smax ? smax = m;
    ssq += m * m;
    sacc += 1;

    //-- the gain-reduction filterbank --------------------------------
    //   Off unless the panel is drawing the measured trace. It is the only
    //   per-sample work in here that costs anything worth naming, and a
    //   probe on a track nobody is looking at should not be paying it.
    grbon ? (
      grb = 0;
      loop(GRB_N,
        grc = BUF_GRC + grb * 4;
        grs = BUF_GRS + grb * 4;
        gy = grc[0] * m + grs[0];
        grs[0] = grs[1] - grc[1] * gy;
        grs[1] = -grc[0] * m - grc[2] * gy;
        gz = grc[0] * gy + grs[2];
        grs[2] = grs[3] - grc[1] * gz;
        grs[3] = -grc[0] * gy - grc[2] * gz;
        BUF_GRQ[grb] += gz * gz;
        grb += 1;
      );
    );

    sacc >= slice ? (
      gmem[base + OFF_SCOPE + cur * 3 + 0] = smin;
      gmem[base + OFF_SCOPE + cur * 3 + 1] = smax;
      gmem[base + OFF_SCOPE + cur * 3 + 2] = sqrt(ssq / slice);
      grb = 0;
      loop(GRB_N,
        gmem[base + OFF_GRB + cur * GRB_N + grb] =
          grbon ? sqrt(BUF_GRQ[grb] / slice) : 0;
        BUF_GRQ[grb] = 0;
        grb += 1;
      );
      // Each tap's latest column, on the panel's own clock, for its traces.
      (tap_run && role >= 0.5 && role < 1.5) ? (
        t = 0;
        loop(tap_cfg,
          gmem[(t < 4 ? TAPTR_BASE + t * SCOPE_COLS : TAPTR_BASE2 + (t - 4) * SCOPE_COLS) + cur] =
            (TAP_BASE + t * TAP_STRIDE + TAP_S)[TS_LAST];
          t += 1;
        );
      );
      cur += 1;
      cur >= SCOPE_COLS ? cur = 0;
      gmem[base + H_CUR] = cur;
      smin = 1; smax = -1; ssq = 0; sacc = 0;
    );

    //-- spectrum -----------------------------------------------------
    BUF_ACC[fill] = m;
    fill += 1;

    fill >= fftsz ? (
      i = 0;
      loop(fftsz,
        BUF_FFT[i * 2]     = BUF_ACC[i] * BUF_WIN[i];
        BUF_FFT[i * 2 + 1] = 0;
        i += 1;
      );
      fft(BUF_FFT, fftsz);
      fft_permute(BUF_FFT, fftsz);

      // A Hann window has a coherent gain of 0.5, and REAPER's fft is
      // unnormalised, so a sine of amplitude A lands at A*fftsz/4.
      sc = 4 / fftsz;

      i = 0;
      loop(nbins,
        re = BUF_FFT[i * 2];
        im = BUF_FFT[i * 2 + 1];
        pw = re * re + im * im;
        mag = sqrt(pw) * sc;
        d = mag > 0.000000001 ? 20 * log10(mag) : -180;
        d > BUF_MAG[i] ? BUF_MAG[i] = d
                       : BUF_MAG[i] = d + (BUF_MAG[i] - d) * rel;
        // Measurement average: linear in POWER, no ballistics. Both probes
        // hit this on the same block with the same frame alignment, so the
        // difference between the two averages is the magnitude response
        // and nothing else.
        meas ? (
          live ? BUF_AVG[i] += (pw - BUF_AVG[i]) * avg_k
               : BUF_AVG[i] += pw;
        );
        i += 1;
      );

      // COLLISIONS: this frame's power in each ERB band, and the left and
      // right levels since the last frame (Hann: 2 * sum |X|^2 / (0.375
      // n^2) is the mean square)
      (cv_active && col_n > 0) ? (
        cb = COL_BASE + (pl_tr + 1) * COL_STRIDE;
        cs = 2 / (0.375 * fftsz * fftsz);
        bi = 0;
        loop(col_nb,
          e0 = COL_E[bi]; e1 = COL_E[bi + 1];
          k0 = max(1, ceil(e0)); k1 = min(nbins - 1, ceil(e1) - 1);
          ps = 0;
          k1 >= k0 ? (
            kk = k0;
            loop(k1 - k0 + 1, ps += BUF_FFT[kk * 2] ^ 2 + BUF_FFT[kk * 2 + 1] ^ 2; kk += 1; );
            ps *= cs;
          ) : (
            kk = max(1, min(nbins - 1, floor((e0 + e1) * 0.5 + 0.5)));
            ps = (BUF_FFT[kk * 2] ^ 2 + BUF_FFT[kk * 2 + 1] ^ 2) * cs * (e1 - e0);
          );
          gmem[cb + COL_OFF + bi] = ps > 0.00000000000000000001 ? 10 * log10(ps) : -200;
          bi += 1;
        );
        gmem[cb + 1] = col_nb; gmem[cb + 2] = BAND_LO; gmem[cb + 3] = col_hi;
        gmem[cb + 4] = col_l > 0 ? 10 * log10(col_l / col_n) : -200;
        gmem[cb + 5] = col_r > 0 ? 10 * log10(col_r / col_n) : -200;
        gmem[cb + 6] = pl_tr + 2;
        col_seq += 1; gmem[cb] = col_seq;
        col_l = col_r = col_n = 0;
      );

      // The average itself stays in BUF_AVG, which the band summary reads
      // a few lines down. Only the count is published, so the panel can
      // tell a running average from a cold one.
      meas ? ( avgn += 1; gmem[base + H_AVGN] = avgn; );

      //-- log-spaced band summary ------------------------------------
      anorm = live ? 1 : (avgn > 0 ? 1 / avgn : 0);
      scdb  = 20 * log10(sc);
      bi = 0;
      loop(BANDS,
        b0 = BUF_BEDGE[bi]; b1 = BUF_BEDGE[bi + 1];
        k0 = ceil(b0); k1 = floor(b1);
        dmax = -180; psum = 0; pn = 0;
        (k1 >= k0 && k0 >= 1 && k1 <= nbins - 1) ? (
          kk = k0;
          loop(k1 - k0 + 1,
            BUF_MAG[kk] > dmax ? dmax = BUF_MAG[kk];
            psum += BUF_AVG[kk]; pn += 1;
            kk += 1;
          );
        ) : (
          // Narrower than a bin, which below about a kilohertz is every
          // band. Interpolate rather than leaving a hole.
          bc = (b0 + b1) * 0.5;
          kk = floor(bc); tt = bc - kk;

          // THE LEFT EDGE
          //   A band whose centre falls below bin 1 has no pair of bins to
          //   interpolate between, so without this it would keep its -180
          //   and the panel would draw a gap at the floor: 20 Hz to the
          //   first bin, about 23 Hz at 2048 points and 48 kHz.
          //
          //   Bin 1 is still the nearest thing that was actually measured,
          //   and the energy down there is real even though the transform
          //   cannot resolve where in the band it sits. So the value is
          //   HELD from bin 1 rather than dropped: the trace runs flat to
          //   the axis instead of falling into a hole. It is the same
          //   thing TS_Visualizer does by construction -- its axis starts
          //   at bin 1, so its leftmost pixel IS bin 1.
          //
          //   The TOP end is deliberately not treated this way. Above
          //   Nyquist there is no energy to represent, so a floor there is
          //   the truth and a held value would be an invention.
          kk < 1 ? ( kk = 1; tt = 0; );

          (kk >= 1 && kk <= nbins - 2) ? (
            dmax = BUF_MAG[kk] + (BUF_MAG[kk + 1] - BUF_MAG[kk]) * tt;
            psum = BUF_AVG[kk] + (BUF_AVG[kk + 1] - BUF_AVG[kk]) * tt;
            pn = 1;
          );
        );
        gmem[base + OFF_BAND + bi * 4] = dmax;
        // Mirrored into the Visualizer's slot, verbatim, same band index --
        // TS_Visualizer.lua's read_folder_overlay_bands() reads this slot
        // layout directly, so band bi means the same frequency range on
        // both sides of the bridge.
        vis_active ? gmem[vbase + VIS_OFF_BAND + bi] = dmax;
        cv_active ? gmem[cbase + CVS_OFF_BAND + bi] = dmax;
        // Whether this band has a value at all. With the left edge held
        // from bin 1 the only bands that fail this are the ones above
        // Nyquist, where a floor is the truth. A band with no value is
        // kept out of the response smoothing below, so two floors cannot
        // average a false zero into their neighbours (a little hook at
        // the bottom of a high-pass).
        BUF_BV[bi] = pn > 0 ? 1 : 0;
        pwb = pn > 0 ? psum / pn * anorm : 0;
        BUF_BA[bi] = pwb > 0.000000000000000001 ? 10 * log10(pwb) + scdb : -240;
        gmem[base + OFF_BAND + bi * 4 + 1] = BUF_BA[bi];
        bi += 1;
      );

      //-- the response, computed by the POST probe -------------------
      // Within a block REAPER runs the whole of the pre probe before the
      // whole of the post probe, and both FFTs fire on the same sample
      // index because they restart together on the epoch. So by the time
      // this runs the pre probe has already published this frame's bands.
      // ROLE 1 ONLY. The response is this track's post minus this
      // track's pre; a comparison probe lives on a different track, where
      // PRE_BASE holds somebody else's audio entirely, and subtracting
      // that would be meaningless rather than merely wrong.
      (role >= 0.5 && role < 1.5 && meas) ? (
        pmax = -400;
        bi = 0;
        loop(BANDS,
          pv = gmem[PRE_BASE + OFF_BAND + bi * 4 + 1];
          pv > pmax ? pmax = pv;
          bi += 1;
        );
        bi = 0;
        loop(BANDS,
          pv = gmem[PRE_BASE + OFF_BAND + bi * 4 + 1];
          BUF_BR[bi] = BUF_BA[bi] - pv;
          // How far below the loudest band this one's excitation sits. The
          // panel gates on that rather than on an absolute level, so the
          // curve does not vanish when the track is quiet.
          gmem[base + OFF_BAND + bi * 4 + 3] = pv - pmax;
          bi += 1;
        );
        // SMOOTHING ACROSS FREQUENCY, IN OCTAVES
        //
        // The grid is uniform in LOG frequency, which is what makes this
        // easy: a fixed number of points is a fixed fraction of an octave
        // everywhere. 256 points across three decades is 25.7 per octave,
        // so the window in points follows straight from the width asked
        // for, and one setting behaves the same at 40 Hz as at 10 kHz.
        //
        // Two box passes rather than one, which gives a triangular window
        // -- smooth, where a single box leaves corners. Bands with no data
        // are excluded rather than averaged in, so the empty region below
        // the first bin cannot pull its neighbours toward zero.
        hw = floor(smoo_oct * (BANDS / (log(BAND_HI / BAND_LO) / log(2))) * 0.5 + 0.5);
        hw = max(0, min(64, hw));
        hw > 0 ? (
          sp = 0;
          loop(2,
            bi = 0;
            loop(BANDS,
              ba = max(0, bi - hw); bb = min(BANDS - 1, bi + hw);
              acc = 0; cnt = 0;
              kk = ba;
              loop(bb - ba + 1,
                BUF_BV[kk] > 0.5 ? ( acc += BUF_BR[kk]; cnt += 1; );
                kk += 1;
              );
              BUF_BT[bi] = cnt > 0 ? acc / cnt : BUF_BR[bi];
              bi += 1;
            );
            bi = 0; loop(BANDS, BUF_BR[bi] = BUF_BT[bi]; bi += 1; );
            sp += 1;
          );
        );
        bi = 0;
        loop(BANDS,
          gmem[base + OFF_BAND + bi * 4 + 2] = BUF_BR[bi];
          bi += 1;
        );
      );

      // Published last, and only once everything above is in place: the
      // panel treats a change here as "a complete new frame is ready".
      seq += 1;
      gmem[base + H_SEQ] = seq;
      vis_active ? ( vis_seq += 1; gmem[vbase + VIS_H_SEQ] = vis_seq; );
      cv_active ? ( cvs_seq += 1; gmem[cbase] = cvs_seq; );

      memcpy(BUF_ACC, BUF_ACC + hop, hop);
      fill = hop;
    );
  );

  //-- the taps -----------------------------------------------------------
  tap_run ? (
    // Levels, every tap -- falling away while the zero is measured, so
    // the test noise never shows on a meter.
    cal_mute ? (
      t = 0; loop(tap_cfg, tapLevels(t, 0, 0, 0, 0); t += 1; );
    ) : (
      t = 0;
      loop(tap_cfg, tapLevels(t, spl(2 + t * 4), spl(3 + t * 4), spl(4 + t * 4), spl(5 + t * 4)); t += 1; );
      // the stereo tap's output: its sums, and its scope's ring
      (tap_st >= 1 && tap_st <= tap_cfg) ? (
        stv_l = spl(4 + (tap_st - 1) * 4); stv_r = spl(5 + (tap_st - 1) * 4);
        stc_ll += (stv_l * stv_l - stc_ll) * tap_lvrk;
        stc_rr += (stv_r * stv_r - stc_rr) * tap_lvrk;
        stc_lr += (stv_l * stv_r - stc_lr) * tap_lvrk;
        stv_m = (stv_l + stv_r) * 0.5; stv_s = (stv_l - stv_r) * 0.5;
        stc_mm += (stv_m * stv_m - stc_mm) * tap_lvrk;
        stc_ss += (stv_s * stv_s - stc_ss) * tap_lvrk;
        stc_skip += 1;
        stc_skip >= stc_dec ? (
          stc_skip = 0;
          STR_RING[stc_pos * 2] = stv_l; STR_RING[stc_pos * 2 + 1] = stv_r;
          stc_pos = (stc_pos + 1) % STP_N;
        );
      );
    );
    // Gain reduction, only for the taps measuring it.
    t = 0;
    loop(tap_cfg,
      tapIsGR(t) ? tapSample(t, (spl(2 + t * 4) + spl(3 + t * 4)) * 0.5, (spl(4 + t * 4) + spl(5 + t * 4)) * 0.5);
      t += 1;
    );
    tap_sacc += 1;
    tap_sacc >= tap_slice ? (
      tap_sacc = 0;
      tap_col += 1;
      t = 0; loop(tap_cfg, tapIsGR(t) ? tapColumn(t); t += 1; );
    );

    // Per-plugin waveforms (PER-PLUGIN WAVEFORMS). Tap t's before pair is
    // channels 2+4t/3+4t, its after pair 4+4t/5+4t, 0-based.
    tw_run ? (
      tw_t = 0;
      loop(tap_cfg,
        tw_a = TW_ACC + tw_t * 4;
        cal_mute ? ( tw_o = 0; tw_i = 0; ) : (
          tw_o = (spl(4 + tw_t * 4) + spl(5 + tw_t * 4)) * 0.5;
          tw_i = max(abs(spl(2 + tw_t * 4)), abs(spl(3 + tw_t * 4)));
        );
        tw_o < tw_a[0] ? tw_a[0] = tw_o;
        tw_o > tw_a[1] ? tw_a[1] = tw_o;
        tw_i > tw_a[2] ? tw_a[2] = tw_i;
        tapIsGR(tw_t) ? (
          tw_g = (TAP_BASE + tw_t * TAP_STRIDE + TAP_S)[TS_LAST];
          tw_g > tw_a[3] ? tw_a[3] = tw_g;
        );
        tw_t += 1;
      );
      tw_sacc += 1;
      tw_sacc >= tw_slice ? (
        tw_sacc = 0;
        tw_t = 0;
        loop(TAP_MAX,
          tw_a = TW_ACC + tw_t * 4;
          tw_b = twAt(tw_t, tw_cur);
          tw_t < tap_cfg ? (
            gmem[tw_b] = (tw_a[0] <= tw_a[1] ? tw_a[0] : 0);
            gmem[tw_b + 1] = (tw_a[0] <= tw_a[1] ? tw_a[1] : 0);
            gmem[tw_b + 2] = tw_a[2];
            gmem[tw_b + 3] = tw_a[3];
          ) : (
            gmem[tw_b] = 0; gmem[tw_b + 1] = 0; gmem[tw_b + 2] = 0; gmem[tw_b + 3] = 0;
          );
          tw_a[0] = 1; tw_a[1] = -1; tw_a[2] = 0; tw_a[3] = 0;
          tw_t += 1;
        );
        gmem[TW_HDR] = tw_cur;
        tw_cur += 1; tw_cur >= TW_COLS ? tw_cur = 0;
        tw_n += 1; gmem[TW_HDR + 5] = tw_n;
      );
    );
  );

  // Listening to a band: the output that alone, faded in and out (two
  // sections, transposed direct form II, each channel)
  (lsn_on || lsn_mix > 0) ? (
    lsn_mix = lsn_on ? min(1, lsn_mix + lsn_inc) : max(0, lsn_mix - lsn_inc);
    lsn_y = lsn_b0 * spl0 + lsn_l1; lsn_l1 = lsn_b1 * spl0 - lsn_a1 * lsn_y + lsn_l2; lsn_l2 = lsn_b2 * spl0 - lsn_a2 * lsn_y;
    lsn_z = lsn_b0 * lsn_y + lsn_l3; lsn_l3 = lsn_b1 * lsn_y - lsn_a1 * lsn_z + lsn_l4; lsn_l4 = lsn_b2 * lsn_y - lsn_a2 * lsn_z;
    spl0 += (lsn_z - spl0) * lsn_mix;
    lsn_y = lsn_b0 * spl1 + lsn_r1; lsn_r1 = lsn_b1 * spl1 - lsn_a1 * lsn_y + lsn_r2; lsn_r2 = lsn_b2 * spl1 - lsn_a2 * lsn_y;
    lsn_z = lsn_b0 * lsn_y + lsn_r3; lsn_r3 = lsn_b1 * lsn_y - lsn_a1 * lsn_z + lsn_r4; lsn_r4 = lsn_b2 * lsn_y - lsn_a2 * lsn_z;
    spl1 += (lsn_z - spl1) * lsn_mix;
    lsn_mix <= 0 ? ( lsn_l1 = lsn_l2 = lsn_l3 = lsn_l4 = lsn_r1 = lsn_r2 = lsn_r3 = lsn_r4 = 0; );
  );

  // The pre probe, while the zero is measured: the input is looked at
  // (it must stay silent), then the test noise goes in, after its own
  // analysis has seen the input as it was. Pink: Paul Kellet's economy
  // filter on white noise.
  cal_pre ? (
    cal_inpk = max(cal_inpk, max(abs(spl0), abs(spl1)));
    (cal_phase == 1 || cal_phase == 2) ? (
      cal_w = rand(2) - 1;
      kb0 = 0.99765 * kb0 + cal_w * 0.0990460;
      kb1 = 0.96300 * kb1 + cal_w * 0.2965164;
      kb2 = 0.57000 * kb2 + cal_w * 1.0526913;
      cal_w = (kb0 + kb1 + kb2 + cal_w * 0.1848) * (cal_phase == 1 ? CAL_GA : CAL_GB);
      spl0 += cal_w; spl1 += cal_w;
    );
  );

@gfx 340 112

  // Nothing to set: just what this probe is doing (see NO PARAMETERS).
  gfx_clear = 0x1d1f22;
  gfx_setfont(1, "Arial", 15);
  gfx_r = gfx_g = gfx_b = 0.9;
  gfx_x = 12; gfx_y = 10;
  gfx_drawstr("TS_TrackProbe 2.0");
  gfx_setfont(2, "Arial", 13);
  gfx_r = gfx_g = gfx_b = 0.62;
  gfx_x = 12; gfx_y += 22;
  role == 0 ? gfx_drawstr("Pre: before the plugins it measures")
  : role == 1 ? gfx_drawstr("Post: after the plugins it measures")
  : role == 2 ? gfx_drawstr("Comparison track (Track Analyser)")
  : gfx_drawstr("Idle: not in use by ChannelView or Track Analyser");
  gfx_x = 12; gfx_y += 18;
  pl_tr == -1 ? gfx_drawstr("Master track")
  : pl_tr >= 0 ? ( sprintf(#gfx_s, "Track %d", pl_tr + 1); gfx_drawstr(#gfx_s); );
  gfx_x = 12; gfx_y += 18;
  #gfx_s = "";
  active && publish >= 0.5 ? strcat(#gfx_s, "Publishing to Track Analyser   ");
  vis_active ? ( sprintf(#gfx_t, "Visualizer slot %d   ", vis_slot + 1); strcat(#gfx_s, #gfx_t); );
  tap_run ? ( sprintf(#gfx_t, "Measuring %d plugin%s", tap_cfg, tap_cfg == 1 ? "" : "s"); strcat(#gfx_s, #gfx_t); )
  : tap_live ? ( sprintf(#gfx_t, "%d plugin%s, measured while shown", tap_cfg, tap_cfg == 1 ? "" : "s"); strcat(#gfx_s, #gfx_t); );
  cal_pre && cal_phase > 0 ? strcat(#gfx_s, "Measuring the zero");
  gfx_r = 0.36; gfx_g = 0.64; gfx_b = 0.88;
  gfx_drawstr(#gfx_s);
